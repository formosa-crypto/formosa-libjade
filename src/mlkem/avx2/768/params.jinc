param int MLKEM_K = 3;
param int MLKEM_DU = 10;
param int MLKEM_DV = 4;
param int MLKEM_ETA1 = 2;

require "../common/params.jinc"

/* the (i, j) byte pairs of the matrix entries sampled four at a time,
   then of the transposed matrix */
u8[32] gen_matrix_indexes =
{
  0x00, 0x00, 0x01, 0x00, 0x02, 0x00, 0x00, 0x01, // (0,0) (0,1) (0,2) (1,0)
  0x01, 0x01, 0x02, 0x01, 0x00, 0x02, 0x01, 0x02, // (1,1) (1,2) (2,0) (2,1)

  0x00, 0x00, 0x00, 0x01, 0x00, 0x02, 0x01, 0x00, // (0,0) (0,1) (0,2) (1,0)
  0x01, 0x01, 0x01, 0x02, 0x02, 0x00, 0x02, 0x01  // (1,1) (1,2) (2,0) (2,1)
};
