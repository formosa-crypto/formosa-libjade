require "indcpa.jinc"
require "verify.jinc"
require "mlkem_keccak_sized.jinc"

#[safety =
   { requires = is_arr_init(randomnessp,0,MLKEM_SYMBYTES*2)
   , ensures = is_arr_init(pk,0,MLKEM_PUBLICKEYBYTES) && is_arr_init(sk,0,MLKEM_SECRETKEYBYTES)
   }
 ]
inline
fn __crypto_kem_keypair_jazz
( reg ptr u8[MLKEM_PUBLICKEYBYTES] pk
, reg ptr u8[MLKEM_SECRETKEYBYTES] sk
, reg ptr u8[MLKEM_SYMBYTES*2] randomnessp
) -> reg ptr u8[MLKEM_PUBLICKEYBYTES]
   , reg ptr u8[MLKEM_SECRETKEYBYTES]
{
  stack ptr u8[MLKEM_SYMBYTES*2] s_randomnessp;
  reg ptr u8[MLKEM_SYMBYTES] randomnessp1;
  reg ptr u8[32] hpk;
  reg u64 t64;
  inline int i;
  reg ptr u8[MLKEM_POLYVECBYTES] skcpa;
  stack ptr u8[MLKEM_SECRETKEYBYTES]sk_s;
  #[msf] reg u64 ms;

  s_randomnessp = randomnessp;

  randomnessp1 = randomnessp[0:MLKEM_SYMBYTES];
  skcpa = sk[0:MLKEM_POLYVECBYTES]; sk_s = sk;
  pk, skcpa = __indcpa_keypair(pk, skcpa, randomnessp1);
  sk = sk_s;
  ms = #init_msf();
  sk[0:MLKEM_POLYVECBYTES] = skcpa;

  for i = 0 to MLKEM_INDCPA_PUBLICKEYBYTES/8
  {
    t64 = pk[#unaligned:u64 i];
    sk.[:u64 (MLKEM_POLYVECBYTES/8 + i)*8] = t64;
  }

  #spill(sk);
  hpk = sk[MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES:32];
  hpk = _sha3_256A_APK(hpk, pk);
  #unspill(sk);
  randomnessp = s_randomnessp;
  ms = #init_msf();
  sk[MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES:32] = hpk;

  for i = 0 to MLKEM_SYMBYTES/8
  {
    t64 = randomnessp[#unaligned:u64 MLKEM_SYMBYTES/8 + i];
    sk.[:u64 ((MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES + MLKEM_SYMBYTES)/8 + i)*8] = t64;
  }

  return pk, sk;
}

#[safety =
   { requires = is_arr_init(randomnessp,0,MLKEM_SYMBYTES) && is_arr_init(pk,0,MLKEM_PUBLICKEYBYTES)
   , ensures = is_arr_init(ct,0,MLKEM_CIPHERTEXTBYTES) && is_arr_init(shk,0,MLKEM_SYMBYTES)
   }
 ]
inline
fn __crypto_kem_enc_jazz(
  reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct,
  reg ptr u8[MLKEM_SYMBYTES] shk,
  reg ptr u8[MLKEM_PUBLICKEYBYTES] pk,
  reg ptr u8[MLKEM_SYMBYTES] randomnessp)
  -> reg ptr u8[MLKEM_CIPHERTEXTBYTES], reg ptr u8[MLKEM_SYMBYTES]
{
  stack u8[MLKEM_SYMBYTES * 2] buf kr;
  #[msf] reg u64 ms;

  () = #spill(ct, pk, shk);

  reg u256 b = randomnessp[#unaligned:u256 0];
  buf[:u256 0] = b;

  buf[MLKEM_SYMBYTES:MLKEM_SYMBYTES] = _sha3_256A_APK(buf[MLKEM_SYMBYTES:MLKEM_SYMBYTES], pk);

  kr = _sha3_512A_A64(kr, buf);

  () = #unspill(ct, pk);
  ms = #init_msf();

  ct = __indcpa_enc(ct, buf[0:MLKEM_INDCPA_MSGBYTES], pk, kr[MLKEM_SYMBYTES:MLKEM_SYMBYTES]);

  () = #unspill(shk);
  ms = #init_msf();

  reg u256 k = kr[:u256 0];
  shk[#unaligned:u256 0] = k;

  return ct, shk;
}

#[safety =
   { requires = is_arr_init(ct,0,MLKEM_CIPHERTEXTBYTES) && is_arr_init(sk,0,MLKEM_SECRETKEYBYTES)
   , ensures = is_arr_init(shk,0,MLKEM_SYMBYTES)
   }
 ]
inline
fn __crypto_kem_dec_jazz(
  reg ptr u8[MLKEM_SYMBYTES] shk,
  reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct,
  reg ptr u8[MLKEM_SECRETKEYBYTES] sk)
  -> reg ptr u8[MLKEM_SYMBYTES]
{
  stack u8[MLKEM_INDCPA_CIPHERTEXTBYTES] ctc;
  stack u8[2*MLKEM_SYMBYTES] kr buf;
  stack u8[MLKEM_SYMBYTES + MLKEM_CIPHERTEXTBYTES] zp_ct; // used instead of reg u64 zp
  reg ptr u8[MLKEM_POLYVECBYTES] skp;
  reg u64 cnd;
  #[msf] reg u64 ms;

  () = #spill(shk, ct, sk);
  reg u256 z = sk.[:u256 MLKEM_SECRETKEYBYTES - MLKEM_SYMBYTES];
  zp_ct[:u256 0] = z;

  skp = sk[0:MLKEM_POLYVECBYTES];
  buf[0:MLKEM_INDCPA_MSGBYTES] = __indcpa_dec(buf[0:MLKEM_INDCPA_MSGBYTES], ct, skp);

  // we do not need to do pointer arithmetic here

  reg u256 k = sk.[:u256 MLKEM_INDCPA_SECRETKEYBYTES + MLKEM_INDCPA_PUBLICKEYBYTES];
  buf[:u256 1] = k;

  kr = _sha3_512A_A64(kr, buf);

  // No need for pointer arithmetic

  #unspill(sk);
  ms = #init_msf();
  ctc = __indcpa_enc(ctc, buf[0:MLKEM_SYMBYTES], sk[MLKEM_POLYVECBYTES:MLKEM_PUBLICKEYBYTES], kr[MLKEM_SYMBYTES:MLKEM_SYMBYTES]);

  () = #unspill(ct, shk);
  ms = #init_msf();

  cnd = __verify(ct, ctc);
  #spill(cnd);

  // No need for pointer arithmetic, but we will need to do some copying then as reg ptr = reg ptr is a noop
  // And concating both zp and ctp to make the SHAKE function easier to implement, read and understand
  inline int j;
  for j = 0 to MLKEM_CIPHERTEXTBYTES / 32 {
    reg u256 c = ct[#unaligned:u256 j];
    zp_ct[:u256 (MLKEM_SYMBYTES / 32) + j] = c;
  }

  /* fixme: should this be done in memory? */
  shk = _shake256_A32__AZCT(shk, zp_ct);

  #unspill(cnd);
  shk = __cmov(shk, kr[0:MLKEM_SYMBYTES], cnd);
  return shk;
}

/*
__crypto_kem_check_pk_jazz: modulus check (FIPS-203 7.2)

ensures:
  - res = if ByteEncode12(ByteDecode12(pk[0:MLKEM_POLYVECBYTES])) = pk[0:MLKEM_POLYVECBYTES] then 0 else -1
*/

#[safety =
   { requires = is_arr_init(pk,0,MLKEM_PUBLICKEYBYTES)
   }
 ]
inline
fn __crypto_kem_check_pk_jazz(reg ptr u8[MLKEM_PUBLICKEYBYTES] pk) -> reg u64
{
  stack u16[MLKEM_VECN] pkpv;
  stack u8[MLKEM_POLYVECBYTES] pkb;
  reg u256 f g h;
  reg u64 r t64;
  reg bool zf;
  inline int i;
  #[msf] reg u64 ms;

  () = #spill(pk);
  pkpv = __i_polyvec_frombytes(pk[0:MLKEM_POLYVECBYTES]);
  pkb = __i_polyvec_tobytes(pkb, pkpv);
  () = #unspill(pk);
  ms = #init_msf();

  h = #set0_256();
  for i = 0 to MLKEM_POLYVECBYTES/32
  {
    f = pkb.[:u256 32*i];
    g = pk.[:u256 32*i];
    f = #VPXOR_256(f, g);
    h = #VPOR_256(h, f);
  }

  _, _, _, _, zf = #VPTEST_256(h, h);

  r = 0;
  t64 = -1;
  r = t64 if !zf;
  // the outcome of a check on the public key
  () = #declassify(r);
  ms = #init_msf();
  return r;
}

/*
__crypto_kem_check_sk_jazz: hash check (FIPS-203 7.3)

ensures:
  - res = if H(sk[384k:768k+32]) = sk[768k+32:768k+64] then 0 else -1
*/

#[safety =
   { requires = is_arr_init(sk,0,MLKEM_SECRETKEYBYTES)
   }
 ]
inline
fn __crypto_kem_check_sk_jazz(reg ptr u8[MLKEM_SECRETKEYBYTES] sk) -> reg u64
{
  stack u8[32] hpk;
  reg u256 f g;
  reg u64 r t64;
  reg bool zf;
  #[msf] reg u64 ms;

  () = #spill(sk);
  hpk = _sha3_256A_APK(hpk, sk[MLKEM_POLYVECBYTES:MLKEM_PUBLICKEYBYTES]);
  () = #unspill(sk);
  ms = #init_msf();

  f = hpk[:u256 0];
  g = sk.[:u256 MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES];
  f = #VPXOR_256(f, g);
  _, _, _, _, zf = #VPTEST_256(f, f);

  r = 0;
  t64 = -1;
  r = t64 if !zf;
  // the hashed bytes and the stored hash are the public key and its hash
  () = #declassify(r);
  ms = #init_msf();
  return r;
}

#[safety =
   { requires = is_arr_init(randomnessp,0,MLKEM_SYMBYTES) && is_arr_init(pk,0,MLKEM_PUBLICKEYBYTES)
   , ensures = is_arr_init(ct,0,MLKEM_CIPHERTEXTBYTES) && is_arr_init(shk,0,MLKEM_SYMBYTES)
   }
 ]
inline
fn __crypto_kem_encaps_derand_jazz(
  reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct,
  reg ptr u8[MLKEM_SYMBYTES] shk,
  reg ptr u8[MLKEM_PUBLICKEYBYTES] pk,
  reg ptr u8[MLKEM_SYMBYTES] randomnessp)
  -> reg ptr u8[MLKEM_CIPHERTEXTBYTES], reg ptr u8[MLKEM_SYMBYTES], reg u64
{
  reg u256 z;
  reg u64 r;
  inline int i;
  #[msf] reg u64 ms;

  () = #spill(ct, shk, pk, randomnessp);
  r = __crypto_kem_check_pk_jazz(pk);
  () = #unspill(ct, shk, pk, randomnessp);
  ms = #init_msf();

  #spill(r);
  if (r == 0) {
    ct, shk = __crypto_kem_enc_jazz(ct, shk, pk, randomnessp);
  } else {
    z = #set0_256();
    for i = 0 to MLKEM_CIPHERTEXTBYTES/32
    {
      ct[#unaligned:u256 i] = z;
    }
    shk[#unaligned:u256 0] = z;
  }
  #unspill(r);
  ms = #init_msf();
  return ct, shk, r;
}

#[safety =
   { requires = is_arr_init(ct,0,MLKEM_CIPHERTEXTBYTES) && is_arr_init(sk,0,MLKEM_SECRETKEYBYTES)
   , ensures = is_arr_init(shk,0,MLKEM_SYMBYTES)
   }
 ]
inline
fn __crypto_kem_decaps_jazz(
  reg ptr u8[MLKEM_SYMBYTES] shk,
  reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct,
  reg ptr u8[MLKEM_SECRETKEYBYTES] sk)
  -> reg ptr u8[MLKEM_SYMBYTES], reg u64
{
  reg u256 z;
  reg u64 r;
  #[msf] reg u64 ms;

  () = #spill(shk, ct, sk);
  r = __crypto_kem_check_sk_jazz(sk);
  () = #unspill(shk, ct, sk);
  ms = #init_msf();

  #spill(r);
  if (r == 0) {
    shk = __crypto_kem_dec_jazz(shk, ct, sk);
  } else {
    z = #set0_256();
    shk[#unaligned:u256 0] = z;
  }
  #unspill(r);
  ms = #init_msf();
  return shk, r;
}
