// Refactored signing implementation following the mldsa-native call tree structure.
//
// Function hierarchy (mirrors mldsa-native):
//   __sign_internal                      ← outer rejection-sampling loop
//     derive_seed_for_mask               ← H(K || rnd || μ)
//     __compute_z_and_check_norm         ← mld_compute_pack_z: z = y + c*s1, norm check
//     __apply_cs2_and_check_norm         ← w0_minus_cs2[i] = w0[i] - c*s2[i], norm check
//     __apply_ct0_and_check_norm         ← w0_minus_cs2_plus_ct0[i] = w0_minus_cs2[i] + c*t0[i], norm check
//     __make_hint_vector                 ← make_hint for all rows, check total hint count
//
// Leakage discipline (the security proof, MLDSATarget in proofs/mldsa/security,
// models exactly what the signing loop declassifies):
//   - t0 (the low bits of t, part of the signing key) is declassified once,
//     when the signing key is unpacked; the challenge c is declassified once
//     per iteration. Everything computed from (c, t0) alone is then public,
//     in particular the norm test on c*t0.
//   - the rejection tests are evaluated in the order z, w0 - c*s2, c*t0, hint
//     (b1, b2, b3, b4 of FIPS 204), each as a short-circuit cascade over the
//     polynomials: the only declassified value of a test is the boolean
//     "the polynomial violates the bound", so the leakage of a test is the
//     index of its first failing polynomial. The tests on w0 - c*s2 and on
//     the hint are only run once the test on z passed; the hint test is run
//     whether or not the (public) test on c*t0 passed. The test on c*t0
//     declassifies nothing: it is a function of c and t0 only. It is not
//     even compiled when it cannot fail (ML-DSA-65 and ML-DSA-87, see
//     CT0_NORM_BOUND).
//   - on an exhausted budget the exiting (rejected) iteration is not encoded:
//     the signature buffer is set to the fixed value 0^* and the failure
//     code is returned (the model returns None).

#[safety =
   { requires = is_arr_init(k,0,32)
             && is_arr_init(randomness,0,32)
             && is_arr_init(message_representative,0,MESSAGE_REPRESENTATIVE_SIZE)
   , ensures = is_arr_init(seed_for_mask,0,64)
   }
 ]
fn derive_seed_for_mask(
    reg ptr u8[32] k,
    reg ptr u8[32] randomness,
    reg ptr u8[MESSAGE_REPRESENTATIVE_SIZE] message_representative,
    #[spill_to_mmx] reg ptr u8[64] seed_for_mask
) -> reg ptr u8[64] {
    stack u8[128] block;

    reg u256 copied_32_bytes;

    copied_32_bytes = k.[:u256 0];
    block.[:u256 0] = copied_32_bytes;

    copied_32_bytes = randomness.[:u256 0];
    block.[:u256 32] = copied_32_bytes;

    // MESSAGE_REPRESENTATIVE_SIZE is always 64.
    copied_32_bytes = message_representative.[:u256 0];
    block.[:u256 64] = copied_32_bytes;

    copied_32_bytes = message_representative.[:u256 32];
    block.[:u256 96] = copied_32_bytes;

    seed_for_mask = _shake256_A64__A128(seed_for_mask, block);

    return seed_for_mask;
}

#[safety =
   { requires = is_arr_init(s1_element,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
             && is_arr_init(verifier_challenge,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
             && is_arr_init(mask_element,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
   , ensures = is_arr_init(signer_response_element,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
   }
 ]
inline fn __compute_signer_response_element(
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] s1_element,
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] verifier_challenge,
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] mask_element,
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] signer_response_element
) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL], reg u64
{
    stack u32[COEFFICIENTS_IN_POLYNOMIAL] cs1;
    reg u64 infinity_norm_check_result;

    cs1 = polynomial::pointwise_montgomery_multiply_and_reduce(cs1, s1_element, verifier_challenge);
    cs1 = polynomial::invert_ntt_montgomery(cs1);

    // z = reduce32(mask + c*s1) and its norm test, in one pass
    signer_response_element, infinity_norm_check_result =
        polynomial::__add_reduce32_check_infinity_norm(
            signer_response_element, cs1, mask_element, (GAMMA1 - BETA));

    return signer_response_element, infinity_norm_check_result;
}

// Compute z = mask + c*s1 for each column element, check infinity norm.
// Mirrors mld_compute_pack_z from mldsa-native.
// Returns updated signer_response and norm check result (0 = pass, non-zero = fail).
#[safety =
   { args = { s1, verifier_challenge, mask, signer_response, norm_check_result_in }
   , requires = is_arr_init(s1,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
             && is_arr_init(verifier_challenge,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
             && is_arr_init(mask,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
   , ensures = (infinity_norm_check_result != 0 || is_arr_init(signer_response,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
            && (norm_check_result_in == 0 || infinity_norm_check_result != 0)
   }
 ]
inline fn __compute_z_and_check_norm(
    reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] s1,
    #[spill_to_mmx] reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] verifier_challenge,
    reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] mask,
    reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] signer_response,
    reg u64 infinity_norm_check_result
) -> reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], reg u64 {
    reg ui64 base;

    base = 0;
    while {
        () = #declassify(infinity_norm_check_result);
        _ = #init_msf();
        if (infinity_norm_check_result != 0) {
            base = COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL;
        }
    } (base < COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) {
        signer_response[base : COEFFICIENTS_IN_POLYNOMIAL], infinity_norm_check_result =
            __compute_signer_response_element(
                s1[base : COEFFICIENTS_IN_POLYNOMIAL],
                verifier_challenge,
                mask[base : COEFFICIENTS_IN_POLYNOMIAL],
                signer_response[base : COEFFICIENTS_IN_POLYNOMIAL]
            );
        base = base + COEFFICIENTS_IN_POLYNOMIAL;
    }
    return signer_response, infinity_norm_check_result;
}

// For each row i: compute cs2_i = c * s2_i, write w0_minus_cs2[i] = w0[i] - cs2_i,
// check infinity norm. Output and input are separate buffers (disjoint reg ptr args).
// Passes through any prior norm failure unchanged.
#[safety =
   { args = { w0_minus_cs2, w0, s2, verifier_challenge, norm_check_result_in }
   , requires = is_arr_init(w0,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
             && is_arr_init(s2,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
             && is_arr_init(verifier_challenge,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
   , ensures = (infinity_norm_check_result != 0 || is_arr_init(w0_minus_cs2,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
            && (norm_check_result_in == 0 || infinity_norm_check_result != 0)
   }
 ]
inline fn __apply_cs2_and_check_norm(
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] s2,
    #[spill_to_mmx] reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] verifier_challenge,
    reg u64 infinity_norm_check_result
) -> reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], reg u64 {
    stack u32[COEFFICIENTS_IN_POLYNOMIAL] cs2;
    reg ui64 base;

    base = 0;
    while {
        () = #declassify(infinity_norm_check_result);
        _ = #init_msf();
        if (infinity_norm_check_result != 0) {
            base = ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL;
        }
    } (base < ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) {
        cs2 = polynomial::pointwise_montgomery_multiply_and_reduce(
                    cs2,
                    s2[base : COEFFICIENTS_IN_POLYNOMIAL],
                    verifier_challenge);
        cs2 = polynomial::invert_ntt_montgomery(cs2);
        // w0 - c*s2 = reduce32(w0 - cs2) and its norm test, in one pass
        w0_minus_cs2[base : COEFFICIENTS_IN_POLYNOMIAL], infinity_norm_check_result =
            polynomial::__subtract_reduce32_check_infinity_norm(
                w0_minus_cs2[base : COEFFICIENTS_IN_POLYNOMIAL],
                w0[base : COEFFICIENTS_IN_POLYNOMIAL],
                cs2,
                (GAMMA2 - BETA));
        base = base + COEFFICIENTS_IN_POLYNOMIAL;
    }
    return w0_minus_cs2, infinity_norm_check_result;
}

// A coefficient of t0 lies in (-2^(d-1), 2^(d-1)] and a coefficient of c*t0 is
// a signed sum of TAU coefficients of t0, hence ||c*t0||_inf <= TAU * 2^(d-1).
// The test ||c*t0||_inf >= GAMMA2 of FIPS 204 can only fail when this bound
// reaches GAMMA2: ML-DSA-44 (39 * 4096 = 159744 >= 95232). For ML-DSA-65
// (49 * 4096 = 200704) and ML-DSA-87 (60 * 4096 = 245760) it is below
// GAMMA2 = 261888 and the test is not compiled.
param int CT0_NORM_BOUND =
    ONES_IN_VERIFIER_CHALLENGE * (1 << (BITS_IN_LOWER_PART_OF_T - 1));

// For each row i: compute ct0_i = c * t0_i, check infinity norm (when the test
// can fail, see CT0_NORM_BOUND), and write
// w0_minus_cs2_plus_ct0[i] = w0_minus_cs2[i] + ct0_i (whether or not the norm
// test passes: the hint is computed from it in every case, as in the model).
// Output and input are separate buffers (disjoint reg ptr args).
// Skipped entirely after a prior norm failure; the returned flag is the result
// of the c*t0 test alone (0 when the function is skipped or not compiled).
// c and t0 are public (declassified by __sign_internal), so this function
// computes on public data only and declassifies nothing.
#[safety =
   { requires = is_arr_init(t0,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
             && is_arr_init(verifier_challenge,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
             && (infinity_norm_check_result != 0 || is_arr_init(w0_minus_cs2,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
   , ensures = (infinity_norm_check_result != 0 || is_arr_init(w0_minus_cs2_plus_ct0,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
   }
 ]
inline fn __apply_ct0_and_check_norm(
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2_plus_ct0,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] t0,
    #[spill_to_mmx] reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] verifier_challenge,
    reg u64 infinity_norm_check_result
) -> reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], reg u64 {
    stack u32[COEFFICIENTS_IN_POLYNOMIAL] ct0;
    // The flag lives on the stack: a register here is one too many.
    stack u64 ct0_norm_check_result;
    reg u64 ct0_norm_check_result_row;
    reg ui64 base;

    ct0_norm_check_result = 0;
    // The scratch buffer only ever holds c*t0, a function of public data.
    // Without this (no code is generated for it) the checker would type the
    // uninitialised buffer, and everything derived from it, as secret.
    ArrayInit(ct0);
    base = 0;
    if (infinity_norm_check_result != 0) {
        base = ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL;
    }
    while (base < ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) {
        ct0 = polynomial::pointwise_montgomery_multiply_and_reduce(
                    ct0,
                    t0[base : COEFFICIENTS_IN_POLYNOMIAL],
                    verifier_challenge);
        ct0 = polynomial::invert_ntt_montgomery(ct0);
        // w0_minus_cs2_plus_ct0[i] = w0_minus_cs2[i] + reduce32(ct0), with the
        // norm test of reduce32(ct0) compiled only when CT0_NORM_BOUND >= GAMMA2,
        // in one pass. The inverse NTT returns a representative in (-q, q);
        // reduce32 centres it, which __make_hint relies on even when the test
        // is not compiled.
        w0_minus_cs2_plus_ct0[base : COEFFICIENTS_IN_POLYNOMIAL], ct0_norm_check_result_row =
            polynomial::__add_reduce32_check_infinity_norm_rhs(
                w0_minus_cs2_plus_ct0[base : COEFFICIENTS_IN_POLYNOMIAL],
                w0_minus_cs2[base : COEFFICIENTS_IN_POLYNOMIAL],
                ct0, GAMMA2, CT0_NORM_BOUND);
        if (CT0_NORM_BOUND >= GAMMA2) {
            ct0_norm_check_result |= ct0_norm_check_result_row;
        }
        base = base + COEFFICIENTS_IN_POLYNOMIAL;
    }
    ct0_norm_check_result_row = ct0_norm_check_result;
    return w0_minus_cs2_plus_ct0, ct0_norm_check_result_row;
}

// Compute make_hint for each row using w0_minus_cs2_plus_ct0 and w1,
// accumulate total hint bits, and check the total against MAX_ONES_IN_HINT.
// If the total exceeds MAX_ONES_IN_HINT, sets norm check result to failure.
// Passes through any prior norm failure unchanged.
#[safety =
   { args = { w0_minus_cs2_plus_ct0, w1, hint, norm_check_result_in }
   , requires = is_arr_init(w1,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
             && (norm_check_result_in != 0 || is_arr_init(w0_minus_cs2_plus_ct0,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
   , ensures = (infinity_norm_check_result != 0 || is_arr_init(hint,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL)))
            && (norm_check_result_in == 0 || infinity_norm_check_result != 0)
   }
 ]
inline fn __make_hint_vector(
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2_plus_ct0,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w1,
    reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hint,
    reg u64 infinity_norm_check_result
) -> reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], reg u64 {
    reg ui64 total_ones_in_hint ones_in_hint;
    reg u64 hint_count_fail_64;
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] hint_element;
    reg bool hint_count_exceeded;
    reg u8 hint_count_fail;
    reg ui64 base;

    total_ones_in_hint = 0;
    base = 0;
    while {
        () = #declassify(infinity_norm_check_result);
        _ = #init_msf();
        if (infinity_norm_check_result != 0) {
            base = ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL;
        }
    } (base < ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) {
        hint_element = hint[base : COEFFICIENTS_IN_POLYNOMIAL];
        hint_element, ones_in_hint = polynomial::__make_hint(
            hint_element,
            w0_minus_cs2_plus_ct0[base : COEFFICIENTS_IN_POLYNOMIAL],
            w1[base : COEFFICIENTS_IN_POLYNOMIAL]);
        hint[base : COEFFICIENTS_IN_POLYNOMIAL] = hint_element;
        total_ones_in_hint += ones_in_hint;
        base = base + COEFFICIENTS_IN_POLYNOMIAL;
        hint_count_exceeded = total_ones_in_hint > MAX_ONES_IN_HINT;
        hint_count_fail = #SETcc(hint_count_exceeded);
        hint_count_fail_64 = (64u)(8u) hint_count_fail;
        infinity_norm_check_result |= hint_count_fail_64;
    }
    return hint, infinity_norm_check_result;
}

// Maximum value of domain_separator_for_mask before a __mask call.
// Mirrors mldsa-native's MLD_NONCE_UB * L: all L nonces consumed per attempt
// stay within u16.  FIPS 204 bounds the loop to 814 iterations; this cap is a
// much looser overflow-safety measure.
param int MASK_DOMAIN_SEPARATOR_UB =
    (65535 - COLUMNS_IN_MATRIX_A) / COLUMNS_IN_MATRIX_A * COLUMNS_IN_MATRIX_A;

#[safety =
   { requires = is_arr_init(signing_key,0,SIGNING_KEY_SIZE) && is_arr_init(randomness,0,32)
   , ensures = is_arr_init(signature,0,SIGNATURE_SIZE)
   }
 ]
#[sct="{ptr: public, val: transient} *
       {ptr: public, val: secret} *
       public * public * public * public *
       {ptr: public, val: secret} ->
       {ptr: public, val: transient} * public"]
fn __sign_internal(
    reg ptr u8[SIGNATURE_SIZE] signature,
    reg ptr u8[SIGNING_KEY_SIZE] signing_key,
    reg ui64 context_pointer,
    reg ui64 context_size,
    reg ui64 message_pointer,
    reg ui64 message_size,
    reg ptr u8[32] randomness
) -> reg ptr u8[SIGNATURE_SIZE], reg u64
{
    #[msf] reg u64 ms;

    // parts of signing_key
    reg ptr u8[SEED_FOR_MATRIX_A_SIZE] seed_for_matrix_A;

    stack u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] s1;
    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] s2;
    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] t0;

    stack u32[ROWS_IN_MATRIX_A * COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] matrix_A;
    stack u8[MESSAGE_REPRESENTATIVE_SIZE] message_representative;

    reg u16 domain_separator_for_mask;
    stack u8[64] seed_for_mask;

    stack u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] signer_response;

    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hint;

    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0 w1;
    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2;
    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w0_minus_cs2_plus_ct0;
    stack u8[ENCODED_COMMITMENT_SIZE] commitment_encoded;

    stack u8[COMMITMENT_HASH_SIZE] commitment_hash;

    stack u32[COEFFICIENTS_IN_POLYNOMIAL] verifier_challenge;

    stack u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] mask;
    stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] w;
    stack u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] mask_as_ntt;

    #[public] reg u64 exit_rejection_sampling_loop;
    reg u64 kappa_exceeded;

    reg u64 infinity_norm_check_result ct0_norm_check_result result;
    stack u64 last_norm_check_result;
    reg u32 kappa_diff;
    reg bool kappa_zf;
    reg u8 kappa_bit;
    reg u64 kappa_bit_64;

    reg u256 copied_32_bytes;

    reg ui64 j;

    () = #spill(signature, randomness, signing_key, context_pointer, context_size, message_pointer, message_size);
    seed_for_matrix_A = signing_key[0:32];
    () = #declassify(seed_for_matrix_A);
    matrix_A = sample::__matrix_A(seed_for_matrix_A);

    () = #unspill(signing_key, context_pointer, context_size, message_pointer, message_size);
    ms = #init_msf();
    signing_key = #protect_ptr(signing_key, ms);
    () = #spill(signing_key);
    message_representative = __derive_message_representative(
        message_representative,
        signing_key[64:VERIFICATION_KEY_HASH_SIZE],
        context_pointer,
        context_size,
        message_pointer,
        message_size);

    () = #unspill(randomness);
    () = #unspill(signing_key);
    ms = #init_msf();
    randomness = #protect_ptr(randomness, ms);
    signing_key = #protect_ptr(signing_key, ms);
    () = #spill(signing_key);
    seed_for_mask = derive_seed_for_mask(signing_key[32:32], randomness, message_representative, seed_for_mask);

    () = #unspill(signing_key);
    ms = #init_msf();
    signing_key = #protect_ptr(signing_key, ms);
    s1 = s1::__decode(s1, signing_key[START_OF_S1_IN_ENCODED_SIGNING_KEY: S1_ENCODED_SIZE]);
    s2 = s2::__decode(s2, signing_key[START_OF_S2_IN_ENCODED_SIGNING_KEY: S2_ENCODED_SIZE]);
    t0 = t0::decode(t0, signing_key[START_OF_T0_IN_ENCODED_SIGNING_KEY: T0_ENCODED_SIZE]);
    // The leakage model treats t0 as public: it is declassified once here.
    () = #declassify(t0);

    s1 = row_vector::ntt(s1);
    s2 = column_vector::ntt(s2);
    t0 = column_vector::ntt(t0);

    domain_separator_for_mask = 0;

    exit_rejection_sampling_loop = 0;
    kappa_exceeded = 0;
    last_norm_check_result = 1;

    // The |#declassify|s in this loop body are the leakage of the model of
    // the security proof (MLDSATarget.sign): the challenge c, then the
    // outcome of each rejection test, polynomial by polynomial, in the order
    // z, w0 - c*s2, hint (the test on c*t0 is a public computation and
    // declassifies nothing). The
    // constant-time checker validates that nothing else is leaked; that this
    // leakage is harmless is established by the EasyCrypt security proof.
    while (exit_rejection_sampling_loop == 0) {
        () = #spill(kappa_exceeded);
        mask, domain_separator_for_mask = sample::__mask(seed_for_mask, domain_separator_for_mask);

        // Deep copy mask into mask_as_ntt using AVX2.
        j = 0;
        while (j < COLUMNS_IN_MATRIX_A * BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            copied_32_bytes = mask.[:u256 j];
            mask_as_ntt.[:u256 j] = copied_32_bytes;
            j += 32;
        }

        mask_as_ntt = row_vector::ntt(mask_as_ntt);
        w = row_vector::__multiply_with_matrix_A(matrix_A, mask_as_ntt);
        w = column_vector::reduce32(w);
        w = column_vector::invert_ntt_montgomery(w);

        // decompose brings the (-q, q) representative to [0, q) itself
        w0, w1 = column_vector::__decompose(w);

        commitment_encoded = commitment::__encode(w1);

        () = #spill(domain_separator_for_mask);
        commitment_hash = __derive_commitment_hash(commitment_hash, message_representative, commitment_encoded);

        verifier_challenge = sample::__challenge(verifier_challenge, commitment_hash);
        () = #unspill(domain_separator_for_mask);
        // The leakage model leaks the challenge c of every iteration.
        () = #declassify(verifier_challenge);

        verifier_challenge = polynomial::ntt(verifier_challenge);

        infinity_norm_check_result = 0;

        // b1: compute z = mask + c*s1, reject if z reveals the secret (mirrors mld_compute_pack_z).
        signer_response, infinity_norm_check_result =
            __compute_z_and_check_norm(s1, verifier_challenge, mask, signer_response, infinity_norm_check_result);

        // b2: compute w0_minus_cs2[i] = w0[i] - c*s2[i] for each row, check norm
        // (only once z passed).
        w0_minus_cs2, infinity_norm_check_result =
            __apply_cs2_and_check_norm(w0_minus_cs2, w0, s2, verifier_challenge, infinity_norm_check_result);

        // b3: compute w0_minus_cs2_plus_ct0[i] = w0_minus_cs2[i] + c*t0[i] for each row,
        // check norm (ML-DSA-44 only, see CT0_NORM_BOUND). A public
        // computation: c and t0 are declassified.
        w0_minus_cs2_plus_ct0, ct0_norm_check_result =
            __apply_ct0_and_check_norm(w0_minus_cs2_plus_ct0, w0_minus_cs2, t0, verifier_challenge, infinity_norm_check_result);
        // (The spill is unconditional: the spill lowering does not look
        // through the compile-time condition.)
        () = #spill(ct0_norm_check_result);

        // b4: compute hints using w0_minus_cs2_plus_ct0 and w1, check that the total
        // number of hint bits does not exceed MAX_ONES_IN_HINT (only once w0 - c*s2
        // passed; run whether or not the test on c*t0 passed, as in the model).
        w0_minus_cs2_plus_ct0 = w0_minus_cs2_plus_ct0;
        hint, infinity_norm_check_result =
            __make_hint_vector(w0_minus_cs2_plus_ct0, w1, hint, infinity_norm_check_result);

        // Branchless loop-exit flag: pass (0) → exit (1), fail (1) → continue (0).
        // infinity_norm_check_result is always 0 or 1 (SETcc values ORed together).
        () = #declassify(infinity_norm_check_result);
        () = #unspill(ct0_norm_check_result);
        if (CT0_NORM_BOUND >= GAMMA2) {
            infinity_norm_check_result |= ct0_norm_check_result;
        }
        () = #unspill(kappa_exceeded);
        _ = #init_msf();
        last_norm_check_result = infinity_norm_check_result;
        exit_rejection_sampling_loop = infinity_norm_check_result;
        exit_rejection_sampling_loop ^= 1;

        // Branchless kappa bound check (mirrors mldsa-native MLD_NONCE_UB).
        // domain_separator_for_mask has just been incremented by L inside __mask.
        // XOR with the bound gives 0 iff we have reached it; TEST sets ZF accordingly.
        kappa_diff = (32u) domain_separator_for_mask;
        kappa_diff ^= MASK_DOMAIN_SEPARATOR_UB;
        _, _, _, _, kappa_zf = #TEST_32(kappa_diff, kappa_diff);
        kappa_bit = #SETcc(kappa_zf);
        kappa_bit_64 = (64u) kappa_bit;
        kappa_exceeded |= kappa_bit_64;
        exit_rejection_sampling_loop |= kappa_exceeded;
    }

    () = #unspill(signature);
    ms = #init_msf();
    signature = #protect_ptr(signature, ms);
    // last_norm_check_result is 0 iff the exiting iteration produced a valid
    // signature (reset to 0 each iteration); it is 1 only when the iteration
    // budget is exhausted. It is public (the outcome of every test is leaked).
    // The exiting iteration is encoded only when it passed the tests; on an
    // exhausted budget the signature buffer is set to the fixed value 0^*
    // (the model returns None: the rejected iteration must not be output).
    if (last_norm_check_result == 0) {
        () = #declassify(hint);
        () = #declassify(commitment_hash);
        () = #declassify(signer_response);
        signature = signature::__encode(signature, commitment_hash, signer_response, hint);
    } else {
        signature = signature::__zero(signature);
    }

    _ = #init_msf();
    result = last_norm_check_result;

    // result = 0 on success, -1 on failure. Broadcast bit 0 to all 64 bits.
    result <<= 63;
    result >>s= 63;
    return signature, result;
}
