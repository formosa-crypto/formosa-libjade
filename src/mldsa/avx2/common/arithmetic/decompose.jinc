namespace polynomial {
    // 2 * gamma2 for each variant: a table is only used by the variant it
    // belongs to, whatever the parameter set
    param int ALPHA_GAMMA2_32 = 2 * ((MODULUS - 1) / 32);
    param int ALPHA_GAMMA2_88 = 2 * ((MODULUS - 1) / 88);

    u256[5] CONSTANTS_TABLE_gamma2_32 = {
        (8u32)[15, 15, 15, 15, 15, 15, 15, 15],
        (8u32)[1025, 1025, 1025, 1025, 1025, 1025, 1025, 1025],
        (8u32)[ALPHA_GAMMA2_32, ALPHA_GAMMA2_32, ALPHA_GAMMA2_32, ALPHA_GAMMA2_32,
               ALPHA_GAMMA2_32, ALPHA_GAMMA2_32, ALPHA_GAMMA2_32, ALPHA_GAMMA2_32],
        (8u32)[127, 127, 127, 127, 127, 127, 127, 127],
        (8u32)[512, 512, 512, 512, 512, 512, 512, 512]
    };
    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(lows,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
                && is_arr_init(highs,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    fn decompose_gamma2_32 (
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] lows,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] highs,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL],
         reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        // We approximate 1 / 4092 as:
        // ⌊2²² / 4092⌋ / 2²² = 1025 / 2²²
        reg u256 modulus modulus_halved;
        reg u256 v alpha;
        reg u256 offs shift mask;
        reg u256 coefficients comparisons;

        reg u256 lower, upper, zeros;

        reg ui64 offset;

        modulus = MODULUS_VECTOR;
        modulus_halved = #VPSRL_8u32(modulus, 1);
        zeros = #set0_256();

        mask = CONSTANTS_TABLE_gamma2_32[0]; // 15
        v = CONSTANTS_TABLE_gamma2_32[1]; // 1025
        alpha = CONSTANTS_TABLE_gamma2_32[2]; // ALPHA
        offs = CONSTANTS_TABLE_gamma2_32[3]; // 127
        shift = CONSTANTS_TABLE_gamma2_32[4]; // 512

        offset = 0;
        while (offset < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            coefficients = polynomial.[:u256 offset];

            // Bring the coefficients, representatives in (-q, q), to [0, q).
            comparisons = #VPCMPGT_8u32(zeros, coefficients);
            comparisons = #VPAND_256(comparisons, modulus);
            coefficients = #VPADD_8u32(coefficients, comparisons);

            // Compute the upper bits fist

            // For each coefficient |r|, first compute
            // ceil(r / 128)
            upper = #VPADD_8u32(coefficients, offs);
            upper = #VPSRL_8u32(upper, 7);

            upper = #VPMULHU_16u16(upper, v);
            upper = #VPMULHRS_16u16(upper, shift);
            upper = #VPAND_256(upper, mask);

            // Then compute the lower bits
            lower = #VPMULL_8u32(upper, alpha);
            lower = #VPSUB_8u32(coefficients, lower);
            comparisons = #VPCMPGT_8u32(lower, modulus_halved);

            comparisons = #VPAND_256(comparisons, modulus);
            lower = #VPSUB_8u32(lower, comparisons);

            lows.[:u256 offset] = lower;
            highs.[:u256 offset] = upper;

            offset += 32;
        }

        return lows, highs;
    }

    fn use_hints_gamma2_32(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] commitment hint_polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 hints;
        reg u256 coefficients;
        reg u256 high low low_lanes_which_are_zero;
        reg u256 mask;

        stack u32[COEFFICIENTS_IN_POLYNOMIAL] highs lows;

        reg ui64 offset;

        reg u256 zeros = #set0_256();

        mask = CONSTANTS_TABLE_gamma2_32[0]; // 15

        lows, highs = decompose_gamma2_32(lows, highs, commitment);

        offset = 0;
        while (offset < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            low = lows.[:u256 offset];
            hints = hint_polynomial.[:u256 offset];

            low_lanes_which_are_zero = #VPCMPEQ_8u32(low, zeros);
            low = #VPOR_256(low, low_lanes_which_are_zero);

            hints = #VPSIGN_8s32(hints, low);

            high = highs.[:u256 offset];
            coefficients = #VPADD_8u32(high, hints);
            coefficients = #VPAND_256(coefficients, mask);

            commitment.[:u256 offset] = coefficients;

            offset += 32;
        }

        return commitment;
    }

    u256[5] CONSTANTS_TABLE_gamma2_88 = {
        (8u32)[11_275, 11_275, 11_275, 11_275, 11_275, 11_275, 11_275, 11_275],
        (8u32)[ALPHA_GAMMA2_88, ALPHA_GAMMA2_88, ALPHA_GAMMA2_88, ALPHA_GAMMA2_88,
               ALPHA_GAMMA2_88, ALPHA_GAMMA2_88, ALPHA_GAMMA2_88, ALPHA_GAMMA2_88],
        (8u32)[127, 127, 127, 127, 127, 127, 127, 127],
        (8u32)[128, 128, 128, 128, 128, 128, 128, 128],
        (8u32)[43, 43, 43, 43, 43, 43, 43, 43]
    };
    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(lows,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
                && is_arr_init(highs,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    fn decompose_gamma2_88 (
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] lows,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] highs,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL],
         reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 modulus modulus_halved;
        reg u256 v alpha;
        reg u256 offs shift max;
        reg u256 coefficients;

        reg u256 lower upper mask zeros;

        reg ui64 offset;

        modulus = MODULUS_VECTOR;
        modulus_halved = #VPSRL_8u32(modulus, 1);

        v = CONSTANTS_TABLE_gamma2_88[0]; // 11_275
        alpha = CONSTANTS_TABLE_gamma2_88[1]; // ALPHA
        offs = CONSTANTS_TABLE_gamma2_88[2]; // 127
        shift = CONSTANTS_TABLE_gamma2_88[3]; // 128
        max = CONSTANTS_TABLE_gamma2_88[4]; // 43

        zeros = #set0_256();

        offset = 0;
        while (offset < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            coefficients = polynomial.[:u256 offset];

            // Bring the coefficients, representatives in (-q, q), to [0, q).
            mask = #VPCMPGT_8u32(zeros, coefficients);
            mask = #VPAND_256(mask, modulus);
            coefficients = #VPADD_8u32(coefficients, mask);

            // Compute the upper bits fist

            // Compute ceil((r + 127) >> 7);
            upper = #VPADD_8u32(coefficients, offs);
            upper = #VPSRL_8u32(upper, 7);

            // Compute ((upper * 11_275) + (1 << 23)) >> 24;
            upper = #VPMULHU_16u16(upper, v);
            upper = #VPMULHRS_16u16(upper, shift);

            // Compute high_bits ^= ((43 - high_bits) >> 31) & high_bits;
            // to handle the corner case.
            mask = #VPSUB_8u32(max, upper);
            mask = #VPCMPGT_8u32(zeros, mask);
            upper = #VPANDN_256(mask, upper);

            lower = #VPMULL_8u32(upper, alpha);
            lower = #VPSUB_8u32(coefficients, lower);

            coefficients = #VPCMPGT_8u32(lower, modulus_halved);
            coefficients = #VPAND_256(coefficients, modulus);
            lower = #VPSUB_8u32(lower, coefficients);

            lows.[:u256 offset] = lower;
            highs.[:u256 offset] = upper;

            offset += 32;
        }

        return lows, highs;
    }

    fn use_hints_gamma2_88(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] commitment hint_polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 zeros;
        reg u256 hints;
        reg u256 high low t;
        reg u256 max;

        stack u32[COEFFICIENTS_IN_POLYNOMIAL] highs lows;

        reg ui64 offset;

        max = CONSTANTS_TABLE_gamma2_88[4]; // 43

        zeros = #set0_256();

        lows, highs = decompose_gamma2_88(lows, highs, commitment);

        offset = 0;
        while (offset < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            low = lows.[:u256 offset];
            high = highs.[:u256 offset];
            hints = hint_polynomial.[:u256 offset];

            low = #VPCMPGT_8u32(low, zeros);

            t = #BLENDV_8u32(hints, zeros, low);
            t = #VPSLL_8u32(t, 1);
            hints = #VPSUB_8u32(hints, t);

            high = #VPADD_8u32(high, hints);

            high = #BLENDV_8u32(high, max, high);
            low = #VPCMPGT_8u32(high, max);

            high = #BLENDV_8u32(high, zeros, low);

            commitment.[:u256 offset] = high;

            offset += 32;
        }

        return commitment;
    }


    // Decompose and UseHint, for gamma2 = (q - 1) / 32 (ML-DSA-65, ML-DSA-87)
    // or gamma2 = (q - 1) / 88 (ML-DSA-44)

    // Decompose a polynomial whose coefficients are representatives in
    // (-q, q): the pass first adds the modulus to the negative ones.
    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(lows,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
                && is_arr_init(highs,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn decompose(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] lows,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] highs,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL],
         reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        if (GAMMA2 == (MODULUS - 1) / 88) {
            lows, highs = decompose_gamma2_88(lows, highs, polynomial);
        } else {
            lows, highs = decompose_gamma2_32(lows, highs, polynomial);
        }
        return lows, highs;
    }

    inline
    fn use_hints(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] commitment hint_polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        if (GAMMA2 == (MODULUS - 1) / 88) {
            commitment = use_hints_gamma2_88(commitment, hint_polynomial);
        } else {
            commitment = use_hints_gamma2_32(commitment, hint_polynomial);
        }
        return commitment;
    }
}
