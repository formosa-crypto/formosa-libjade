namespace polynomial {
    // The forward NTT in two passes over the polynomial, the coefficients
    // staying in eight ymm registers through several layers.
    //
    // A ymm register holds 8 coefficients; the polynomial is 32 of them,
    // numbered v = 0..31. Layer k (stride 2^k coefficients) pairs registers
    // v and v + 2^k / 8 for k >= 3, and pairs lanes inside a register pair
    // for k <= 2.
    //   - pass A, layers 7, 6, 5: the registers {j, j+4, ..., j+28} of a
    //     column j = 0..3 form a complete three-layer network;
    //   - pass B, layers 4, 3, 2, 1, 0: the registers 8g..8g+7 of a block
    //     g = 0..3 (64 consecutive coefficients) form a complete network.
    // The butterflies themselves are those of the layer-by-layer version;
    // only their order and the residency of the data change.

    // Cooley-Tukey butterfly on two registers: (a, b) -> (a + z b, a - z b)
    inline
    fn __ct_butterfly(reg u256 a b zetas) -> reg u256, reg u256
    {
        reg u256 t;

        t = montgomery_multiply_and_reduce(b, zetas);
        b = #VPSUB_8u32(a, t);
        a = #VPADD_8u32(a, t);

        return a, b;
    }

    // Layer 2: the butterflies pair the 128-bit halves of two registers.
    inline
    fn __ct_butterfly_8(reg u256 lhs rhs zetas) -> reg u256, reg u256
    {
        reg u256 summands zeta_products;
        reg u256 add_terms sub_terms;

        summands = #VPERM2I128(lhs, rhs, 0x20);
        zeta_products = #VPERM2I128(lhs, rhs, 0x31);
        zeta_products = montgomery_multiply_and_reduce(zeta_products, zetas);

        add_terms = #VPADD_8u32(summands, zeta_products);
        sub_terms = #VPSUB_8u32(summands, zeta_products);

        lhs = #VPERM2I128(add_terms, sub_terms, 0x20);
        rhs = #VPERM2I128(add_terms, sub_terms, 0x31);

        return lhs, rhs;
    }

    // Layer 1: the butterflies pair the 64-bit quarters of two registers.
    inline
    fn __ct_butterfly_4(reg u256 lhs rhs zetas) -> reg u256, reg u256
    {
        reg u256 summands zeta_products;
        reg u256 add_terms sub_terms;

        summands = #VPUNPCKL_4u64(lhs, rhs);
        zeta_products = #VPUNPCKH_4u64(lhs, rhs);
        zeta_products = montgomery_multiply_and_reduce(zeta_products, zetas);

        add_terms = #VPADD_8u32(summands, zeta_products);
        sub_terms = #VPSUB_8u32(summands, zeta_products);

        lhs = #VPUNPCKL_4u64(add_terms, sub_terms);
        rhs = #VPUNPCKH_4u64(add_terms, sub_terms);

        return lhs, rhs;
    }

    // Layer 0: the butterflies pair adjacent coefficients; a shuffle brings
    // them into the layout of layer 1 and back.
    inline
    fn __ct_butterfly_2(reg u256 lhs rhs zetas) -> reg u256, reg u256
    {
        lhs = #VPSHUFD_256(lhs, 0b11_01_10_00);
        rhs = #VPSHUFD_256(rhs, 0b11_01_10_00);

        lhs, rhs = __ct_butterfly_4(lhs, rhs, zetas);

        lhs = #VPSHUFD_256(lhs, 0b11_01_10_00);
        rhs = #VPSHUFD_256(rhs, 0b11_01_10_00);

        return lhs, rhs;
    }

    // Pass A: layers 7, 6, 5 on the column j (registers j, j+4, ..., j+28).
    #[safety =
       { requires = 0 <= j && j <= 3 && is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __ntt_layers_7_6_5(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        inline int j
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 r0 r1 r2 r3 r4 r5 r6 r7;
        reg u256 zetas;
        reg u64 zeta;

        r0 = polynomial.[:u256 32 * (j +  0)];
        r1 = polynomial.[:u256 32 * (j +  4)];
        r2 = polynomial.[:u256 32 * (j +  8)];
        r3 = polynomial.[:u256 32 * (j + 12)];
        r4 = polynomial.[:u256 32 * (j + 16)];
        r5 = polynomial.[:u256 32 * (j + 20)];
        r6 = polynomial.[:u256 32 * (j + 24)];
        r7 = polynomial.[:u256 32 * (j + 28)];

        // layer 7: pairs (v, v + 16), one root
        zeta = 25_847;
        zetas = (256u)#VMOV(zeta);
        zetas = #VPBROADCAST_8u32(zetas);
        r0, r4 = __ct_butterfly(r0, r4, zetas);
        r1, r5 = __ct_butterfly(r1, r5, zetas);
        r2, r6 = __ct_butterfly(r2, r6, zetas);
        r3, r7 = __ct_butterfly(r3, r7, zetas);

        // layer 6: pairs (v, v + 8), one root per half
        zeta = -2_608_894;
        zetas = (256u)#VMOV(zeta);
        zetas = #VPBROADCAST_8u32(zetas);
        r0, r2 = __ct_butterfly(r0, r2, zetas);
        r1, r3 = __ct_butterfly(r1, r3, zetas);
        zeta = -518_909;
        zetas = (256u)#VMOV(zeta);
        zetas = #VPBROADCAST_8u32(zetas);
        r4, r6 = __ct_butterfly(r4, r6, zetas);
        r5, r7 = __ct_butterfly(r5, r7, zetas);

        // layer 5: pairs (v, v + 4), one root per quarter
        zetas = LAYER_5_ZETAS[0];
        r0, r1 = __ct_butterfly(r0, r1, zetas);
        zetas = LAYER_5_ZETAS[1];
        r2, r3 = __ct_butterfly(r2, r3, zetas);
        zetas = LAYER_5_ZETAS[2];
        r4, r5 = __ct_butterfly(r4, r5, zetas);
        zetas = LAYER_5_ZETAS[3];
        r6, r7 = __ct_butterfly(r6, r7, zetas);

        polynomial.[:u256 32 * (j +  0)] = r0;
        polynomial.[:u256 32 * (j +  4)] = r1;
        polynomial.[:u256 32 * (j +  8)] = r2;
        polynomial.[:u256 32 * (j + 12)] = r3;
        polynomial.[:u256 32 * (j + 16)] = r4;
        polynomial.[:u256 32 * (j + 20)] = r5;
        polynomial.[:u256 32 * (j + 24)] = r6;
        polynomial.[:u256 32 * (j + 28)] = r7;

        return polynomial;
    }

    // Pass B: layers 4, 3, 2, 1, 0 on the block g (registers 8g .. 8g+7).
    #[safety =
       { requires = 0 <= g && g <= 3 && is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __ntt_layers_4_to_0(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        inline int g
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 r0 r1 r2 r3 r4 r5 r6 r7;
        reg u256 zetas;

        r0 = polynomial.[:u256 32 * (8 * g + 0)];
        r1 = polynomial.[:u256 32 * (8 * g + 1)];
        r2 = polynomial.[:u256 32 * (8 * g + 2)];
        r3 = polynomial.[:u256 32 * (8 * g + 3)];
        r4 = polynomial.[:u256 32 * (8 * g + 4)];
        r5 = polynomial.[:u256 32 * (8 * g + 5)];
        r6 = polynomial.[:u256 32 * (8 * g + 6)];
        r7 = polynomial.[:u256 32 * (8 * g + 7)];

        // layer 4: pairs (v, v + 2)
        zetas = LAYER_4_ZETAS[2 * g];
        r0, r2 = __ct_butterfly(r0, r2, zetas);
        r1, r3 = __ct_butterfly(r1, r3, zetas);
        zetas = LAYER_4_ZETAS[2 * g + 1];
        r4, r6 = __ct_butterfly(r4, r6, zetas);
        r5, r7 = __ct_butterfly(r5, r7, zetas);

        // layer 3: pairs (v, v + 1)
        zetas = LAYER_3_ZETAS[4 * g + 0];
        r0, r1 = __ct_butterfly(r0, r1, zetas);
        zetas = LAYER_3_ZETAS[4 * g + 1];
        r2, r3 = __ct_butterfly(r2, r3, zetas);
        zetas = LAYER_3_ZETAS[4 * g + 2];
        r4, r5 = __ct_butterfly(r4, r5, zetas);
        zetas = LAYER_3_ZETAS[4 * g + 3];
        r6, r7 = __ct_butterfly(r6, r7, zetas);

        // layers 2, 1, 0: inside the register pairs (v, v + 1)
        zetas = LAYER_2_ZETAS[4 * g + 0];
        r0, r1 = __ct_butterfly_8(r0, r1, zetas);
        zetas = LAYER_2_ZETAS[4 * g + 1];
        r2, r3 = __ct_butterfly_8(r2, r3, zetas);
        zetas = LAYER_2_ZETAS[4 * g + 2];
        r4, r5 = __ct_butterfly_8(r4, r5, zetas);
        zetas = LAYER_2_ZETAS[4 * g + 3];
        r6, r7 = __ct_butterfly_8(r6, r7, zetas);

        zetas = LAYER_1_ZETAS[4 * g + 0];
        r0, r1 = __ct_butterfly_4(r0, r1, zetas);
        zetas = LAYER_1_ZETAS[4 * g + 1];
        r2, r3 = __ct_butterfly_4(r2, r3, zetas);
        zetas = LAYER_1_ZETAS[4 * g + 2];
        r4, r5 = __ct_butterfly_4(r4, r5, zetas);
        zetas = LAYER_1_ZETAS[4 * g + 3];
        r6, r7 = __ct_butterfly_4(r6, r7, zetas);

        zetas = LAYER_0_ZETAS[4 * g + 0];
        r0, r1 = __ct_butterfly_2(r0, r1, zetas);
        zetas = LAYER_0_ZETAS[4 * g + 1];
        r2, r3 = __ct_butterfly_2(r2, r3, zetas);
        zetas = LAYER_0_ZETAS[4 * g + 2];
        r4, r5 = __ct_butterfly_2(r4, r5, zetas);
        zetas = LAYER_0_ZETAS[4 * g + 3];
        r6, r7 = __ct_butterfly_2(r6, r7, zetas);

        polynomial.[:u256 32 * (8 * g + 0)] = r0;
        polynomial.[:u256 32 * (8 * g + 1)] = r1;
        polynomial.[:u256 32 * (8 * g + 2)] = r2;
        polynomial.[:u256 32 * (8 * g + 3)] = r3;
        polynomial.[:u256 32 * (8 * g + 4)] = r4;
        polynomial.[:u256 32 * (8 * g + 5)] = r5;
        polynomial.[:u256 32 * (8 * g + 6)] = r6;
        polynomial.[:u256 32 * (8 * g + 7)] = r7;

        return polynomial;
    }

    fn ntt(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        inline int i;

        for i = 0 to 4 {
            polynomial = __ntt_layers_7_6_5(polynomial, i);
        }
        for i = 0 to 4 {
            polynomial = __ntt_layers_4_to_0(polynomial, i);
        }

        return polynomial;
    }
}
