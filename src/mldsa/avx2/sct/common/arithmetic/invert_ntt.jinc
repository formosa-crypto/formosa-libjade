// The root of the last inverse layer times f = 41978, the Montgomery form of
// 1/256, reduced once more by Montgomery: 25847 * 41978 * 2^-32 mod q, as a
// centred representative.
param int INVERSE_NTT_LAYER_7_ZETA_TIMES_F = -3_975_713;

// The constants of the last layer: zeta f, f and their twisted forms.
u32[4] INVERSE_NTT_LAYER_7_CONSTANTS = {
    INVERSE_NTT_LAYER_7_ZETA_TIMES_F, -151_046_689, 41_978, -8_395_782
};

namespace polynomial {
    // The inverse NTT in two passes over the polynomial, the coefficients
    // staying in eight ymm registers through several layers (see ntt.jinc
    // for the register numbering):
    //   - pass A, layers 0, 1, 2, 3, 4: the registers 8g..8g+7 of a block
    //     g = 0..3 (64 consecutive coefficients) form a complete network;
    //   - pass B, layers 5, 6, 7: the registers {j, j+4, ..., j+28} of a
    //     column j = 0..3 form a complete network, and the final scaling by
    //     the Montgomery form of 1/256 is applied before the store.
    // The butterflies themselves are those of the layer-by-layer version;
    // only their order and the residency of the data change.

    // Gentleman-Sande butterfly on two registers: (a, b) -> (a + b, z (b - a))
    inline
    fn __gs_butterfly(reg u256 a b zetas zetas_qinv) -> reg u256, reg u256
    {
        reg u256 b_minus_a;

        b_minus_a = #VPSUB_8u32(b, a);
        a = #VPADD_8u32(a, b);
        b = montgomery_multiply_by_zeta(b_minus_a, zetas, zetas_qinv);

        return a, b;
    }

    // Layer 1: the butterflies pair the 64-bit quarters of two registers; the
    // *_high arguments hold the odd lanes of the zetas in the even ones.
    inline
    fn __gs_butterfly_4_lanes(
        reg u256 lhs rhs zetas zetas_high zetas_qinv zetas_qinv_high
    ) -> reg u256, reg u256
    {
        reg u256 low_values high_values;
        reg u256 sums differences;

        low_values = #VPUNPCKL_4u64(lhs, rhs);
        high_values = #VPUNPCKH_4u64(lhs, rhs);

        differences = #VPSUB_8u32(high_values, low_values);
        sums = #VPADD_8u32(high_values, low_values);
        differences = montgomery_multiply_by_zeta_lanes(
            differences, zetas, zetas_high, zetas_qinv, zetas_qinv_high);

        lhs = #VPUNPCKL_4u64(sums, differences);
        rhs = #VPUNPCKH_4u64(sums, differences);

        return lhs, rhs;
    }

    inline
    fn __gs_butterfly_4(reg u256 lhs rhs zetas zetas_qinv) -> reg u256, reg u256
    {
        lhs, rhs = __gs_butterfly_4_lanes(lhs, rhs, zetas, zetas, zetas_qinv, zetas_qinv);
        return lhs, rhs;
    }

    // Layer 0: the butterflies pair adjacent coefficients; a shuffle brings
    // them into the layout of layer 1 and back.
    inline
    fn __gs_butterfly_2(reg u256 lhs rhs zetas zetas_qinv) -> reg u256, reg u256
    {
        reg u256 zetas_high zetas_qinv_high;

        lhs = #VPSHUFD_256(lhs, 0b11_01_10_00);
        rhs = #VPSHUFD_256(rhs, 0b11_01_10_00);

        zetas_high = #VMOVSHDUP_256(zetas);
        zetas_qinv_high = #VMOVSHDUP_256(zetas_qinv);
        lhs, rhs = __gs_butterfly_4_lanes(
            lhs, rhs, zetas, zetas_high, zetas_qinv, zetas_qinv_high);

        lhs = #VPSHUFD_256(lhs, 0b11_01_10_00);
        rhs = #VPSHUFD_256(rhs, 0b11_01_10_00);

        return lhs, rhs;
    }

    // Layer 2: the butterflies pair the 128-bit halves of two registers.
    inline
    fn __gs_butterfly_8(reg u256 lhs rhs zetas zetas_qinv) -> reg u256, reg u256
    {
        reg u256 low_values high_values;
        reg u256 sums differences;

        low_values = #VPERM2I128(lhs, rhs, 0x20);
        high_values = #VPERM2I128(lhs, rhs, 0x31);

        differences = #VPSUB_8u32(high_values, low_values);
        sums = #VPADD_8u32(high_values, low_values);
        differences = montgomery_multiply_by_zeta(differences, zetas, zetas_qinv);

        lhs = #VPERM2I128(sums, differences, 0x20);
        rhs = #VPERM2I128(sums, differences, 0x31);

        return lhs, rhs;
    }

    // The last butterfly with the scaling folded in:
    // (a, b) -> (f (a + b), (zeta f) (b - a)), zeta f given in Montgomery form.
    inline
    fn __gs_butterfly_scaled(reg u256 a b zetas_f zetas_f_qinv f f_qinv)
        -> reg u256, reg u256
    {
        reg u256 b_minus_a;

        b_minus_a = #VPSUB_8u32(b, a);
        a = #VPADD_8u32(a, b);
        b = montgomery_multiply_by_zeta(b_minus_a, zetas_f, zetas_f_qinv);
        a = montgomery_multiply_by_zeta(a, f, f_qinv);

        return a, b;
    }


    // Pass A: layers 0 to 4 on the block g (registers 8g .. 8g+7).
    #[safety =
       { requires = 0 <= g && g <= 3 && is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __invert_ntt_layers_0_to_4(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        inline int g
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 r0 r1 r2 r3 r4 r5 r6 r7;
        reg u256 zetas zetas_qinv;

        r0 = polynomial.[:u256 32 * (8 * g + 0)];
        r1 = polynomial.[:u256 32 * (8 * g + 1)];
        r2 = polynomial.[:u256 32 * (8 * g + 2)];
        r3 = polynomial.[:u256 32 * (8 * g + 3)];
        r4 = polynomial.[:u256 32 * (8 * g + 4)];
        r5 = polynomial.[:u256 32 * (8 * g + 5)];
        r6 = polynomial.[:u256 32 * (8 * g + 6)];
        r7 = polynomial.[:u256 32 * (8 * g + 7)];

        // layers 0, 1, 2: inside the register pairs (v, v + 1)
        zetas = ZETAS_TO_INVERT_LAYER_0[4 * g + 0];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_0_QINV[4 * g + 0];
        r0, r1 = __gs_butterfly_2(r0, r1, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_0[4 * g + 1];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_0_QINV[4 * g + 1];
        r2, r3 = __gs_butterfly_2(r2, r3, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_0[4 * g + 2];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_0_QINV[4 * g + 2];
        r4, r5 = __gs_butterfly_2(r4, r5, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_0[4 * g + 3];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_0_QINV[4 * g + 3];
        r6, r7 = __gs_butterfly_2(r6, r7, zetas, zetas_qinv);

        zetas = ZETAS_TO_INVERT_LAYER_1[4 * g + 0];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_1_QINV[4 * g + 0];
        r0, r1 = __gs_butterfly_4(r0, r1, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_1[4 * g + 1];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_1_QINV[4 * g + 1];
        r2, r3 = __gs_butterfly_4(r2, r3, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_1[4 * g + 2];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_1_QINV[4 * g + 2];
        r4, r5 = __gs_butterfly_4(r4, r5, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_1[4 * g + 3];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_1_QINV[4 * g + 3];
        r6, r7 = __gs_butterfly_4(r6, r7, zetas, zetas_qinv);

        zetas = ZETAS_TO_INVERT_LAYER_2[4 * g + 0];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_2_QINV[4 * g + 0];
        r0, r1 = __gs_butterfly_8(r0, r1, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_2[4 * g + 1];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_2_QINV[4 * g + 1];
        r2, r3 = __gs_butterfly_8(r2, r3, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_2[4 * g + 2];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_2_QINV[4 * g + 2];
        r4, r5 = __gs_butterfly_8(r4, r5, zetas, zetas_qinv);
        zetas = ZETAS_TO_INVERT_LAYER_2[4 * g + 3];
        zetas_qinv = ZETAS_TO_INVERT_LAYER_2_QINV[4 * g + 3];
        r6, r7 = __gs_butterfly_8(r6, r7, zetas, zetas_qinv);

        // layer 3: pairs (v, v + 1)
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3[4 * g + 0]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3_QINV[4 * g + 0]);
        r0, r1 = __gs_butterfly(r0, r1, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3[4 * g + 1]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3_QINV[4 * g + 1]);
        r2, r3 = __gs_butterfly(r2, r3, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3[4 * g + 2]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3_QINV[4 * g + 2]);
        r4, r5 = __gs_butterfly(r4, r5, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3[4 * g + 3]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_3_QINV[4 * g + 3]);
        r6, r7 = __gs_butterfly(r6, r7, zetas, zetas_qinv);

        // layer 4: pairs (v, v + 2)
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_4[2 * g]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_4_QINV[2 * g]);
        r0, r2 = __gs_butterfly(r0, r2, zetas, zetas_qinv);
        r1, r3 = __gs_butterfly(r1, r3, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_4[2 * g + 1]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_4_QINV[2 * g + 1]);
        r4, r6 = __gs_butterfly(r4, r6, zetas, zetas_qinv);
        r5, r7 = __gs_butterfly(r5, r7, zetas, zetas_qinv);

        polynomial.[:u256 32 * (8 * g + 0)] = r0;
        polynomial.[:u256 32 * (8 * g + 1)] = r1;
        polynomial.[:u256 32 * (8 * g + 2)] = r2;
        polynomial.[:u256 32 * (8 * g + 3)] = r3;
        polynomial.[:u256 32 * (8 * g + 4)] = r4;
        polynomial.[:u256 32 * (8 * g + 5)] = r5;
        polynomial.[:u256 32 * (8 * g + 6)] = r6;
        polynomial.[:u256 32 * (8 * g + 7)] = r7;

        return polynomial;
    }

    // Pass B: layers 5, 6, 7 and the scaling on the column j
    // (registers j, j+4, ..., j+28).
    #[safety =
       { requires = 0 <= j && j <= 3 && is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __invert_ntt_layers_5_6_7(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        inline int j
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 r0 r1 r2 r3 r4 r5 r6 r7;
        reg u256 zetas zetas_qinv scaling scaling_qinv;

        r0 = polynomial.[:u256 32 * (j +  0)];
        r1 = polynomial.[:u256 32 * (j +  4)];
        r2 = polynomial.[:u256 32 * (j +  8)];
        r3 = polynomial.[:u256 32 * (j + 12)];
        r4 = polynomial.[:u256 32 * (j + 16)];
        r5 = polynomial.[:u256 32 * (j + 20)];
        r6 = polynomial.[:u256 32 * (j + 24)];
        r7 = polynomial.[:u256 32 * (j + 28)];

        // layer 5: pairs (v, v + 4), one root per quarter
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5[0]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5_QINV[0]);
        r0, r1 = __gs_butterfly(r0, r1, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5[1]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5_QINV[1]);
        r2, r3 = __gs_butterfly(r2, r3, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5[2]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5_QINV[2]);
        r4, r5 = __gs_butterfly(r4, r5, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5[3]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_5_QINV[3]);
        r6, r7 = __gs_butterfly(r6, r7, zetas, zetas_qinv);

        // layer 6: pairs (v, v + 8), one root per half
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_6[0]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_6_QINV[0]);
        r0, r2 = __gs_butterfly(r0, r2, zetas, zetas_qinv);
        r1, r3 = __gs_butterfly(r1, r3, zetas, zetas_qinv);
        zetas = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_6[1]);
        zetas_qinv = #VPBROADCAST_8u32(ZETAS_TO_INVERT_LAYER_6_QINV[1]);
        r4, r6 = __gs_butterfly(r4, r6, zetas, zetas_qinv);
        r5, r7 = __gs_butterfly(r5, r7, zetas, zetas_qinv);

        // layer 7: pairs (v, v + 16), one root, with the scaling by f, the
        // Montgomery form of 1/256, folded in: the sums are multiplied by f
        // and the differences by zeta f (one Montgomery multiplication each
        // instead of two for the differences).
        zetas = #VPBROADCAST_8u32(INVERSE_NTT_LAYER_7_CONSTANTS[0]);
        zetas_qinv = #VPBROADCAST_8u32(INVERSE_NTT_LAYER_7_CONSTANTS[1]);
        scaling = #VPBROADCAST_8u32(INVERSE_NTT_LAYER_7_CONSTANTS[2]);
        scaling_qinv = #VPBROADCAST_8u32(INVERSE_NTT_LAYER_7_CONSTANTS[3]);
        r0, r4 = __gs_butterfly_scaled(r0, r4, zetas, zetas_qinv, scaling, scaling_qinv);
        r1, r5 = __gs_butterfly_scaled(r1, r5, zetas, zetas_qinv, scaling, scaling_qinv);
        r2, r6 = __gs_butterfly_scaled(r2, r6, zetas, zetas_qinv, scaling, scaling_qinv);
        r3, r7 = __gs_butterfly_scaled(r3, r7, zetas, zetas_qinv, scaling, scaling_qinv);

        polynomial.[:u256 32 * (j +  0)] = r0;
        polynomial.[:u256 32 * (j +  4)] = r1;
        polynomial.[:u256 32 * (j +  8)] = r2;
        polynomial.[:u256 32 * (j + 12)] = r3;
        polynomial.[:u256 32 * (j + 16)] = r4;
        polynomial.[:u256 32 * (j + 20)] = r5;
        polynomial.[:u256 32 * (j + 24)] = r6;
        polynomial.[:u256 32 * (j + 28)] = r7;

        return polynomial;
    }

    fn invert_ntt_montgomery(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        inline int i;

        for i = 0 to 4 {
            polynomial = __invert_ntt_layers_0_to_4(polynomial, i);
        }
        for i = 0 to 4 {
            polynomial = __invert_ntt_layers_5_6_7(polynomial, i);
        }

        return polynomial;
    }
}
