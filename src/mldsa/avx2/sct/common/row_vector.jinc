require "polynomial.jinc"

// A row vector has dimensions 1 * COLUMNS_IN_MATRIX_A
namespace row_vector {
    fn ntt(reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] vector)
        -> reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL]
    {
        inline int i;
        for i = 0 to COLUMNS_IN_MATRIX_A {
            vector[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL] =
                polynomial::ntt(
                    vector[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL]
                );
        }

        return vector;
    }

    // output = sum_i lhs_i * rhs_i (pointwise, Montgomery domain), with the
    // COLUMNS_IN_MATRIX_A products of each coefficient accumulated on 64 bits
    // and reduced once, in a single pass over the polynomial: one Montgomery
    // reduction per coefficient instead of one per product, and no store or
    // addition pass per product. The sum of at most 7 products |a b| < q 2^31
    // stays below 2^63, and the reduction of a 64-bit T with |T| < 7 q 2^31
    // returns a value in (-4q, 4q), which the reduce32 that follows centres.
    #[safety =
       { requires = is_arr_init(lhs,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
                 && is_arr_init(rhs,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
       , ensures = is_arr_init(output,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __dot_product(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] output,
        reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] lhs rhs
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 lhs_coeffs rhs_coeffs lhs_high rhs_high;
        reg u256 product_low product_high acc_low acc_high;
        reg u256 t_low t_high qinv modulus;
        reg ui64 offset;
        inline int i;

        qinv = INVERSE_OF_MODULUS_MOD_MONTGOMERY_R_VECTOR;
        modulus = MODULUS_VECTOR;

        offset = 0;
        while (offset < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            for i = 0 to COLUMNS_IN_MATRIX_A {
                lhs_coeffs = lhs.[:u256 offset + i * BYTES_PER_UNCOMPRESSED_POLYNOMIAL];
                rhs_coeffs = rhs.[:u256 offset + i * BYTES_PER_UNCOMPRESSED_POLYNOMIAL];
                lhs_high = #VMOVSHDUP_256(lhs_coeffs);
                rhs_high = #VMOVSHDUP_256(rhs_coeffs);
                product_low = #VPMUL_256(lhs_coeffs, rhs_coeffs);
                product_high = #VPMUL_256(lhs_high, rhs_high);
                if (i == 0) {
                    acc_low = product_low;
                    acc_high = product_high;
                } else {
                    acc_low = #VPADD_4u64(acc_low, product_low);
                    acc_high = #VPADD_4u64(acc_high, product_high);
                }
            }

            // One Montgomery reduction of the 64-bit sums (as in
            // montgomery_multiply_and_reduce, on the accumulated products).
            t_low = #VPMUL_256(acc_low, qinv);
            t_high = #VPMUL_256(acc_high, qinv);
            t_low = #VPMUL_256(t_low, modulus);
            t_high = #VPMUL_256(t_high, modulus);
            acc_low = #VPSUB_4u64(acc_low, t_low);
            acc_high = #VPSUB_4u64(acc_high, t_high);
            acc_low = #VMOVSHDUP_256(acc_low);
            acc_low = #VPBLEND_8u32(acc_low, acc_high, 0b1_0_1_0_1_0_1_0);
            output.[:u256 offset] = acc_low;

            offset += 32;
        }

        return output;
    }

    // Compute A * NTT(vector)
    inline
    fn __multiply_with_matrix_A(
        reg ptr u32[ROWS_IN_MATRIX_A * COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] matrix_A,
        reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] vector
    ) -> stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL]
    {
        stack u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] out;

        inline int i;
        for i = 0 to ROWS_IN_MATRIX_A {
            out[COEFFICIENTS_IN_POLYNOMIAL * i : COEFFICIENTS_IN_POLYNOMIAL] =
                __dot_product(
                    out[COEFFICIENTS_IN_POLYNOMIAL * i : COEFFICIENTS_IN_POLYNOMIAL],
                    matrix_A[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL * i : COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL],
                    vector
                );
        }

        return out;
    }

    inline
    fn __conditionally_add_modulus(reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] vector)
        -> reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL]
    {
        inline int i;
        for i = 0 to COLUMNS_IN_MATRIX_A {
            vector[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL] =
                polynomial::conditionally_add_modulus(vector[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL]);
        }
        return vector;
    }

    inline
    fn __check_infinity_norm(reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] vector, inline int threshold)
        -> reg u64
    {
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] vector_element;
        reg u64 result;

        reg u64 ret;

        inline int i;

        result = 0;
        for i = 0 to COLUMNS_IN_MATRIX_A {
            vector_element = vector[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL];
            ret = polynomial::__check_infinity_norm(vector_element, threshold);
            result |= ret;
        }

        return result;
    }
}
