namespace commitment {
    u256 ENCODING_SHUFFLES_bits4 = (32u8)[
        15, 14, 7, 6, 13, 12, 5, 4,
        11, 10, 3, 2, 9, 8, 1, 0, 15,
        14, 7, 6, 13, 12, 5, 4, 11, 10,
        3, 2, 9, 8, 1, 0
    ];

    #[safety =
       { requires = is_arr_init(commitment,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_COMMITMENT_POLYNOMIAL_SIZE)
       }
     ]
    inline
    fn __encode_polynomial_bits4(
        reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] commitment
    ) -> reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE]
    {
        reg u256 c0 c1 c2 c3 c4 c5 c6 c7;
        reg u256 shift encoding_shuffles;

        reg ui64 input_offset output_offset;
        reg u64 temp;

        temp = (16 << 8) + 1;
        shift = (256u)#VMOV(temp);
        shift = #VPBROADCAST_16u16(shift);

        encoding_shuffles = ENCODING_SHUFFLES_bits4;

        input_offset = 0;
        output_offset = 0;
        while (output_offset < ENCODED_COMMITMENT_POLYNOMIAL_SIZE) {
            // Since each coefficient is only 4-bits long, we load 64 coefficients,
            // allowing us to pack the entire 256-bit AVX2 register.
            c0 = commitment.[:u256 input_offset];
            input_offset += 32;
            c1 = commitment.[:u256 input_offset];
            input_offset += 32;
            c2 = commitment.[:u256 input_offset];
            input_offset += 32;
            c3 = commitment.[:u256 input_offset];
            input_offset += 32;
            c4 = commitment.[:u256 input_offset];
            input_offset += 32;
            c5 = commitment.[:u256 input_offset];
            input_offset += 32;
            c6 = commitment.[:u256 input_offset];
            input_offset += 32;
            c7 = commitment.[:u256 input_offset];
            input_offset += 32;

            c0 = #VPACKUS_8u32(c0, c1);
            c1 = #VPACKUS_8u32(c2, c3);
            c2 = #VPACKUS_8u32(c4, c5);
            c3 = #VPACKUS_8u32(c6, c7);

            c0 = #VPACKUS_16u16(c0, c1);
            c1 = #VPACKUS_16u16(c2, c3);

            c0 = #VPMADDUBSW_256(c0, shift);
            c1 = #VPMADDUBSW_256(c1, shift);

            c0 = #VPACKUS_16u16(c0, c1);
            c0 = #VPERMQ(c0, 0b1_1_0_1_1_0_0_0);

            c0 = #VPSHUFB_256(c0, encoding_shuffles);

            encoded.[:u256 output_offset] = c0;
            output_offset += 32;
        }

        return encoded;
    }

    u256[4] ENCODING_CONSTANTS_TABLE_bits6 = {
        (32u8)[
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1
        ],
        (16u16)[
            (1 << 12), 1, (1 << 12), 1, (1 << 12), 1, (1 << 12), 1,
            (1 << 12), 1, (1 << 12), 1, (1 << 12), 1, (1 << 12), 1
        ],
        (8u32)[7, 3, 6, 2, 5, 1, 4, 0],
        (32u8)[
            -1, -1, -1, -1, 14, 13, 12, 10, 9, 8, 6, 5, 4, 2, 1, 0,
            -1, -1, -1, -1, 14, 13, 12, 10, 9, 8, 6, 5, 4, 2, 1, 0
        ]
    };
    fn coefficients_to_bytestream_bits6(reg u256 c0 c1 c2 c3) -> reg u128, reg u128 {
        reg u256 shifts;
        reg u128 bytestream_lower, bytestream_upper;

        c0 = #VPACKUS_8u32(c0, c1);
        c1 = #VPACKUS_8u32(c2, c3);

        c0 = #VPACKUS_16u16(c0, c1);

        shifts = ENCODING_CONSTANTS_TABLE_bits6[0];
        c0 = #VPMADDUBSW_256(c0, shifts);

        shifts = ENCODING_CONSTANTS_TABLE_bits6[1];
        c0 = #VPMADDWD_256(c0, shifts);

        shifts = ENCODING_CONSTANTS_TABLE_bits6[2];
        c0 = #VPERMD(shifts, c0);

        shifts = ENCODING_CONSTANTS_TABLE_bits6[3];
        c0 = #VPSHUFB_256(c0, shifts);

        bytestream_lower = (128u)c0;
        bytestream_upper = #VEXTRACTI128(c0, 1);

        return bytestream_lower, bytestream_upper;
    }

    #[safety =
       { requires = is_arr_init(raw,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_COMMITMENT_POLYNOMIAL_SIZE)
       }
     ]
    inline
    fn __encode_polynomial_bits6(
        reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] raw
    ) -> reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE]
    {
        reg u256 c0 c1 c2 c3;
        reg u128 bytestream_lower, bytestream_upper;

        stack u8[16] final_encoded_bytes;

        reg ui64 input_offset output_offset;

        input_offset = 0;
        output_offset = 0;
        while (output_offset < (6 * COEFFICIENTS_IN_POLYNOMIAL) / 8 - 24) {
            c0 = raw.[:u256 input_offset];
            input_offset += 32;
            c1 = raw.[:u256 input_offset];
            input_offset += 32;
            c2 = raw.[:u256 input_offset];
            input_offset += 32;
            c3 = raw.[:u256 input_offset];
            input_offset += 32;

            bytestream_lower, bytestream_upper = coefficients_to_bytestream_bits6(c0, c1, c2, c3);

            encoded.[:u128 output_offset] = bytestream_lower;
            encoded.[:u128 output_offset + 12] = bytestream_upper;
            output_offset += 24;
        }
        c0 = raw.[:u256 input_offset];
        input_offset += 32;
        c1 = raw.[:u256 input_offset];
        input_offset += 32;
        c2 = raw.[:u256 input_offset];
        input_offset += 32;
        c3 = raw.[:u256 input_offset];

        bytestream_lower, bytestream_upper = coefficients_to_bytestream_bits6(c0, c1, c2, c3);
        encoded.[:u128 output_offset] = bytestream_lower;
        output_offset += 12;

        final_encoded_bytes.[:u128 0] = bytestream_upper;
        input_offset = 0;
        while (input_offset < 12) {
            encoded[output_offset] = final_encoded_bytes[input_offset];
            output_offset += 1;
            input_offset += 1;
        }

        return encoded;
    }

    // The encoding of a commitment coefficient: 4 bits (gamma2 = (q - 1) / 32)
    // or 6 bits (gamma2 = (q - 1) / 88)
    #[safety =
       { requires = is_arr_init(commitment,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_COMMITMENT_POLYNOMIAL_SIZE)
       }
     ]
    inline
    fn __encode_polynomial(
        reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] commitment
    ) -> reg ptr u8[ENCODED_COMMITMENT_POLYNOMIAL_SIZE]
    {
        if (BITS_PER_COMMITMENT_COEFFICIENT == 6) {
            encoded = __encode_polynomial_bits6(encoded, commitment);
        } else {
            encoded = __encode_polynomial_bits4(encoded, commitment);
        }
        return encoded;
    }

    inline
    fn __encode(reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] commitment)
        -> stack u8[ENCODED_COMMITMENT_SIZE]
    {
        stack u8[ENCODED_COMMITMENT_SIZE] encoded_commitment;

        inline int i;

        for i = 0 to ROWS_IN_MATRIX_A {
            encoded_commitment[i * ENCODED_COMMITMENT_POLYNOMIAL_SIZE :
                                   ENCODED_COMMITMENT_POLYNOMIAL_SIZE] =
            __encode_polynomial(
                encoded_commitment[i * ENCODED_COMMITMENT_POLYNOMIAL_SIZE : ENCODED_COMMITMENT_POLYNOMIAL_SIZE],
                commitment[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL]
            );
        }

        return encoded_commitment;
    }
}
