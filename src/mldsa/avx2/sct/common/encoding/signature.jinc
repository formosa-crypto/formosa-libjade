namespace signature {
    param int START_OF_GAMMA1 = COMMITMENT_HASH_SIZE;
    param int START_OF_HINT = START_OF_GAMMA1 + GAMMA1_ENCODED_SIZE;

    // The hint is public here (declassified by the caller once the exiting
    // iteration is chosen), so its encoding may take time that depends on it:
    // eight coefficients are compared at a time and the positions of the
    // non-zero ones are read off the resulting bit mask. The exiting
    // iteration is encoded whether or not it passed the hint-weight test, so
    // the positions beyond MAX_ONES_IN_HINT are dropped (they would otherwise
    // overwrite the counts and run past the end of the signature; the result
    // code tells the caller the iteration failed).
    #[safety =
       { requires = is_arr_init(hint,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
                 && is_arr_init(signature,0,COMMITMENT_HASH_SIZE + GAMMA1_ENCODED_SIZE)
       , ensures = is_arr_init(signature,0,SIGNATURE_SIZE)
       }
     ]
    inline
    fn __encode_hint(
        reg ptr u8[SIGNATURE_SIZE] signature,
        reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hint
    ) -> reg ptr u8[SIGNATURE_SIZE]
    {
        reg u256 coefficients zeros equal_to_zero;
        reg ui64 i j hints_written offset bound;
        reg u64 position nonzero zero;
        reg u32 mask;
        reg bool condition_row condition_group condition_bit condition_room;
        #[msf] reg u64 ms;

        inline int k;

        // Clear the hints buffer
        zero = 0;
        for k = 0 to HINT_ENCODED_SIZE / 8 {
            signature.[:u64 START_OF_HINT + 8 * k] = zero;
        }
        for k = 8 * (HINT_ENCODED_SIZE / 8) to HINT_ENCODED_SIZE {
            signature[START_OF_HINT + k] = 0;
        }

        ms = #init_msf();
        zeros = #set0_256();

        hints_written = 0;
        i = 0;
        while { condition_row = i < ROWS_IN_MATRIX_A; } (condition_row) {
            ms = #update_msf(condition_row, ms);
            offset = i;
            offset <<= LOG_2_COEFFICIENTS_IN_POLYNOMIAL + 2;
            bound = offset;
            bound += BYTES_PER_UNCOMPRESSED_POLYNOMIAL;
            j = 0;
            while { condition_group = offset < bound; } (condition_group) {
                ms = #update_msf(condition_group, ms);
                coefficients = hint.[:u256 offset];
                // MOVEMASK_8u32 is not DOIT: its operand is protected first.
                coefficients = #protect_256(coefficients, ms);
                equal_to_zero = #VPCMPEQ_8u32(coefficients, zeros);
                mask = #MOVEMASK_8u32(equal_to_zero);
                nonzero = (64u) mask;
                nonzero ^= 0xFF;

                while { condition_bit = nonzero != 0; } (condition_bit) {
                    ms = #update_msf(condition_bit, ms);
                    _, _, _, _, _, position = #TZCNT_64(nonzero);
                    position += (64u) j;
                    condition_room = hints_written < MAX_ONES_IN_HINT;
                    if (condition_room) {
                        ms = #update_msf(condition_room, ms);
                        signature[START_OF_HINT + hints_written] = (8u) position;
                        hints_written += 1;
                    } else {
                        ms = #update_msf(!condition_room, ms);
                    }
                    // clear the lowest set bit
                    position = nonzero;
                    position -= 1;
                    nonzero &= position;
                }
                ms = #update_msf(!condition_bit, ms);

                j += 8;
                offset += 32;
            }
            ms = #update_msf(!condition_group, ms);

            signature[START_OF_HINT + MAX_ONES_IN_HINT + i] = (8u)(64u) hints_written;
            i += 1;
        }
        return signature;
    }

    // The fixed signature of a failed signing: every byte is 0. A byte loop:
    // this path is only taken when the iteration budget is exhausted.
    #[safety =
       { ensures = is_arr_init(signature,0,SIGNATURE_SIZE)
       }
     ]
    inline
    fn __zero(
        reg ptr u8[SIGNATURE_SIZE] signature
    ) -> reg ptr u8[SIGNATURE_SIZE]
    {
        reg ui64 i;

        i = 0;
        while (i < SIGNATURE_SIZE) {
            signature[i] = 0;
            i += 1;
        }
        return signature;
    }

    #[safety =
       { requires = is_arr_init(commitment_hash,0,COMMITMENT_HASH_SIZE)
                 && is_arr_init(signer_response,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
                 && is_arr_init(hint,0,4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
       , ensures = is_arr_init(signature,0,SIGNATURE_SIZE)
       }
     ]
    inline
    fn __encode(
        reg ptr u8[SIGNATURE_SIZE] signature,
        reg ptr u8[COMMITMENT_HASH_SIZE] commitment_hash,
        reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] signer_response,
        reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hint
    ) -> reg ptr u8[SIGNATURE_SIZE]
    {
        reg ui64 i;
        reg u128 bytes;

        i = 0;
        while (i < COMMITMENT_HASH_SIZE) {
            bytes = commitment_hash.[:u128 i];
            signature.[:u128 i] = bytes;
            i += 16;
        }

        signature[START_OF_GAMMA1 : GAMMA1_ENCODED_SIZE] = 
           gamma1::__encode(signature[START_OF_GAMMA1 : GAMMA1_ENCODED_SIZE], signer_response);

        signature = __encode_hint(signature, hint);

        return signature;
    }

    #[safety =
       { requires = is_arr_init(hint_encoded,0,HINT_ENCODED_SIZE)
       , ensures = is_arr_init(hints,0,(ill_formed_hint == 0 ? 4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) : 0))
       }
     ]
    inline
    fn __decode_hint(
        reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hints,
        reg ptr u8[HINT_ENCODED_SIZE] hint_encoded
    ) -> reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], reg u64
    {
        reg ui64 j, index, previous_true_hints_seen current_true_hints_seen;
        reg ui64 decoded_offset encoded_offset;
        reg u8 done1, done2, done3;
        reg bool within_bounds not_done1 not_done2 not_done3;
        reg bool condition_zero condition_decreasing condition_too_many condition_not_first;
        reg bool condition_unordered condition_well_formed condition_nonzero;
        reg u64 hint hint_at_j hint_at_j_minus_one ill_formed_hint true_hints_seen;
        #[msf] reg u64 ms;

        ms = #init_msf();

        ill_formed_hint = 0;
        previous_true_hints_seen = 0;

        encoded_offset = 0;
        while {
            within_bounds = encoded_offset >= ROWS_IN_MATRIX_A;
            done1 = #SETcc(within_bounds);
            done1 |= ill_formed_hint;
            not_done1 = done1 == 0;
        } (not_done1) {
            ms = #update_msf(not_done1, ms);
            decoded_offset = encoded_offset;
            decoded_offset <<= LOG_2_COEFFICIENTS_IN_POLYNOMIAL;
            j = 0;

            while { condition_zero = j < COEFFICIENTS_IN_POLYNOMIAL; } (condition_zero) {
                ms = #update_msf(condition_zero, ms);
                index = decoded_offset;
                index += j;
                hints[index] = 0;
                j += 1;
            }
            ms = #update_msf(!condition_zero, ms);

            true_hints_seen = (64u)hint_encoded[MAX_ONES_IN_HINT + encoded_offset];
            true_hints_seen = #protect(true_hints_seen, ms);
            current_true_hints_seen = (64ui)true_hints_seen;

            condition_decreasing = current_true_hints_seen < previous_true_hints_seen;
            if (condition_decreasing) {
                ms = #update_msf(condition_decreasing, ms);
                ill_formed_hint = 1;
            } else {
                ms = #update_msf(!condition_decreasing, ms);
                condition_too_many = current_true_hints_seen > MAX_ONES_IN_HINT;
                if (condition_too_many) {
                    ms = #update_msf(condition_too_many, ms);
                    ill_formed_hint = 1;
                } else {
                    ms = #update_msf(!condition_too_many, ms);
                    j = previous_true_hints_seen;

                    while {
                        within_bounds = j >= current_true_hints_seen;
                        done2 = #SETcc(within_bounds);
                        done2 |= ill_formed_hint;
                        not_done2 = done2 == 0;
                    } (not_done2) {
                        ms = #update_msf(not_done2, ms);
                        // Coefficients are ordered for strong unforgeability
                        hint_at_j = (64u)hint_encoded[j];
                        hint_at_j = #protect(hint_at_j, ms);

                        condition_not_first = j > previous_true_hints_seen;
                        if (condition_not_first) {
                            ms = #update_msf(condition_not_first, ms);
                            hint_at_j_minus_one = (64u)hint_encoded[j - 1];
                            hint_at_j_minus_one = #protect(hint_at_j_minus_one, ms);

                            condition_unordered = hint_at_j <= hint_at_j_minus_one;
                            if (condition_unordered) {
                                ms = #update_msf(condition_unordered, ms);
                                ill_formed_hint = 1;
                            } else {
                                ms = #update_msf(!condition_unordered, ms);
                            }
                        } else {
                            ms = #update_msf(!condition_not_first, ms);
                        }

                        condition_well_formed = ill_formed_hint == 0;
                        if (condition_well_formed) {
                            ms = #update_msf(condition_well_formed, ms);
                            // h->vec[i].coeffs[sig[j]] = 1;
                            index = decoded_offset;
                            index += (64ui)hint_at_j;
                            hints[index] = 1;

                            j += 1;

                        } else {
                            ms = #update_msf(!condition_well_formed, ms);
                        }
                    }
                    ms = #update_msf(!not_done2, ms);
                }
            }

            condition_well_formed = ill_formed_hint == 0;
            if (condition_well_formed) {
                ms = #update_msf(condition_well_formed, ms);
                previous_true_hints_seen = current_true_hints_seen;
                encoded_offset += 1;
            } else {
                ms = #update_msf(!condition_well_formed, ms);
            }
        }
        ms = #update_msf(!not_done1, ms);

        encoded_offset = previous_true_hints_seen;
        while {
            within_bounds = encoded_offset >= MAX_ONES_IN_HINT;
            done3 = #SETcc(within_bounds);
            done3 |= ill_formed_hint;
            not_done3 = done3 == 0;
        } (not_done3) {
            ms = #update_msf(not_done3, ms);
            hint = (64u)hint_encoded[encoded_offset];
            hint = #protect(hint, ms);

            condition_nonzero = hint != 0;
            if (condition_nonzero) {
                ms = #update_msf(condition_nonzero, ms);
                ill_formed_hint = 1;
            } else {
                ms = #update_msf(!condition_nonzero, ms);
            }

            condition_well_formed = ill_formed_hint == 0;
            if (condition_well_formed) {
                ms = #update_msf(condition_well_formed, ms);
                encoded_offset += 1;
            } else {
                ms = #update_msf(!condition_well_formed, ms);
            }
        }

        // Do this so we can indicate success with 0 and failure with -1.
        ill_formed_hint = -ill_formed_hint;

        return hints, ill_formed_hint;
    }

    #[safety =
       { requires = is_arr_init(signature_encoded,0,SIGNATURE_SIZE)
       , ensures = is_arr_init(signer_response,0,4 * (COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL))
                && is_arr_init(hints,0,(result == 0 ? 4 * (ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL) : 0))
       }
     ]
    inline
    fn __decode(
        reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] signer_response,
        reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] hints,
        reg ptr u8[SIGNATURE_SIZE] signature_encoded
    ) -> reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL],
        reg ptr u32[ROWS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL], 
        reg u64

    {
        reg u64 result;

        signer_response = gamma1::__decode(signer_response, signature_encoded[COMMITMENT_HASH_SIZE: GAMMA1_ENCODED_SIZE]);

        hints, result = __decode_hint(hints, signature_encoded[START_OF_HINT:HINT_ENCODED_SIZE]);

        return (signer_response,hints,result);
    }

}



