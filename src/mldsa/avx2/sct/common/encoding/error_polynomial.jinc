namespace error_polynomial {
    u256 ENCODING_SHUFFLES = (32u8)[
        15, 14, 7, 6, 13, 12, 5, 4,
        11, 10, 3, 2, 9, 8, 1, 0, 15,
        14, 7, 6, 13, 12, 5, 4, 11, 10,
        3, 2, 9, 8, 1, 0
    ];
    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       }
     ]
    fn encode_eta4(
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE]
    {
        reg u256 c0 c1 c2 c3 c4 c5 c6 c7;
        reg u256 shift encoding_shuffles;
        reg u256 eta;

        reg ui64 input_offset output_offset;
        reg u64 temp;

        temp = (16 << 8) + 1;
        shift = (256u)#VMOV(temp);
        shift = #VPBROADCAST_16u16(shift);

        temp = ETA;
        eta = (256u)#VMOV(temp);
        eta = #VPBROADCAST_8u32(eta);

        encoding_shuffles = ENCODING_SHUFFLES;

        input_offset = 0;
        output_offset = 0;
        while (output_offset < ENCODED_ERROR_POLYNOMIAL_SIZE) {
            c0 = polynomial.[:u256 input_offset];
            c0 = #VPSUB_8u32(eta, c0);
            input_offset += 32;

            c1 = polynomial.[:u256 input_offset];
            c1 = #VPSUB_8u32(eta, c1);
            input_offset += 32;

            c2 = polynomial.[:u256 input_offset];
            c2 = #VPSUB_8u32(eta, c2);
            input_offset += 32;

            c3 = polynomial.[:u256 input_offset];
            c3 = #VPSUB_8u32(eta, c3);
            input_offset += 32;

            c4 = polynomial.[:u256 input_offset];
            c4 = #VPSUB_8u32(eta, c4);
            input_offset += 32;

            c5 = polynomial.[:u256 input_offset];
            c5 = #VPSUB_8u32(eta, c5);
            input_offset += 32;

            c6 = polynomial.[:u256 input_offset];
            c6 = #VPSUB_8u32(eta, c6);
            input_offset += 32;

            c7 = polynomial.[:u256 input_offset];
            c7 = #VPSUB_8u32(eta, c7);
            input_offset += 32;

            c0 = #VPACKUS_8u32(c0, c1);
            c1 = #VPACKUS_8u32(c2, c3);
            c2 = #VPACKUS_8u32(c4, c5);
            c3 = #VPACKUS_8u32(c6, c7);

            c0 = #VPACKUS_16u16(c0, c1);
            c1 = #VPACKUS_16u16(c2, c3);

            c0 = #VPMADDUBSW_256(c0, shift);
            c1 = #VPMADDUBSW_256(c1, shift);

            c0 = #VPACKUS_16u16(c0, c1);
            c0 = #VPERMQ(c0, 0b11_01_10_00);

            c0 = #VPSHUFB_256(c0, encoding_shuffles);

            encoded.[:u256 output_offset] = c0;
            output_offset += 32;
        }

        return encoded;
    }

    // Eight 4-bit coefficients per 4 bytes: the 4 bytes at 4 i in every lane,
    // shifted right by 4 k in lane k.
    u256 ETA4_DECODING_SHIFTS = (8u32)[28, 24, 20, 16, 12, 8, 4, 0];
    #[safety =
       { requires = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       , ensures = is_arr_init(decoded,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    fn decode_eta4(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] decoded,
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 coefficients mask shifts eta;
        reg u64 temp;

        inline int i;

        temp = (1 << 4) - 1;
        mask = (256u)#VMOV(temp);
        mask = #VPBROADCAST_8u32(mask);

        temp = ETA;
        eta = (256u)#VMOV(temp);
        eta = #VPBROADCAST_8u32(eta);

        shifts = ETA4_DECODING_SHIFTS;
        for i = 0 to COEFFICIENTS_IN_POLYNOMIAL / 8 {
            coefficients = #VPBROADCAST_8u32(encoded.[:u32 4 * i]);
            coefficients = #VPSRLV_8u32(coefficients, shifts);
            coefficients = #VPAND_256(coefficients, mask);
            coefficients = #VPSUB_8u32(eta, coefficients);
            decoded.[:u256 32 * i] = coefficients;
        }

        return decoded;
    }

    // ETA = 2
    // the shifts of decode_eta2: the groups at 3 i, then the last group
    u256[2] ETA2_DECODING_SHIFTS = {
        (8u32)[21, 18, 15, 12, 9, 6, 3, 0],
        (8u32)[29, 26, 23, 20, 17, 14, 11, 8]
    };

    u256[5] ETA2_ENCODING_CONSTANTS = {
        (32u8)[
            (1 << 3), 1, (1 << 3), 1, (1 << 3), 1, (1 << 3), 1,
            (1 << 3), 1, (1 << 3), 1, (1 << 3), 1, (1 << 3), 1,
            (1 << 3), 1, (1 << 3), 1, (1 << 3), 1, (1 << 3), 1,
            (1 << 3), 1, (1 << 3), 1, (1 << 3), 1, (1 << 3), 1
        ],
        (32u8)[
            15, 14, 7, 6, 13, 12, 5, 4, 11, 10, 3, 2, 9, 8, 1, 0,
            15, 14, 7, 6, 13, 12, 5, 4, 11, 10, 3, 2, 9, 8, 1, 0
        ],
        (32u8)[
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1,
            (1 << 6), 1, (1 << 6), 1, (1 << 6), 1, (1 << 6), 1
        ],
        (16u16)[
            (1 << 12), 1, (1 << 12), 1, (1 << 12), 1, (1 << 12), 1,
            (1 << 12), 1, (1 << 12), 1, (1 << 12), 1, (1 << 12), 1
        ],
        (32u8)[
            -1, -1, -1, -1, 14, 13, 12, 10, 9, 8, 6, 5, 4, 2, 1, 0,
            -1, -1, -1, -1, 14, 13, 12, 10, 9, 8, 6, 5, 4, 2, 1, 0
        ]
    };

    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       }
     ]
    fn encode_eta2(
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE]
    {
        reg u256 c0 c1 c2 c3 c4 c5 c6 c7;
        reg u256 encoding_constants;
        reg u256 eta;

        reg ui64 input_offset output_offset;
        reg u64 temp;

        stack u8[16] final_encoded_bytes;

        temp = ETA;
        eta = (256u)#VMOV(temp);
        eta = #VPBROADCAST_8u32(eta);

        input_offset = 0;
        output_offset = 0;
        while (output_offset < (3 * COEFFICIENTS_IN_POLYNOMIAL) / 8 - 24) {
            c0 = polynomial.[:u256 input_offset];
            c0 = #VPSUB_8u32(eta, c0);
            input_offset += 32;

            c1 = polynomial.[:u256 input_offset];
            c1 = #VPSUB_8u32(eta, c1);
            input_offset += 32;

            c2 = polynomial.[:u256 input_offset];
            c2 = #VPSUB_8u32(eta, c2);
            input_offset += 32;

            c3 = polynomial.[:u256 input_offset];
            c3 = #VPSUB_8u32(eta, c3);
            input_offset += 32;

            c4 = polynomial.[:u256 input_offset];
            c4 = #VPSUB_8u32(eta, c4);
            input_offset += 32;

            c5 = polynomial.[:u256 input_offset];
            c5 = #VPSUB_8u32(eta, c5);
            input_offset += 32;

            c6 = polynomial.[:u256 input_offset];
            c6 = #VPSUB_8u32(eta, c6);
            input_offset += 32;

            c7 = polynomial.[:u256 input_offset];
            c7 = #VPSUB_8u32(eta, c7);
            input_offset += 32;

            c0 = #VPACKUS_8u32(c0, c1);
            c1 = #VPACKUS_8u32(c2, c3);
            c2 = #VPACKUS_8u32(c4, c5);
            c3 = #VPACKUS_8u32(c6, c7);

            c0 = #VPACKUS_16u16(c0, c1);
            c1 = #VPACKUS_16u16(c2, c3);

            encoding_constants = ETA2_ENCODING_CONSTANTS[0];
            c0 = #VPMADDUBSW_256(c0, encoding_constants);
            c1 = #VPMADDUBSW_256(c1, encoding_constants);

            c0 = #VPACKUS_16u16(c0, c1);
            c0 = #VPERMQ(c0, 0b11_01_10_00);

            encoding_constants = ETA2_ENCODING_CONSTANTS[1];
            c0 = #VPSHUFB_256(c0, encoding_constants);

            encoding_constants = ETA2_ENCODING_CONSTANTS[2];
            c0 = #VPMADDUBSW_256(c0, encoding_constants);

            encoding_constants = ETA2_ENCODING_CONSTANTS[3];
            c0 = #VPMADDWD_256(c0, encoding_constants);

            encoding_constants = ETA2_ENCODING_CONSTANTS[4];
            c0 = #VPSHUFB_256(c0, encoding_constants);

            encoded.[:u128 output_offset] = (128u)c0;
            encoded.[:u128 output_offset + 12] = #VEXTRACTI128(c0, 1);
            output_offset += 24;
        }
        c0 = polynomial.[:u256 input_offset];
        c0 = #VPSUB_8u32(eta, c0);
        input_offset += 32;

        c1 = polynomial.[:u256 input_offset];
        c1 = #VPSUB_8u32(eta, c1);
        input_offset += 32;

        c2 = polynomial.[:u256 input_offset];
        c2 = #VPSUB_8u32(eta, c2);
        input_offset += 32;

        c3 = polynomial.[:u256 input_offset];
        c3 = #VPSUB_8u32(eta, c3);
        input_offset += 32;

        c4 = polynomial.[:u256 input_offset];
        c4 = #VPSUB_8u32(eta, c4);
        input_offset += 32;

        c5 = polynomial.[:u256 input_offset];
        c5 = #VPSUB_8u32(eta, c5);
        input_offset += 32;

        c6 = polynomial.[:u256 input_offset];
        c6 = #VPSUB_8u32(eta, c6);
        input_offset += 32;

        c7 = polynomial.[:u256 input_offset];
        c7 = #VPSUB_8u32(eta, c7);

        c0 = #VPACKUS_8u32(c0, c1);
        c1 = #VPACKUS_8u32(c2, c3);
        c2 = #VPACKUS_8u32(c4, c5);
        c3 = #VPACKUS_8u32(c6, c7);

        c0 = #VPACKUS_16u16(c0, c1);
        c1 = #VPACKUS_16u16(c2, c3);

        encoding_constants = ETA2_ENCODING_CONSTANTS[0];
        c0 = #VPMADDUBSW_256(c0, encoding_constants);
        c1 = #VPMADDUBSW_256(c1, encoding_constants);

        c0 = #VPACKUS_16u16(c0, c1);
        c0 = #VPERMQ(c0, 0b11_01_10_00);

        encoding_constants = ETA2_ENCODING_CONSTANTS[1];
        c0 = #VPSHUFB_256(c0, encoding_constants);

        encoding_constants = ETA2_ENCODING_CONSTANTS[2];
        c0 = #VPMADDUBSW_256(c0, encoding_constants);

        encoding_constants = ETA2_ENCODING_CONSTANTS[3];
        c0 = #VPMADDWD_256(c0, encoding_constants);

        encoding_constants = ETA2_ENCODING_CONSTANTS[4];
        c0 = #VPSHUFB_256(c0, encoding_constants);

        encoded.[:u128 output_offset] = (128u)c0;
        output_offset += 12;

        final_encoded_bytes.[:u128 0] = #VEXTRACTI128(c0, 1);

        input_offset = 0;
        while (input_offset < 12) {
            encoded.[output_offset] = final_encoded_bytes[input_offset];
            output_offset += 1;
            input_offset += 1;
        }

        return encoded;
    }

    // Eight 3-bit coefficients per 3 bytes: the 4 bytes at 3 i in every lane,
    // shifted right by 3 k in lane k; the last group reads the last 4 bytes of
    // the encoding, one byte earlier, and shifts by 8 more.
    #[safety =
       { requires = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       , ensures = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    fn decode_eta2(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u256 coefficients mask shifts eta;
        reg u64 temp;

        inline int i;

        temp = (1 << 3) - 1;
        mask = (256u)#VMOV(temp);
        mask = #VPBROADCAST_8u32(mask);

        temp = ETA;
        eta = (256u)#VMOV(temp);
        eta = #VPBROADCAST_8u32(eta);

        shifts = ETA2_DECODING_SHIFTS[0];
        for i = 0 to COEFFICIENTS_IN_POLYNOMIAL / 8 - 1 {
            coefficients = #VPBROADCAST_8u32(encoded.[:u32 3 * i]);
            coefficients = #VPSRLV_8u32(coefficients, shifts);
            coefficients = #VPAND_256(coefficients, mask);
            coefficients = #VPSUB_8u32(eta, coefficients);
            polynomial.[:u256 32 * i] = coefficients;
        }

        shifts = ETA2_DECODING_SHIFTS[1];
        coefficients = #VPBROADCAST_8u32(encoded.[:u32 ENCODED_ERROR_POLYNOMIAL_SIZE - 4]);
        coefficients = #VPSRLV_8u32(coefficients, shifts);
        coefficients = #VPAND_256(coefficients, mask);
        coefficients = #VPSUB_8u32(eta, coefficients);
        polynomial.[:u256 4 * COEFFICIENTS_IN_POLYNOMIAL - 32] = coefficients;

        return polynomial;
    }

    // The encoding of an error polynomial: 3 bits per coefficient when
    // ETA = 2, 4 bits when ETA = 4.
    #[safety =
       { requires = is_arr_init(polynomial,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       , ensures = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       }
     ]
    inline
    fn encode(
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE]
    {
        if (ETA == 2) {
            encoded = encode_eta2(encoded, polynomial);
        } else {
            encoded = encode_eta4(encoded, polynomial);
        }
        return encoded;
    }

    #[safety =
       { requires = is_arr_init(encoded,0,ENCODED_ERROR_POLYNOMIAL_SIZE)
       , ensures = is_arr_init(decoded,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn decode(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] decoded,
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        if (ETA == 2) {
            decoded = decode_eta2(decoded, encoded);
        } else {
            decoded = decode_eta4(decoded, encoded);
        }
        return decoded;
    }
}
