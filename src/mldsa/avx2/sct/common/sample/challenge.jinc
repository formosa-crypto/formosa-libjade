namespace sample {
    #[safety =
       { requires = is_arr_init(seed,0,COMMITMENT_HASH_SIZE)
       , ensures = is_arr_init(output_challenge,0,4 * COEFFICIENTS_IN_POLYNOMIAL)
       }
     ]
    inline
    fn __challenge(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] output_challenge,
        reg ptr u8[COMMITMENT_HASH_SIZE] seed
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        stack shake256_state state;
        stack u8[136] xof_block;
        reg u256 zeros_256 = #set0_256();

        reg u64 i;
        reg u64 sample_at;
        reg u64 signs xof_offset;
        reg u32 coefficient shift;
        reg bool condition_loop condition_refill condition_resample;
        #[msf] reg u64 ms;

        i = 0;
        while(i < BYTES_PER_UNCOMPRESSED_POLYNOMIAL) {
            output_challenge.[:u256 i] = zeros_256;
            i += 32;
        }

        () = #spill(output_challenge);
        state = shake256_absorb_commitment_hash(state, seed);
        state, xof_block = shake256_squeezeblock(state, xof_block);
        () = #unspill(output_challenge);

        signs = xof_block.[:u64 0];
        xof_offset = 8;

        ms = #init_msf();

        i = COEFFICIENTS_IN_POLYNOMIAL - ONES_IN_VERIFIER_CHALLENGE;
        while { condition_loop = i < COEFFICIENTS_IN_POLYNOMIAL; } (condition_loop) {
            ms = #update_msf(condition_loop, ms);
            while {
                condition_refill = xof_offset >= SHAKE256_RATE;
                if(condition_refill) {
                    () = #spill(i, signs, output_challenge);
                    state, xof_block = shake256_squeezeblock(state, xof_block);
                    () = #unspill(i, signs, output_challenge);
                    xof_offset = 0;
                    ms = #init_msf();
                } else {
                    ms = #update_msf(!condition_refill, ms);
                }
                sample_at = (64u) xof_block[xof_offset];
                // Model item (signing): the SampleInBall leakage, the bytes
                // read as positions. A public function of the seed (the
                // declassified c~ when signing, the signature when
                // verifying), but the checker types xof_block secret: an
                // array is typed from its uninitialised content joined with
                // its writes (here, and in the Keccak state of the SHAKE256
                // wrappers).
                () = #declassify(sample_at);
                sample_at = #protect(sample_at, ms);

                xof_offset += 1;
                condition_resample = sample_at > i;
            } (condition_resample) {
                ms = #update_msf(condition_resample, ms);
            }
            ms = #update_msf(!condition_resample, ms);

            coefficient = output_challenge[sample_at];
            output_challenge[i] = coefficient;

            // output_challenge[sample_at] = 1 - 2 * (signs & 1);
            shift = (32u)signs;
            shift &= 1;
            shift <<= 1;

            coefficient = 1;
            coefficient -= shift;

            output_challenge[sample_at] = coefficient;

            signs >>= 1;

            i += 1;
        }

        return output_challenge;
    }
}
