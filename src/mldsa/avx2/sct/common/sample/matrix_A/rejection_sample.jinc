// VPERMQ(_, 0b10_01_01_00) puts the bytes 0..15 of the input in the low
// lane and its bytes 8..23 in the high one: each lane then holds the 12
// bytes of 4 candidates, at offset 0 in the low lane, 4 in the high one.
u256[2] DECODING_TABLE = {
    (32u8)[-1, 15, 14, 13, -1, 12, 11, 10,
           -1,  9,  8,  7, -1,  6,  5,  4,
           -1, 11, 10,  9, -1,  8,  7,  6,
           -1,  5,  4,  3, -1,  2,  1,  0],
    (8u32)[(1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1,
           (1 << 23) - 1]
};

// Read in 32 bytes to fill up the YMM register, but we only use the first 24,
// since 24 bytes already give us 8 potential coefficients. The constants are
// DECODING_TABLE, loaded once by the caller.
inline
fn __bytestream_to_potential_coefficients(
    reg u256 bytestream,
    reg u256 byte_shuffle,
    reg u256 coefficient_mask
) -> reg u256 {
    reg u256 coefficients;

    coefficients = #VPERMQ(bytestream, 0b10_01_01_00);
    coefficients = #VPSHUFB_256(coefficients, byte_shuffle);
    coefficients = #VPAND_256(coefficients, coefficient_mask);

    return coefficients;
}

#[safety =
   { requires = is_arr_init(randombytes,0,REJECTION_SAMPLE_INPUT_SIZE)
   , ensures = is_arr_init(polynomial,0,4 * filled) && filled <= COEFFICIENTS_IN_POLYNOMIAL
   }
 ]
fn rejection_sample_multiple_blocks(
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
    reg ptr u8[REJECTION_SAMPLE_INPUT_SIZE] randombytes
) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL],
     reg u64
{
    reg u256 modulus potential_coefficients compare_with_field_modulus;
    reg u256 permd_lanes byte_shuffle coefficient_mask;
    reg u128 permd_indices;
    reg ptr u8[2048] compaction_index_table;

    reg u64 input_offset;
    reg u64 good;
    reg u64 filled bytes_filled;

    reg u64 stop_sampling;

    reg u32 byte0 byte1 byte2;
    reg u32 coeff;
    reg u32 good_bytes good32 lane_signs;

    reg bool condition_loop condition;
    #[msf] reg u64 ms;

    ms = #init_msf();

    compaction_index_table = COMPACTION_INDEX_TABLE;
    lane_signs = 0x88888888;

    bytes_filled = 0;
    input_offset = 0;

    modulus = MODULUS_VECTOR;
    byte_shuffle = DECODING_TABLE[0];
    coefficient_mask = DECODING_TABLE[1];

    // Each block of 24 bytes gives at most 8 coefficients, so the first
    // COEFFICIENTS_IN_POLYNOMIAL / 8 blocks never overflow the polynomial: the
    // loop branches on the input offset only. The misspeculation flag then
    // does not depend on the number of accepted coefficients, and neither
    // does its protection of the mask: the iterations do not wait on each
    // other.
    while { condition_loop = input_offset < VECTOR_SAMPLING_BYTES; } (condition_loop) {
        ms = #update_msf(condition_loop, ms);
        potential_coefficients = randombytes.[:u256 input_offset];
        potential_coefficients = __bytestream_to_potential_coefficients(
            potential_coefficients, byte_shuffle, coefficient_mask);
        input_offset += 24;

        // The byte mask of the comparison (MOVEMASK_32u8 is DOIT,
        // MOVEMASK_8u32 is not); PEXT keeps the sign of the top byte of each
        // lane, which gives the mask of MOVEMASK_8u32.
        compare_with_field_modulus = #VPCMPGT_8u32(modulus, potential_coefficients);
        good_bytes = #MOVEMASK_32u8(compare_with_field_modulus);
        // Model item: the candidates of ExpandA (cands_leak); this mask, the
        // outcome of the rejection test of 8 candidates, is a function of them.
        () = #declassify(good_bytes);
        good_bytes = #protect_32(good_bytes, ms);
        good32 = #PEXT_32(good_bytes, lane_signs);
        good = (64u)good32;

        // Pack the accepted lanes to the front with one VPERMD, whose index
        // vector is the row of the mask in COMPACTION_INDEX_TABLE widened to
        // 32-bit lanes, and store all 8 lanes: the ones past the accepted
        // candidates lie past the filled coefficients, the next block
        // overwrites them.
        permd_indices = (128u)compaction_index_table.[:u64 8 * good];
        permd_lanes = #VPMOVZX_8u8_8u32(permd_indices);
        potential_coefficients = #VPERMD(permd_lanes, potential_coefficients);
        polynomial.[:u256 bytes_filled] = potential_coefficients;

        _, _, _, _, _, good = #POPCNT_64(good);
        good <<= 2;
        bytes_filled += good;
    }
    ms = #update_msf(!condition_loop, ms);

    filled = bytes_filled;
    filled >>= 2;

    stop_sampling = 1;
    condition = filled < COEFFICIENTS_IN_POLYNOMIAL;
    if (condition) {
        ms = #update_msf(condition, ms);
        condition = input_offset < REJECTION_SAMPLING_BYTES - 2;
        if (condition) {
            ms = #update_msf(condition, ms);
            stop_sampling = 0;
        } else {
            ms = #update_msf(!condition, ms);
        }
    } else {
        ms = #update_msf(!condition, ms);
    }

    while { condition_loop = stop_sampling != 1; } (condition_loop) {
        ms = #update_msf(condition_loop, ms);
        byte0 = (32u)randombytes[input_offset];
        input_offset += 1;

        byte1 = (32u)randombytes[input_offset];
        input_offset += 1;

        byte2 = (32u)randombytes[input_offset];
        input_offset += 1;

        coeff = byte0;
        byte1 <<= 8;
        coeff |= byte1;
        byte2 <<= 16;
        coeff |= byte2;

        // Rejection-sample
        coeff &= 0x7F_FF_FF;
        // Model item: a candidate of ExpandA (cands_leak).
        () = #declassify(coeff);
        coeff = #protect_32(coeff, ms);
        condition = coeff < MODULUS;
        if (condition) {
            ms = #update_msf(condition, ms);
            polynomial[filled] = coeff;
            filled += 1;
        } else {
            ms = #update_msf(!condition, ms);
        }

        stop_sampling = 0;
        condition = filled >= COEFFICIENTS_IN_POLYNOMIAL;
        if (condition) {
            ms = #update_msf(condition, ms);
            stop_sampling = 1;
        } else {
            ms = #update_msf(!condition, ms);
            condition = input_offset >= REJECTION_SAMPLING_BYTES - 2;
            if (condition) {
                ms = #update_msf(condition, ms);
                stop_sampling = 1;
            } else {
                ms = #update_msf(!condition, ms);
            }
        }
    }

    return polynomial, filled;
}

#[safety =
   { requires = is_arr_init(block,0,SHAKE128_RATE)
             && is_arr_init(polynomial,0,4 * filled)
             && filled <= COEFFICIENTS_IN_POLYNOMIAL
   , ensures = is_arr_init(polynomial,0,4 * filled) && filled <= COEFFICIENTS_IN_POLYNOMIAL
   }
 ]
fn rejection_sample_one_block(
    reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
    reg u64 filled,
    reg ptr u8[SHAKE128_RATE] block
) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL],
     reg u64
{
    // Assume the XOF buffer is full.
    //
    // Extract until:
    //   * The polynomial buffer is full, or
    //   * The XOF buffer is empty.
    //
    // Note: This function relies on the fact that the amount of bytes
    // needed to sample a coefficient mod q (3 bytes) aligns with the
    // SHAKE128 rate (168 bytes).  That is why we don't have to stash
    // any bytes in some scratch space between calls.
    //

    reg u32 byte0 byte1 byte2;
    reg u8 stop_sampling;
    reg u32 coeff;
    reg u64 block_offset = 0;
    reg bool condition_loop condition;
    #[msf] reg u64 ms;

    ms = #init_msf();

    stop_sampling = 0;
    condition = filled >= COEFFICIENTS_IN_POLYNOMIAL;
    if (condition) {
        ms = #update_msf(condition, ms);
        stop_sampling = 1;
    } else {
        ms = #update_msf(!condition, ms);
    }

    while { condition_loop = stop_sampling != 1; } (condition_loop) {
        ms = #update_msf(condition_loop, ms);
        byte0 = (32u)block[block_offset];
        block_offset += 1;

        byte1 = (32u)block[block_offset];
        block_offset += 1;

        byte2 = (32u)block[block_offset];
        block_offset += 1;

        coeff = byte0;
        byte1 <<= 8;
        coeff |= byte1;
        byte2 <<= 16;
        coeff |= byte2;

        // Rejection-sample
        coeff &= 0x7F_FF_FF;
        // Model item: a candidate of ExpandA (cands_leak).
        () = #declassify(coeff);
        coeff = #protect_32(coeff, ms);
        condition = coeff < MODULUS;
        if (condition) {
            ms = #update_msf(condition, ms);
            polynomial[filled] = coeff;
            filled += 1;
        } else {
            ms = #update_msf(!condition, ms);
        }

        stop_sampling = 0;
        condition = filled >= COEFFICIENTS_IN_POLYNOMIAL;
        if (condition) {
            ms = #update_msf(condition, ms);
            stop_sampling = 1;
        } else {
            ms = #update_msf(!condition, ms);
            condition = block_offset >= SHAKE128_RATE;
            if (condition) {
                ms = #update_msf(condition, ms);
                stop_sampling = 1;
            } else {
                ms = #update_msf(!condition, ms);
            }
        }
    }

    return polynomial, filled;
}
