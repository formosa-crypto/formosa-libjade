from Hash require "hmac_mem.jinc"
from Hash require "context.jinc"

#[ct = "secret × public × public × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen) && is_mem_init((64u) msg, (64u) msglen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 64)
   }
 ]
export fn jade_mac_hmac_sha512_amd64_avx2(reg mut ptr u8[64] out, reg u64 key keylen msg msglen) -> reg ptr u8[64]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _hmac_sha512_mem(out, key, keylen, msg, msglen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen)
   , res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA512_CTX_BYTES)
   }
 ]
export fn jade_mac_hmac_sha512_amd64_avx2_init(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg u64 key keylen)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES]
{
  reg u64 ms;

  ms = #init_msf();

  ctx, ms = __hmac_sha512_ctx_init(ctx, key, keylen, ms);

  return ctx;
}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA512_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA512_CTX_BYTES)
   }
 ]
export fn jade_mac_hmac_sha512_amd64_avx2_update(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg u64 in inlen)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();

  expect = __sha2_tag(SHA2_FN_HMAC_SHA512);
  ctx[0:SHA512_CTX_BYTES], status, ms =
    _sha512_ctx_update(ctx[0:SHA512_CTX_BYTES], in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA512_CTX_BYTES)
   , res = { ctx_out, out_out, status }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA512_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 64 : 0)
   }
 ]
export fn jade_mac_hmac_sha512_amd64_avx2_final(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg mut ptr u8[64] out)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg ptr u8[64], reg u64
{
  reg u64 ms status;

  ms = #init_msf();

  ctx, out, status, ms = __hmac_sha512_ctx_final(ctx, out, ms);

  return ctx, out, status;
}
