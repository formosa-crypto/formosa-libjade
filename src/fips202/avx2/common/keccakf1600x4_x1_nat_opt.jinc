  y15 = y14 ^ y10; // vpxor %ymm10, %ymm14, %ymm15
  y14 = #VPSRL_4u64(y2, (128u) 0x32); // vpsrlq $0x32, %ymm2, %ymm14       // 50
  y2 = #VPSLL_4u64(y2, (128u) 0xe); // vpsllq $0xe, %ymm2, %ymm2         // 14
