/*
 A four-way and a one-way Keccak-f[1600] permutation interleaved, for a
 one-way sponge that runs alongside a four-way one: a round of the four-way
 permutation (keccakf1600x4_nat.jinc) before each of the two rounds of an
 iteration of the one-way one (keccakf1600_opt.jinc), so that the
 out-of-order core overlaps the vector and the integer work.

 The rounds are copies of those of the two permutations, with the states on
 the stack: the four-way round addresses its constants as globals, and the
 one-way rounds keep every general-purpose register (the subroutine copies
 both states into its frame and back).
*/
from Keccak require "common/keccakf1600_generic.jinc"
from Keccak require "common/keccakf1600x4_generic.jinc"
from Keccak require "avx2/common/keccakf1600x4_nat.jinc"
from Keccak require "ref/common/keccakf1600_opt.jinc"

// one round of keccakf1600x4_nat.jinc (__f1600_loopbody_native), on a stack state
#[safety =
   { requires = is_arr_init(st,0,800) && 0 <= i && i < 24
   , res = { f_st, f_y10, f_y14, f_y8, f_y15, f_y9, f_y13, f_y3, f_y7, f_y2 }
   , ensures = is_arr_init(f_st,0,800) }
 ]
inline fn __f1600_x4_round
( stack u256[25] st
, reg ui64 i
, reg u256 y10 y14 y8 y15 y9 y13 y3 y7 y2
) -> stack u256[25]
   , reg u256, reg u256, reg u256, reg u256, reg u256
   , reg u256, reg u256, reg u256, reg u256
{
  reg u256 y0, y1, y4, y5, y6, y11, y12;
  reg ptr u64[24] rcp;
  inline int i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12;
  inline int i13, i14, i15, i16, i17, i18, i19, i20, i21, i22, i23;
  i0=0; i1=1; i2=2; i3=3; i4=4; i5=5; i6=6;
  i7=9; i8=10; i9=13; i10=14; i11=16; i12=17; i13=19; i14=20; i15=23;
  i16=7; i17=8; i18=11; i19=12; i20= 15; i21= 18; i22= 21; i23= 22;
  //LLkeccak_f1600_x4_avx2:    
  y4 = st[i5]; // vmovdqu 0xa0(%rsp), %ymm4         // 160 [5]
  y0 = y9 ^ st[i14]; // vpxor 0x1c0(%rsp), %ymm9, %ymm0   // 448 [14]
  st[i16] = y9; // vmovdqu %ymm9, 0x200(%rsp)        // 512 [16]
  y9 = y10; // vmovdqu %ymm10, %ymm9
  y11 = st[i6]; // vmovdqu 0xc0(%rsp), %ymm11        // 192 [6]
  y12 = st[i11]; // vmovdqu 0x160(%rsp), %ymm12       // 352 [11]
  st[i18] = y3; // vmovdqu %ymm3, 0x240(%rsp)        // 576 [18]
  y1 = y4 ^ st[i8]; // vpxor 0x100(%rsp), %ymm4, %ymm1   // 256 [8]
  y10 = st[i2]; // vmovdqu 0x40(%rsp), %ymm10        // 64  [2]
  st[i17] = y4; // vmovdqu %ymm4, 0x220(%rsp)        // 544 [17]
  y12 = y12 ^ y3; // vpxor %ymm3, %ymm12, %ymm12
  y6 = st[i1]; // vmovdqu 0x20(%rsp), %ymm6         // 32  [1]
  y4 = st[i10]; // vmovdqu 0x140(%rsp), %ymm4        // 320 [10]
  st[i21] = y14; // vmovdqu %ymm14, 0x2a0(%rsp)       // 672 [21]
  y0 = y0 ^ y1; // vpxor %ymm1, %ymm0, %ymm0
  y1 = y11 ^ y8; // vpxor %ymm8, %ymm11, %ymm1
  y11 = y7 ^ st[i12]; // vpxor 0x180(%rsp), %ymm7, %ymm11  // 384 [12]
  st[i20] = y10; // vmovdqu %ymm10, 0x280(%rsp)       // 640 [20]
  y12 = y12 ^ y1; // vpxor %ymm1, %ymm12, %ymm12
  y1 = y9 ^ y15; // vpxor %ymm15, %ymm9, %ymm1
  y3 = st[i7]; // vmovdqu 0xe0(%rsp), %ymm3         // 224 [7]
  st[i19] = y8; // vmovdqu %ymm8, 0x260(%rsp)        // 608 [19]
  y11 = y11 ^ y1; // vpxor %ymm1, %ymm11, %ymm11
  y1 = y14 ^ st[i9]; // vpxor 0x120(%rsp), %ymm14, %ymm1  // 288 [9]
  y12 = y12 ^ y6; // vpxor %ymm6, %ymm12, %ymm12
  y8 = st[i3]; // vmovdqu 0x60(%rsp), %ymm8         // 96  [3]
  y11 = y11 ^ y10; // vpxor %ymm10, %ymm11, %ymm11
  y10 = y13 ^ st[i15]; // vpxor 0x1e0(%rsp), %ymm13, %ymm10 // 480 [15]
  y3 = y3 ^ y4; // vpxor %ymm4, %ymm3, %ymm3
  st[i22] = y4; // vmovdqu %ymm4, 0x2c0(%rsp)        // 704 [22]
  y4 = #VPSRL_4u64(y12, (128u) 0x3f); // vpsrlq $0x3f, %ymm12, %ymm4       // 63
  y5 = #VPSRL_4u64(y11, (128u) 0x3f); // vpsrlq $0x3f, %ymm11, %ymm5       // 63
  y0 = y0 ^ st[i0]; // vpxor (%rsp), %ymm0, %ymm0
