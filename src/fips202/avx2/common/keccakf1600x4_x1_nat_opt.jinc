  y2 = #VPSRL_4u64(y5, (128u) 0x2); // vpsrlq $0x2, %ymm5, %ymm2         // 2
  y5 = #VPSLL_4u64(y5, (128u) 0x3e); // vpsllq $0x3e, %ymm5, %ymm5        // 62
