  y1 = st[i4]; // vmovdqu 0x80(%rsp), %ymm1         // 128 [4]
  y10 = y10 ^ y8; // vpxor %ymm8, %ymm10, %ymm10
  y14 = y1; // vmovdqu %ymm1, %ymm14
  y1 = y2 ^ st[i13]; // vpxor 0x1a0(%rsp), %ymm2, %ymm1   // 416 [13]
  st[i23] = y14; // vmovdqu %ymm14, 0x2e0(%rsp)       // 736 [23]
