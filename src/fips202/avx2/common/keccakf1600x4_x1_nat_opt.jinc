  y4 = #VPSLL_4u64(y11, (128u) 0x01); // vpsllq $0x1, %ymm11, %ymm4        // 1
  y1 = y1 ^ y14; // vpxor %ymm14, %ymm1, %ymm1
  y4 = y4 | y5; // vpor %ymm5, %ymm4, %ymm4
  y14 = #VPSRL_4u64(y10, (128u) 0x3f); // vpsrlq $0x3f, %ymm10, %ymm14      // 63
