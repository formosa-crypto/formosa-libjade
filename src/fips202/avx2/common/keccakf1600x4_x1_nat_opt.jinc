  y7 = y5 ^ y7; // vpxor %ymm7, %ymm5, %ymm7
  y9 = y5 ^ y9; // vpxor %ymm9, %ymm5, %ymm9
  y1 = y1 | y12; // vpor %ymm12, %ymm1, %ymm1
  y12 = y3 ^ st[i0]; // vpxor (%rsp), %ymm3, %ymm12       // 0   [0]
  y1 = y1 ^ y11; // vpxor %ymm11, %ymm1, %ymm1
  y11 = #VPSRL_4u64(y0, (128u) 0x3f); // vpsrlq $0x3f, %ymm0, %ymm11       // 63
  y0 = #VPSLL_4u64(y0, (128u) 0x01); // vpsllq $0x1, %ymm0, %ymm0         // 1
  y13 = y1 ^ y13; // vpxor %ymm13, %ymm1, %ymm13
  y8 = y1 ^ y8; // vpxor %ymm8, %ymm1, %ymm8
  y0 = y0 | y11; // vpor %ymm11, %ymm0, %ymm0
  y0 = y0 ^ y10; // vpxor %ymm10, %ymm0, %ymm0
  y10 = y4 ^ st[i6]; // vpxor 0xc0(%rsp), %ymm4, %ymm10   // 192 [6]
  y2 = y0 ^ y2; // vpxor %ymm2, %ymm0, %ymm2
  y11 = #VPSRL_4u64(y10, (128u) 0x14); // vpsrlq $0x14, %ymm10, %ymm11      // 20
  y10 = #VPSLL_4u64(y10, (128u) 0x2c); // vpsllq $0x2c, %ymm10, %ymm10      // 44
  y10 = y10 | y11; // vpor %ymm11, %ymm10, %ymm10
  y11 = y5 ^ y15; // vpxor %ymm15, %ymm5, %ymm11
  rcp = KECCAK1600_RC;
  y15 = #VPBROADCAST_4u64(rcp[(64u)i]); // vpbroadcastq (%rsi), %ymm15
  y14 = #VPSRL_4u64(y11, (128u) 0x15); // vpsrlq $0x15, %ymm11, %ymm14      // 21
  y11 = #VPSLL_4u64(y11, (128u) 0x2b); // vpsllq $0x2b, %ymm11, %ymm11      // 43
  y11 = y11 | y14; // vpor %ymm14, %ymm11, %ymm11
  y14 = !y10 & y11; //#VPANDN_256(y10, y11); // vpandn %ymm11, %ymm10, %ymm14
  y14 = y14 ^ y15; // vpxor %ymm15, %ymm14, %ymm14
  y15 = y14 ^ y12; // vpxor %ymm12, %ymm14, %ymm15
  y14 = #VPSRL_4u64(y13, (128u) 0x2b); // vpsrlq $0x2b, %ymm13, %ymm14      // 32
  y13 = #VPSLL_4u64(y13, (128u) 0x15); // vpsllq $0x15, %ymm13, %ymm13      // 21
  st[i0] = y15; // vmovdqu %ymm15, (%rsp)            // 0   [0]
  y13 = y13 | y14; // vpor %ymm14, %ymm13, %ymm13
