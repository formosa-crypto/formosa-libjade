  y8 = #VPSLL_4u64(y8, (128u) 0x1c); // vpsllq $0x1c, %ymm8, %ymm8        // 28
  st[i4] = y11; // vmovdqu %ymm11, 0x80(%rsp)        // 128 [4]
  y8 = y8 | y2; // vpor %ymm2, %ymm8, %ymm8
  y2 = y0 ^ st[i7]; // vpxor 0xe0(%rsp), %ymm0, %ymm2    // 224 [7]
  y10 = #VPSRL_4u64(y2, (128u) 0x2c); // vpsrlq $0x2c, %ymm2, %ymm10       // 44
  y2 = #VPSLL_4u64(y2, (128u) 0x14); // vpsllq $0x14, %ymm2, %ymm2        // 20
  y2 = y2 | y10; // vpor %ymm10, %ymm2, %ymm2
  y10 = y3 ^ st[i8]; // vpxor 0x100(%rsp), %ymm3, %ymm10  // 256 [8]
  y11 = #VPSRL_4u64(y10, (128u) 0x3d); // vpsrlq $0x3d, %ymm10, %ymm11      // 61
  y10 = #VPSLL_4u64(y10, (128u) 0x3); // vpsllq $0x3, %ymm10, %ymm10       // 3
  y10 = y10 | y11; // vpor %ymm11, %ymm10, %ymm10
  y11 = !y2 & y10; //#VPANDN_256(y2, y10); // vpandn %ymm10, %ymm2, %ymm11
  y11 = y11 ^ y8; // vpxor %ymm8, %ymm11, %ymm11
  st[i5] = y11; // vmovdqu %ymm11, 0xa0(%rsp)        // 160 [5]
  y11 = y4 ^ st[i11]; // vpxor 0x160(%rsp), %ymm4, %ymm11  // 352 [11]
