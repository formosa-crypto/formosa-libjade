require "keccak1600_updstate.jinc"

export fn keccak_ststatus
( reg mut ptr u8[3] status
, reg const ptr keccak_updstate st
) -> reg ptr u8[3]
{
  reg ui64 r8 at;
  reg u64 ststatus;
  ststatus = st[25];
  () = #declassify(ststatus);
  _, r8, at = _ststatus_data(ststatus);
  status[0] = (8u) (64u) r8;
  status[1] = (8u) (64u) at;
  status[2] = st.[:u8 8*25+2];
  return status;
}

export fn init_updstate_avx2
( reg mut ptr keccak_updstate st
, reg ui8 r64
, reg u8 trailb
) -> reg ptr keccak_updstate
{
  st = st;
  r64 = r64;
  trailb = trailb;
  st = _init_updstate_avx2(st, r64, trailb);
  return st;
}

export fn finish_updstate_avx2
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  st = _finish_updstate_avx2(st);
  return st;
}

export fn absorb_m_updstate_avx2
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  buf = buf;
  st = _absorb_m_updstate_avx2(st, buf, len);
  return st;
}

export fn squeeze_m_updstate_avx2
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  buf = buf;
  _, st = _squeeze_m_updstate_avx2(buf, len, st);
  return st;
}
