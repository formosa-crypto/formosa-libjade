/*
  Jasmin Keccak Code Package (JKCP) -- C-ABI exports.

  One-shot and incremental FIPS 202 functions built on top of the
  memory-based updstate interface (ref/common/keccak1600_updstate.jinc).

  One-shot:
    sha3_224(out, in, inlen)
    sha3_256(out, in, inlen)
    sha3_384(out, in, inlen)
    sha3_512(out, in, inlen)
    shake128(out, outlen, in, inlen)
    shake256(out, outlen, in, inlen)

  Incremental:
    sha3_{224,256,384,512}_init(st)   -- per-variant init
    shake{128,256}_init(st)
    keccak_absorb(st, data, len)      -- generic, works for all variants
    keccak_squeeze(st, out, len)      -- the first call also finishes

  State type: keccak_updstate (u64[26], 208 bytes).  Its trail byte is
  nonzero while absorbing and zero once finished, so keccak_squeeze knows
  whether to finish first.

  Speculative constant time: the state, the input and the output are
  secret; pointers and lengths are public.  The exports that take the state
  start with #init_msf (an LFENCE), as their pointer argument is transient;
  the one-shot functions keep the state on the stack, and the updstate
  procedures fence after reading the status word.
*/

from Keccak require "common/keccak1600_default.jinc"
from Keccak require "ref/common/keccak1600_updstate.jinc"


/* =====================================================================
   One-shot SHA-3
   ===================================================================== */

inline fn __sha3
( #[spill_to_mmx] reg ui64 out
, reg ui64 inp
, reg ui64 inlen
, inline int _RATE64
, inline int _OUTLEN
)
{
  stack keccak_updstate _st;
  reg mut ptr keccak_updstate st;
  reg ui8 r64;
  reg u8 trailb;
  reg ui64 olen;

  st = _st;
  r64 = _RATE64;
  trailb = SHA3;
  st = _init_updstate(st, r64, trailb);
  () = #spill(out);
  st = _absorb_m_updstate(st, inp, inlen);
  st = _finish_updstate(st);
  () = #unspill(out);
  olen = _OUTLEN;
  st = _squeeze_m_updstate(st, out, olen);
}

#[sct="transient * transient * transient -> ()"]
export fn sha3_224
( reg ui64 out
, reg ui64 inp
, reg ui64 inlen
)
{
  __sha3(out, inp, inlen, R144/8, 28);
}

#[sct="transient * transient * transient -> ()"]
export fn sha3_256
( reg ui64 out
, reg ui64 inp
, reg ui64 inlen
)
{
  __sha3(out, inp, inlen, R136/8, 32);
}

#[sct="transient * transient * transient -> ()"]
export fn sha3_384
( reg ui64 out
, reg ui64 inp
, reg ui64 inlen
)
{
  __sha3(out, inp, inlen, R104/8, 48);
}

#[sct="transient * transient * transient -> ()"]
export fn sha3_512
( reg ui64 out
, reg ui64 inp
, reg ui64 inlen
)
{
  __sha3(out, inp, inlen, R72/8, 64);
}


/* =====================================================================
   One-shot SHAKE
   ===================================================================== */

inline fn __shake
( #[spill_to_mmx] reg ui64 out
, #[spill_to_mmx] reg ui64 outlen
, reg ui64 inp
, reg ui64 inlen
, inline int _RATE64
)
{
  stack keccak_updstate _st;
  reg mut ptr keccak_updstate st;
  reg ui8 r64;
  reg u8 trailb;

  st = _st;
  r64 = _RATE64;
  trailb = SHAKE;
  st = _init_updstate(st, r64, trailb);
  () = #spill(out, outlen);
  st = _absorb_m_updstate(st, inp, inlen);
  st = _finish_updstate(st);
  () = #unspill(out, outlen);
  st = _squeeze_m_updstate(st, out, outlen);
}

#[sct="transient * transient * transient * transient -> ()"]
export fn shake128
( reg ui64 out
, reg ui64 outlen
, reg ui64 inp
, reg ui64 inlen
)
{
  __shake(out, outlen, inp, inlen, R168/8);
}

#[sct="transient * transient * transient * transient -> ()"]
export fn shake256
( reg ui64 out
, reg ui64 outlen
, reg ui64 inp
, reg ui64 inlen
)
{
  __shake(out, outlen, inp, inlen, R136/8);
}


/* =====================================================================
   Incremental: per-variant init
   ===================================================================== */

inline fn __keccak_init
( reg mut ptr keccak_updstate st
, inline int _RATE64
, inline int _TRAILB
) -> reg ptr keccak_updstate
{
  reg ui8 r64;
  reg u8 trailb;

  r64 = _RATE64;
  trailb = _TRAILB;
  st = _init_updstate(st, r64, trailb);
  return st;
}

#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn sha3_224_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R144/8, SHA3);
  return st;
}

#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn sha3_256_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R136/8, SHA3);
  return st;
}

#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn sha3_384_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R104/8, SHA3);
  return st;
}

#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn sha3_512_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R72/8, SHA3);
  return st;
