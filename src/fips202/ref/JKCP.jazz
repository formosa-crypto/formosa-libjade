#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn shake128_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R168/8, SHAKE);
  return st;
}

#[sct="{ptr: transient, val: secret} -> {ptr: transient, val: secret}"]
export fn shake256_init
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  st = __keccak_init(st, R136/8, SHAKE);
  return st;
}


/* =====================================================================
   Incremental: absorb / squeeze
   ===================================================================== */

#[sct="{ptr: transient, val: secret} * transient * transient -> {ptr: transient, val: secret}"]
export fn keccak_absorb
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate
{
  _ = #init_msf();
  st = st;
  buf = buf;
  st = _absorb_m_updstate(st, buf, len);
  return st;
}

/* The first squeeze finishes the absorption: the trail byte, nonzero until
   then, is cleared by _finish_updstate.  The status word depends only on the
   rate, the trail byte and the lengths, so it is declassified.
   A zero-length squeeze must not reach _squeeze_m_updstate: at a block
   boundary it would permute the state and skip a block of output. */
#[sct="{ptr: transient, val: secret} * transient * transient -> {ptr: transient, val: secret}"]
export fn keccak_squeeze
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate
{
  reg u64 ststatus;
  #[msf] reg u64 ms;
  reg u8 trailb;
  reg bool nonempty;

  ms = #init_msf();
  st = st;
  buf = buf;
  nonempty = len > 0;
  if (nonempty) {
    ms = #update_msf(nonempty, ms);
    ststatus = st[25];
    () = #declassify(ststatus); // public status word: rate, trail byte, lengths
    ststatus = #protect(ststatus, ms);
    ststatus >>= 16;
    trailb = (8u) ststatus;
    if (trailb != 0) {
      st = _finish_updstate(st);
    }
    st = _squeeze_m_updstate(st, buf, len);
  }
  return st;
}
