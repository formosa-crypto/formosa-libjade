require "keccak1600_updstate_ASIZE.jinc"

#[safety =
   { requires = is_arr_init(st,0,208) && 0 <= len && len <= _ASIZE && len <= 0xFFFFFFFFFFFFFF00 && is_arr_init(buf,0,len)
   , ensures = is_arr_init(st,0,208) }
 ]
export fn absorb_updstate
( reg mut ptr keccak_updstate st
, reg const ptr u8[_ASIZE] buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  buf = buf;
  len = len;
  st = _absorb_updstate(st, buf, len);
  return st;
}

#[safety =
   { requires = is_arr_init(st,0,208) && 0 <= len && len <= _ASIZE && len <= 0xFFFFFFFFFFFFFF00
   , res = { final_st, final_buf }
   , ensures = is_arr_init(final_st,0,208) && is_arr_init(final_buf,0,len) }
 ]
export fn squeeze_updstate
( reg mut ptr keccak_updstate st
, reg mut ptr u8[_ASIZE] buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
   , reg ptr u8[_ASIZE]      /* buf */
{
  st = st;
  buf = buf;
  len = len;
  st, buf = _squeeze_updstate(st, buf, len);
  return st, buf;
}
