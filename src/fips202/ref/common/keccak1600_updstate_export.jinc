require "keccak1600_updstate.jinc"

#[safety =
   { requires = is_arr_init(st,0,208)
   , ensures = is_arr_init(status,0,3) }
 ]
export fn ststatus_updstate
( reg mut ptr u8[3] status
, reg const ptr keccak_updstate st
) -> reg ptr u8[3]
{
  reg ui64 r8 at;
  reg u64 ststatus;
  ststatus = st[25];
  _, r8, at = _ststatus_data(ststatus);
  status[0] = (8u) (64u) r8;
  status[1] = (8u) (64u) at;
  status[2] = st.[:u8 8*25+2];
  return status;
}

#[safety =
   { ensures = is_arr_init(st,0,208) }
 ]
export fn init_updstate
( reg mut ptr keccak_updstate st
, reg ui8 r64
, reg u8 trailb
) -> reg ptr keccak_updstate
{
  st = st;
  r64 = r64;
  trailb = trailb;
  st = _init_updstate(st, r64, trailb);
  return st;
}

export fn finish_updstate
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  st = _finish_updstate(st);
  return st;
}

#[safety =
   { requires = is_arr_init(st,0,208) && is_mem_init((64u) buf, len) && len <= 0xFFFFFFFFFFFFFF00
   , ensures = is_arr_init(st,0,208) }
 ]
export fn absorb_m_updstate
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  buf = buf;
  st = _absorb_m_updstate(st, buf, len);
  return st;
}

#[safety =
   { requires = is_arr_init(st,0,208) && is_mem_init((64u) buf, len) && len <= 0xFFFFFFFFFFFFFF00
   , ensures = is_arr_init(st,0,208) }
 ]
export fn squeeze_m_updstate
( reg mut ptr keccak_updstate st
, reg ui64 buf
, reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  st = st;
  buf = buf;
  st = _squeeze_m_updstate(st, buf, len);
  return st;
}
