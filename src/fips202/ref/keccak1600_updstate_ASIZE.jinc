/** IMPORTANT!
  this file shoould be in sync with its array counterpart (keccak1600_updstate_ASIZE.jinc)
*/
/**************************************************************************** 

   DEPENDENCIES:
   =============

param int KECCAK_FEATURES
param int KECCAK_PERMUTATION

require "keccakf1600.jinc"
require "keccak1600.jinc"


(e.g.
param int KECCAK_FEATURES
 = KECCAK_FEATURE_AVX2 | KECCAK_FEATURE_BMI | KECCAK_FEATURE_BMI2;
param int KECCAK_PERMUTATION = KECCAK_F1600_OPT;
)

OBS: the generated code is independent of the parameter _ASIZE, but the
 instance cannot be avoided due to typechecking!!! :-(

*****************************************************************************/

from Keccak require "common/subreadwrite_ASIZE.jinc"

fn _add_updstate
( reg mut ptr keccak_state st
, reg ui64 at               // 0 <= at < 200
, reg const ptr u8[_ASIZE] buf // at+_ASIZE <= 200 (in fact, r8...)
, reg ui64 off    // off + upto - at <= _ASIZE
, reg ui64 upto    // at <= upto <= 200 (in fact, r8...)
) -> reg ptr keccak_state /* st */
   , reg ui64             /* at */
   , reg ui64             /* off */
{
  inline bool HAS_AVX2;
  reg u8 sh;
  reg u64 t64, at8, upto8;
  reg ui64 off2, newat, len;
  reg u256 t256;
  reg u128 t128;

  HAS_AVX2 = __HAS_FEATURE(KECCAK_FEATURE_AVX2, KECCAK_FEATURES);

  at8 = (64u) at;
  at8 &= 0x07; // byte position in stword

  if (at8 != 0) { // needs to fill first word...
    len = upto;
    len -= at; // len = upto-at (bytes to process)
    at >>= 3; at <<= 3; // at = 8*(at/8) (start of stword)
    off2, t64 = __a_rlen_read_upto8(buf, off, len);
    len = len + (64ui)at8; // bytes from the start of word
    sh = (8u) at8;
    sh <<= 3;   // bits to shift...
    t64 <<= (sh & 63);
    st.[at] ^= t64;
    if (len >= 8) { // need to proccess more stwords...
      off += 8;
      off -= (64ui) at8; // off += (8-at8)
      at += 8;    // start of next stword
    } else { // this is the only affected stword
      off = off2; // 
      at = upto;  // its done!
    }
  }

  // now: at%8==0 || at==upto
  newat = at;
  if ( HAS_AVX2 ) {
    while
      { newat += 32; }
    ( newat <= upto )
      {
        t256 = buf.[:u256 off];
        off += 32;
        t256 ^= st.[:u256 at];
        st.[:u256 at] = t256;
        at = newat;
      }
    newat -= 16;
    if ( newat <= upto ) {
      t128 = buf.[:u128 off];
      off += 16;
      t128 ^= st.[:u128 at];
      st.[:u128 at] = t128;
      at = newat;
    }
    newat = at;
    newat += 8;
    if ( newat <= upto ) {
      t64 = buf.[:u64 off];
      off += 8;
      st.[:u64 at] ^= t64;
      at = newat;
    }
  } else {
    while
      { newat += 8; }
    ( newat <= upto )
      {
        t64 = buf.[:u64 off];
        st.[:u64 at] ^= t64;
        at = newat;
        off += 8;
      }
  }

  // leftovers...
  if (at < upto) {
    upto8 = (64u) upto;
    upto8 &= 0x07;
    off, t64 = __a_rlen_read_upto8(buf, off, (64ui) upto8);
    st.[at] ^= t64;
  }
  
  at = upto;
  return st, at, off;
}

fn _absorb_updstate
( #[spill_to_mmx] reg mut ptr keccak_updstate st
, #[spill_to_mmx] reg const ptr u8[_ASIZE] buf
, #[spill_to_mmx] reg ui64 len
) -> reg ptr keccak_updstate /* st */
{
  inline int KECCAK_F;
  inline bool SPILL;
  reg u64 ststatus;
  #[spill_to_mmx] reg ui64 off, r8, at;
  reg ptr keccak_state stk;

  KECCAK_F = __KECCAK_F(KECCAK_PERMUTATION);
  SPILL = KECCAK_F != KECCAK_F1600_AVX2;

  ststatus = st[25];
  () = #declassify(ststatus);
  _ = #init_msf();
  _, r8, at = _ststatus_data(ststatus); // 0 < r8 < 200; r8 |% 8; 0 <= at <= r8
  stk = st[0:25];
  () = #spill(st);

  off = 0;
  len += at;
  while (r8 <= len) {
    stk, at, off = _add_updstate(stk, at, buf, off, r8);
    if (SPILL) {
      () = #spill(r8, at, len, off, buf);
      stk = _keccakf1600(stk);
      () = #unspill(r8, at, len, off, buf);
    } else {
      stk = _keccakf1600(stk);
    }
    len -= r8;
    at = 0;
  }
  len = len;
  () = #unspill(st);
  stk, at, _ = _add_updstate(stk, at, buf, off, len);
  st[0:25] = stk;
  st.[:u8 8*25] = (8u) (64u) at;

  return st;
}

fn _dump_updstate
( reg mut ptr u8[_ASIZE] buf
, reg ui64 off    // off + upto - at <= _ASIZE
, reg const ptr keccak_state st
, reg ui64 at     // at+_ASIZE <= r8
, reg ui64 upto   // at <= upto <= r8
) -> reg ptr u8[_ASIZE] /* buf */
   , reg ui64          /* off */
   , reg ui64          /* at */
{
  inline bool HAS_AVX2;
  reg ui64 newat, off2, len;
  reg u64 t64, at8, upto8;
  reg u8 sh;
  reg u256 t256;
  reg u128 t128;

  HAS_AVX2 = __HAS_FEATURE(KECCAK_FEATURE_AVX2, KECCAK_FEATURES);
  at8 = (64u) at;
  at8 &= 0x07; // byte position in stword

  if (at8 != 0) { // needs to dump remainder of first word...
    len = upto;
    len -= at; // len = upto-at (bytes to process)
    at >>= 3; at <<= 3; // at = 8*(at/8) (start of stword)
    t64 = st.[at];
    sh = (8u) at8;
    sh <<= 3;   // bits to shift...
    t64 >>= (sh & 63);
    buf, off2 = __a_rlen_write_upto8(buf, off, t64, len);
    len += (64ui) at8; // bytes from the start of word
    if (len >= 8) {  // need to proccess more stwords...
      off += 8;
      off -= (64ui) at8;
      at += 8;       // start of next stword
    } else {         // this is the only affected stword
      off = off2;
      at = upto;     // its done!
    }
  }

  // now: at%8==0 || at==upto
  newat = at;
  if ( HAS_AVX2 ) {
    while
      { newat += 32; }
    ( newat <= upto )
      {
        t256 = st.[:u256 at];
        buf.[:u256 off] = t256;
        off += 32;
        at = newat;
      }
    newat -= 16;
    if ( newat <= upto ) {
      t128 = st.[:u128 at];
      buf.[:u128 off] = t128;
      at = newat;
      off += 16;
    }
    newat = at;
    newat += 8;
    if ( newat <= upto ) {
      t64 = st.[:u64 at];
      buf.[:u64 off] = t64;
      off += 8;
      at = newat;
    }
  } else {
    while
      { newat += 8; }
    ( newat <= upto )
      {
        t64 = st.[:u64 at];
        buf.[:u64 off] = t64;
        at = newat;
        off += 8;
      }
  }

  // leftovers...
  if (at < upto) {
    upto8 = (64u) upto;
    upto8 &= 0x07;
    t64 = st.[at];
    buf, off = __a_rlen_write_upto8(buf, off, t64, (64ui) upto8);
  }

  at = upto;
  return buf, off, at;
}

fn _squeeze_updstate
( #[spill_to_mmx] reg mut ptr keccak_updstate st
, #[spill_to_mmx] reg mut ptr u8[_ASIZE] buf
, #[spill_to_mmx] reg ui64 len
) -> reg ptr keccak_updstate   /* st */
   , reg ptr u8[_ASIZE]        /* buf */
{
  inline int KECCAK_F;
  inline bool SPILL;
  reg u64 ststatus;
  #[spill_to_mmx] reg ui64 off, r8, at;
  reg ptr keccak_state stk;

  KECCAK_F = __KECCAK_F(KECCAK_PERMUTATION);
  SPILL = KECCAK_F != KECCAK_F1600_AVX2;

  ststatus = st[25];
  () = #declassify(ststatus);
  _ = #init_msf();
  _, r8, at = _ststatus_data(ststatus); // 0 < r8 < 200; r8 |% 8; 0 <= at <= r8
  stk = st[0:25];
  () = #spill(st);

  if ( at == 0 ) {
    if (SPILL) {
      () = #spill(buf,len,r8);
      stk = _keccakf1600(stk);
      () = #unspill(buf,len,r8);
    } else {
      stk = _keccakf1600(stk);
    }
    at = 0; // obs: no need to spill/unspill(at)!
  }

  off = 0;
  len += at;

  while (r8 < len) {
    buf, off, at = _dump_updstate(buf, off, stk, at, r8);
    if (SPILL) {
      () = #spill(r8, at, len, off, buf);
      stk = _keccakf1600(stk);
      () = #unspill(r8, at, len, off, buf);
    } else {
      stk = _keccakf1600(stk);
    }
    len -= r8;
    at = 0;
  }

  len = len;
  buf, _, at = _dump_updstate(buf, off, stk, at, len);

  () = #unspill(st);
  st[0:25] = stk;
  // if ( at == r8 ) at = 0; // avoidable because r8_at() returns 0<=at<r8
  st.[:u8 8*25] = (8u) (64u) at;

  return st, buf;
}

fn _squeeze_state
( reg mut ptr keccak_state st
, #[spill_to_mmx] reg ui64 r8  // 0 < r8 < 200; r8 |% 8
, #[spill_to_mmx] reg ui64 at  // 0 <= at <= r8; 0 means a permutation is due
, #[spill_to_mmx] reg mut ptr u8[_ASIZE] buf
, #[spill_to_mmx] reg ui64 len
) -> reg ptr keccak_state /* st */
   , reg ptr u8[_ASIZE]   /* buf */
   , reg ui64             /* at */
{
  inline int KECCAK_F;
  inline bool SPILL;
  #[spill_to_mmx] reg ui64 off;

  KECCAK_F = __KECCAK_F(KECCAK_PERMUTATION);
  SPILL = KECCAK_F != KECCAK_F1600_AVX2;

  if ( at == 0 ) {
    if (SPILL) {
      () = #spill(buf,len,r8);
      st = _keccakf1600(st);
      () = #unspill(buf,len,r8);
    } else {
      st = _keccakf1600(st);
    }
    at = 0;
  }

  off = 0;
  len += at;

  while (r8 < len) {
    buf, off, at = _dump_updstate(buf, off, st, at, r8);
    if (SPILL) {
      () = #spill(r8, at, len, off, buf);
      st = _keccakf1600(st);
      () = #unspill(r8, at, len, off, buf);
    } else {
      st = _keccakf1600(st);
    }
    len -= r8;
    at = 0;
  }

  len = len;
  buf, _, at = _dump_updstate(buf, off, st, at, len);

  return st, buf, at;
}
