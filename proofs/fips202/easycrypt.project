[general]
timeout = 5

provers = CVC5@1.3
provers = Z3@4.13

pragmas = -Warn:uninit
pragmas = -Warn:unused_unfold

spec = common/avx2.spec

idirs = JazzEC:../arrays
rdirs = ../arrays
rdirs = ../core

rdirs = CryptoSpecs:spec
rdirs = spec

idirs = JazzEC:extracted
idirs = common
idirs = ref/common
idirs = avx2/common
