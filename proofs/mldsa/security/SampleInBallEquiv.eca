require import AllCore List FMap Int IntDiv StdOrder Real.
require import Distr DBool DList DMap DJoin Dexcepted DistrExtras.
require import Leakage Byte Geometric FoldlO.
require RejectionRO DParams BitEncoding PROM SampleInBallDefs.
import Real.RField.
import IntOrder.

(* The parameters ([in_t], [challenge], [to_concrete], [Params]), the
   encodings and their distributions; only [tau] is used in this file. *)
clone include SampleInBallDefs.
import Params.

(* This script instantiates twice the [RejectionRO] argument in order to
   justify the reduction from the concrete game, where the adversary has
   access to a XOF and a leaky sampling algorithm on top of it (which
   corresponds to the [SampleInBall] algorithm in the specification of MLDSA),
   to a game where the adversary has only access to a random oracle whose
   outputs are a product: a uniform challenge pre-image and an independent
   leakage.

   Interface (used by [SimplifiedScheme], where [C := challenge_ir],
   [dC := SIB.dI] and [dLkgRO := SIB.dLeakRej]):
   - [challenge_ir = byte list * byte list]: the 8 sign bytes and the [tau]
     accepted index bytes; [dI] is its (uniform) distribution, and
     [to_concrete (to_challenge ir)] the corresponding challenge.
   - [rej_ir = int list list]: for each of the [tau] positions
     [i = 256 - tau, .., 255], the bytes rejected by the rejection sampling
     loop of [SampleInBall], in order. Its distribution [dRej] is independent
     of [challenge_ir]: at position [i], a geometric number (success
     probability [(i + 1) / 256], minus one) of bytes uniform in (i, 255].
     [rej_to_leakage] (injective, inverse [leakage_to_rej]) encodes it as a
     leakage; [dLeakRej = dmap dRej rej_to_leakage].
   - [full_leak ir r] is the leakage of [SampleInBall]: the list of pairs
     [(ctx, j)] observed after each iteration of the inner loop (rejected and
     accepted bytes alike), rebuilt from the accepted indices of [ir] and the
     rejected bytes [r] (the contexts are determined: 8 sign bytes first,
     then one context per inner iteration).
   - [SampleInBall(X).get(x) : challenge * leakage] (real algorithm, over a
     XOF [X]), [ROC] the ideal oracle with output [challenge_ir * leakage]
     distributed as [dI `*` dLeakRej], [ToC(R)] the challenge oracle built
     on top of it ([(to_concrete (to_challenge ir), full_leak ir (leakage_to_rej l))]),
     and [Sim(R)] the XOF simulator.
   - [adv_xof_roc : GameReal(A).main ~ GameROC(ORedXOFROC(A)).main], where
     [ORedXOFROC(A)(R)] runs [A(Sim(R), ToC(R))]. *)

(* For the sake of this proof, SampleInBall is factored in two distinct phases:
   first the signs, permutation indices and rejected bytes are sampled, then
   the challenge and the leakage are computed from them. *)

(** Oracles, base signatures and modules. *)
(* "Raw" XOF which outputs bytes for a given integer state and input type combination. *)
clone PROM.FullRO as XOF with
  type in_t <- in_t * int,
  type out_t <- byte,
  op dout <- fun _ => dB.

(* Ideal Random Oracle: challenge pre-images and independent leakage *)
clone PROM.FullRO as ROC with
  type in_t <- in_t,
  type out_t <- challenge_ir * leakage,
  op dout <- fun _ => dI `*` dLeakRej.

module type XOF_t = {
  include XOF.RO [get]
}.

module type ROC_t = {
  include ROC.RO [get]
}.

(* Challenge oracles: challenges with their leakage *)
module type SIB_t = {
  proc get(x : in_t) : challenge * leakage
}.

module SampleInBall(X : XOF_t) : SIB_t = {
  proc get(x : in_t) = {
    var signs <- [];
    var challenge <- nseq 256 0;
    var leak <- [];
    var coeff, ctx, byte, i, j;

    byte <- witness;
    ctx <- 0;
    while (ctx < 8) {
      byte <@ X.get(x, ctx);
      signs <- rcons signs byte;
      ctx <- ctx + 1;
    }

    i <- 256 - tau;
    while (i < 256) {
      j <- i + 1;
      while (i < j) {
        byte <@ X.get(x, ctx);
        j <- to_int byte;
        ctx <- ctx + 1;
        leak <- rcons leak (ctx, j);
      }

      coeff <- nth witness challenge j;
      challenge <- put challenge i coeff;
      coeff <- if to_bool signs (i + tau - 256) then -1 else 1;
      challenge <- put challenge j coeff;
      i <- i + 1;
    }
    return (to_concrete challenge, pairs_to_leakage leak);
  }
}.

(* The challenge oracle built on top of the ideal oracle *)
module ToC(R : ROC_t) : SIB_t = {
  proc get(x : in_t) = {
    var ir, l;
    (ir, l) <@ R.get(x);
    return (to_concrete (to_challenge ir), full_leak ir (leakage_to_rej l));
  }
}.

(** Adversary types, game definition and definition of [SampleInBall] *)
type input, output.
module type XOFAdversary(X : XOF_t, R : SIB_t) = {
  proc run(x : input) : output { X.get, R.get }
}.

module type ROCAdversary(R : ROC_t) = {
  proc run(x : input) : output { R.get }
}.

module GameReal(A : XOFAdversary) = {
  proc main(x : input) = {
    var r;
    XOF.RO.init();
    r <@ A(XOF.RO, SampleInBall(XOF.RO)).run(x);
    return r;
  }
}.

module GameROC(A : ROCAdversary) = {
  proc main(x : input) = {
    var r;
    ROC.RO.init();
    r <@ A(ROC.RO).run(x);
    return r;
  }
}.

(* state: current position, rejected bytes of the previous positions,
   rejected bytes of the current position, accepted bytes *)
op sample_indices_body (xctxbyte : (in_t * int) * byte)
   (state: int * int list list * int list * byte list) =
  let (i, rej, rejc, indices) = state in
  let byte = xctxbyte.`2 in
  if i < 256 then
    let j = to_int byte in
    Some (if (i < j) then (i, rej, rcons rejc j, indices)
         else (i+1, rcons rej rejc, [], rcons indices byte))
  else None.

op sample_indices (log : ((in_t * int) * byte) list) (x: in_t) =
  if (8 <= size log /\
      all (fun (p: (_ * _) * _) => p.`1.`1 = x) log /\
      unzip2 (unzip1 log) = iota_ 0 (size log)) then
    let signs = map snd (take 8 log) in
    let log = drop 8 log in
    let ostate = foldl_o sample_indices_body (Some (256 - tau, [], [], [])) log in
    obind (fun (state : int * int list list * int list * byte list) =>
      if state.`1 = 256 then Some ((signs, state.`4), state.`2) else None) ostate
  else None.

op to_challenge'_log (log : (in_t * (challenge_ir * rej_ir)) list) (x:in_t) =
  if size log = 1 /\ (head witness log).`1 = x then
    Some (to_challenge' (head witness log).`2)
  else None.

clone RejectionRO.TwoSteps as RR with
  type ro_in <- in_t * int,
  type ro_out <- byte,
  type s_inner_in <- in_t,
  type s_in <- in_t,
  type s_inner_out <- challenge_ir * rej_ir,
  type s_out <- challenge_ir * leakage,
  type input <- input,
  type output <- output,
  op F1.dout <- fun _ => dB,
  op F1.ideal_sampler <- fun _ => dI `*` dRej,
  op F2.ideal_sampler <- fun _ => dI `*` dLeakRej,
  op F1.sampler_of <- fst,
  op F2.sampler_of <- idfun,
  op F1.op_sample <- sample_indices,
  op F2.op_sample <- to_challenge'_log
proof*.
realize F1.dout_ll by move => _; apply dB_ll.
realize F1.ideal_sampler_ll
  by move => _; apply dprod_ll; split; [ exact dI_ll | exact dRej_ll ].
realize F2.dout_ll by exact F1.ideal_sampler_ll.
realize F2.ideal_sampler_ll
  by move => _; apply dprod_ll; split; [ exact dI_ll | exact dLeakRej_ll ].

(* The byte stream read by [SampleInBall] on the XOF, as a function of the
   signs, accepted indices and rejected bytes. *)
op stream (r : challenge_ir * rej_ir) : byte list =
  r.`1.`1 ++ flatten (map (fun (p : byte * int list) => rcons (map from_int p.`2) p.`1)
                          (zip r.`1.`2 r.`2)).

(* Writing a byte stream in a map, starting at context [c] *)
op sets (m : (in_t * int, byte) fmap) (x : in_t) (c : int) (bs : byte list) =
  with bs = [] => m
  with bs = b :: bs' => sets m.[(x, c) <- b] x (c + 1) bs'.

section PROOF.
import RR.
(* The module version of the ideal sampler described above, which makes
   calls to a Random Oracle *)
module (SampleIndices : F1.Sampler)(R : F1.RO_t) = {
  proc init() = {}
  proc sample(x : in_t) = {
    var signs <- [];
    var indices <- [];
    var rej <- [];
    var rejc, ctx, byte, i, j;

    byte <- witness;
    ctx <- 0;
    while (ctx < 8) {
      byte <@ R.get(x, ctx);
      signs <- rcons signs byte;
      ctx <- ctx + 1;
    }

    i <- 256 - tau;
    while (i < 256) {
      j <- i + 1;
      rejc <- [];
      while (i < j) {
        byte <@ R.get(x, ctx);
        j <- to_int byte;
        ctx <- ctx + 1;
        rejc <- if i < j then rcons rejc j else rejc;
      }
      rej <- rcons rej rejc;
      indices <- rcons indices byte;
      i <- i + 1;
    }
    return ((signs, indices), rej);
  }
}.

(* The same, with fresh samples instead of RO queries. *)
module SampleIndicesRaw : F1.Sampler_t = {
  proc init() = {}
  proc sample(x : in_t) = {
    var signs <- [];
    var indices <- [];
    var rej <- [];
    var rejc, ctx, byte, i, j;

    byte <- witness;
    ctx <- 0;
    while (ctx < 8) {
      byte <$ dB;
      signs <- rcons signs byte;
      ctx <- ctx + 1;
    }

    i <- 256 - tau;
    while (i < 256) {
      j <- i + 1;
      rejc <- [];
      while (i < j) {
        byte <$ dB;
        j <- to_int byte;
        ctx <- ctx + 1;
        rejc <- if i < j then rcons rejc j else rejc;
      }
      rej <- rcons rej rejc;
      indices <- rcons indices byte;
      i <- i + 1;
    }
    return ((signs, indices), rej);
  }
}.

(* A reprogrammer that allows to simulate the behaviour of the Sampler module
   above when it is replaced by its ideal variant: the output determines all
   the bytes read, which are written back in order. *)
module (ReprogIndices : F1.Reprogrammer)(R : F1.RO_set) = {
  proc reprogram(x : in_t, r : challenge_ir * rej_ir) : unit = {
    var bs, ctx;
    bs <- stream r;
    ctx <- 0;
    while (bs <> []) {
      R.set((x, ctx), head witness bs);
      bs <- behead bs;
      ctx <- ctx + 1;
    }
  }
}.

module (SampleChallenge : F2.Sampler)(R : F2.RO_t) = {
  proc init() = {}
  proc sample(x : in_t) = {
    var r, rs;
    r <@ R.get(x);
    rs <- to_challenge' r;
    return rs;
  }
}.

module SampleChallengeRaw : F2.Sampler_t = {
  proc init() = {}
  proc sample(x : in_t) = {
    var r, rs;
    r <$ dI `*` dRej;
    rs <- to_challenge' r;
    return rs;
  }
}.

module (ReprogChallenge : F2.Reprogrammer)(R : F2.RO_set) = {
  proc reprogram(x : in_t, r : challenge_ir * _) = {
    var y <- witness;
    if (exists y, to_challenge' y = r /\ y \in dI `*` dRej) {
      y <$ dcond (dI `*` dRej) (fun y => to_challenge' y = r);
    }
    R.set(x, y);
  }
}.

(* Losslessness of the reprogrammers (for any lossless [set]). *)
lemma ReprogIndices_ll (R <: F1.RO_set) :
  islossless R.set => islossless ReprogIndices(R).reprogram.
proof.
move=> R_ll; proc; while true (size bs); 2: by auto; smt(size_eq0 size_ge0).
by move=> z; wp; call R_ll; auto; smt(size_behead size_eq0 size_ge0).
qed.

(* The challenge reprogrammer only samples from the (conditional)
   distribution of pre-images when it is not empty. *)
lemma ReprogChallenge_ll (R <: F2.RO_set) :
  islossless R.set => islossless ReprogChallenge(R).reprogram.
proof.
move=> R_ll; proc; call R_ll; sp; if => //.
by rnd; skip => ? [_ /witness_support/dcond_ll].
qed.

(* The challenge oracle built on top of a sampler of [F2]. *)
module ToCS(S : F2.Sampler_t) : SIB_t = {
  proc get(x : in_t) = {
    var ir, l;
    (ir, l) <@ S.sample(x);
    return (to_concrete (to_challenge ir), full_leak ir (leakage_to_rej l));
  }
}.

lemma zip_iota_rcons c (l : 'a list) a :
  zip (iota_ c (size l + 1)) (rcons l a) = rcons (zip (iota_ c (size l)) l) (c + size l, a).
proof. by rewrite iotaSr 1:size_ge0 zip_rcons // size_iota; smt(size_ge0). qed.

local equiv sample_comp :
  SampleInBall(XOF.RO).get ~ ToCS(Comp(SampleChallenge, SampleIndices, F1.RO)).get :
  ={arg} /\ ={RO.m}(XOF,F1) ==> ={res} /\ ={RO.m}(XOF,F1).
proof.
proc; inline{2} ^ <@; inline{2} ^ <@; wp.
while (={RO.m}(XOF,F1) /\ ={i, signs, ctx} /\ x{1} = x1{2} /\
       (i <= 256 /\ size indices = i - (256 - tau) /\ size rej = size indices){2} /\
       challenge{1} = (to_challenge_aux (signs, indices) (i - (256 - tau))){2} /\
       leak{1} = (full_pairs (signs, indices) rej).`2{2} /\
       ctx{2} = (full_pairs (signs, indices) rej).`1{2}).
+ wp.
  while (={RO.m}(XOF,F1) /\ x{1} = x1{2} /\ ={i, j, ctx, signs} /\
         (j <= i => j = to_int byte){2} /\
         (i < 256 /\ size indices = i - (256 - tau) /\ size rej = size indices){2} /\
         challenge{1} = (to_challenge_aux (signs, indices) (i - (256 - tau))){2} /\
         leak{1} = (full_pairs (signs, indices) rej).`2{2} ++
                   (if i < j then zip (iota_ ((full_pairs (signs, indices) rej).`1 + 1)
                                             (size rejc)) rejc
                    else seg (full_pairs (signs, indices) rej).`1 rejc j){2} /\
         ctx{2} = (full_pairs (signs, indices) rej).`1{2} + size rejc{2} +
                  (if i < j then 0 else 1){2}).
  + wp; call (: ={RO.m}(XOF,F1)); 1: by sim.
    auto => /> &2 _ _ _ _ _ b; rewrite /seg.
    have hA : forall (a b : int), a + 1 + b = a + b + 1 by smt().
    case: (i{2} < to_int b) => /= _;
      rewrite ?size_rcons !zip_iota_rcons rcons_cat hA //.
    by rewrite addzA.
  auto => />.
  move=> &2 hi hsz1 hsz2 hlt.
  have -> /= : i{2} < i{2} + 1 by smt().
  rewrite iota0 // cats0 /=; split; 1: smt().
  move=> byte j rejc hlt' _ hj.
  have {hj} -> := hj _; 1: smt().
  rewrite full_pairs_rcons 1:/# /=.
  split; 1: smt(size_rcons).
  have -> /= : i{2} + 1 - (256 - tau) = (i{2} - (256 - tau)) + 1 by ring.
  rewrite to_challenge_auxS; 1:smt(size_ge0).
  rewrite to_challenge_aux_rcons 1:/# /=.
  rewrite /to_challenge_body /= nth_rcons.
  have -> : 256 - tau + (i{2} - (256 - tau)) = i{2} by ring.
  have hs : i{2} - (256 - tau) = size indices{2} by smt().
  by rewrite hs /= /to_bool.
wp.
while (={RO.m}(XOF,F1) /\ x{1} = x1{2} /\ ={signs, ctx} /\ ctx{1} <= 8).
+ by wp; call (: ={RO.m}(XOF,F1)); [sim | auto => /#].
auto => /> ctx signs h1 _ h2.
have ->> /= : ctx = 8 by smt().
split; 1: smt(tau_bound to_challenge_aux0).
move=> i indices rej h3 _ h4 hsz1 hsz2.
have ->> : i = 256 by smt().
by rewrite /to_challenge' /= rej_to_leakageK /to_challenge /full_leak /=; smt().
qed.

(** Correctness of the reprogramming *)

lemma sets_rcons m x c bs b :
  sets m x c (rcons bs b) = (sets m x c bs).[(x, c + size bs) <- b].
proof.
elim: bs m c => [|b' bs ih] m c /=; 1: done.
by rewrite ih addzA.
qed.

lemma sets0_rcons m x bs b :
  sets m x 0 (rcons bs b) = (sets m x 0 bs).[(x, size bs) <- b].
proof. by rewrite sets_rcons. qed.

lemma stream_rcons (s idx : byte list) (r : rej_ir) b rk :
  size idx = size r =>
  stream ((s, rcons idx b), rcons r rk) =
  stream ((s, idx), r) ++ rcons (map from_int rk) b.
proof.
move=> hsz; rewrite /stream /= zip_rcons // map_rcons -cats1 flatten_cat.
by rewrite flatten_seq1 catA.
qed.

local equiv reprog1_correct :
  SampleIndices(F1.ProgRO).sample ~ F1.DelayReprog(SampleIndicesRaw, ReprogIndices).sample :
  ={arg, F1.RO.m} ==> ={res, F1.RO.m}.
proof.
proc; inline{2} ^r<@; inline{2} ReprogIndices(F1.RO).reprogram; inline F1.RO.set.
(* the reprogramming loop writes the stream of bytes in order *)
while{2} (F1.RO.m{1} = sets F1.RO.m{2} x1{2} ctx0{2} bs{2}) (size bs{2}).
+ move=> &1 z; auto => /> &2 hbs.
  by case: (bs{2}) hbs => //= l; smt(size_ge0).
wp.
(* the left program writes the bytes as it reads them, on fresh contexts *)
while (={signs, indices, rej, i, ctx, byte} /\ x{1} = x{2} /\
       F1.RO.m{1} = sets F1.RO.m{2} x{2} 0 (stream ((signs, indices), rej)){2} /\
       ctx{2} = size (stream ((signs, indices), rej)){2} /\
       size indices{2} = size rej{2}).
+ wp.
  while (={signs, indices, rej, i, j, ctx, rejc, byte} /\ x{1} = x{2} /\
         F1.RO.m{1} = sets F1.RO.m{2} x{2} 0 (stream ((signs, indices), rej) ++
                        map from_int rejc ++ (if i < j then [] else [byte])){2} /\
         ctx{2} = size (stream ((signs, indices), rej) ++
                        map from_int rejc ++ (if i < j then [] else [byte])){2} /\
         (j <= i => j = to_int byte){2} /\
         size indices{2} = size rej{2}).
  + inline F1.ProgRO.get; auto => /> &2 h1 hsz hlt b hb.
    rewrite !get_set_sameE /= !cats0.
    case: (i{2} < to_int b) => h /=.
    * by rewrite cats0 map_rcons tK -rcons_cat sets0_rcons size_rcons.
    by rewrite cats1 sets0_rcons size_rcons.
  auto => /> &2 hsz hlt.
  have -> /= : i{2} < i{2} + 1 by smt().
  rewrite !cats0; split; 1: smt().
  move=> byte j rejc _ _ _.
  by rewrite stream_rcons // -cats1 catA /=; smt(size_rcons).
wp.
while (={signs, ctx, byte} /\ x{1} = x{2} /\
       F1.RO.m{1} = sets F1.RO.m{2} x{2} 0 signs{2} /\
       ctx{2} = size signs{2} /\ ctx{2} <= 8).
+ inline F1.ProgRO.get; auto => /> &2 h1 h2 b _.
  by rewrite get_set_sameE /= sets0_rcons size_rcons; smt().
auto => /> &2 signs _ _ _; rewrite /stream /= cats0 /=.
by move=> *; smt(size_eq0 size_ge0).
qed.

(* Conversion of adversary from this theory to the RejectionRO theory *)
local module (ToRR(A : XOFAdversary) : Distinguisher)(R : F1.RO_t, S : F2.Sampler_t) = {
  proc distinguish = A(R, ToCS(S)).run
}.

module Sim(R : ROC_t) : XOF_t = {
  module R' = {
    proc init() = {}
    proc sample = R.get
  }

  include RR.Sim(ReprogIndices, ReprogChallenge, R')
}.

(* The reduction that uses the RejectionRO theory in order to derive a
   ROC adversary from a XOF adversary. *)
module (ORedXOFROC(A : XOFAdversary) : ROCAdversary)(R : ROC_t) = {
  module Artifacts = {
    (* These modules are proof artifacts.
       EasyCrypt requires the adversary to be disjoint from all four of them,
       even though this is technically superfluous. Including them in the
       reduction module is hacky but makes adversary declarations less verbose
       and more consistent with real constraints. *)
    module F1_RO = F1.RO
    module F2_RO = F2.RO
    module F1_ISR = F1.ISR
    module F2_ISR = F2.ISR
  }

  proc run(x : input) = {
    var r;
    Sim(R).init();
    r <@ A(Sim(R), ToC(R)).run(x);
    return r;
  }
}.

section SampleIndices_Proofs.
import F1.

(** Helping lemmas *)
local lemma mu_dB_le i :
  mu dB (fun b => to_int b <= i) = Biased.clamp ((i + 1)%r / 256%r).
proof.
have -> : (fun b => to_int b <= i) = (fun j => j <= i) \o to_int.
- by apply fun_ext.
rewrite -dmapE dB_to_int.
by apply mu_drange_le.
qed.

lemma SampleIndices_ll : islossless SampleIndices(F1.RO).sample.
proof.
proc.
while (0 < i) (256 - i); last first.
- wp; while true (8 - ctx).
  + by move=> z; inline *; auto => />; smt(dB_ll).
  by auto => />; smt(tau_bound).
move=> z; wp; conseq (: true); 1: smt().
pose M := fun (m : (in_t * int, byte) fmap) =>
  (listmax (fun (x x' : in_t * int) => x.`2 <= x'.`2) witness (FSet.elems (fdom m))).`2.
exlim
  (listmax (fun (x x' : in_t * int) => x.`2 <= x'.`2) witness (FSet.elems (fdom F1.RO.m))).`2
  => mi.
splitwhile ^while: (ctx <= mi).
seq 3 : true 1%r 1%r 0%r 0%r (0 < i < 256 /\ (i < j => forall c, ctx <= c => (x, c) \notin F1.RO.m)) => //.
- while ((forall c, mi < c => (x, c) \notin F1.RO.m)).
  - inline *; auto => />; smt(get_setE).
  auto => /> &2 _ _; split; 2: smt().
  move=> c hc; apply/negP => /mem_fdom; rewrite FSet.memE => hin.
  by have := listmax_gt_in (fun (x x' : in_t * int) => x.`2 <= x'.`2) _ _ witness _ _ hin; smt().
- while true (if (i < j) then (mi + 1 - ctx) else 0); 2: by auto => /> /#.
  by move=> z'; inline *; auto => />; rewrite dB_ll /= /#.
case (i < j); last by rcondf ^while; auto.
(* FIXME: this [conseq] should be handled by [while] *)
conseq (: (0 < i < 256 /\ forall (c : int), ctx <= c => (x, c) \notin F1.RO.m) ==> true); 1: smt().
while (0 < i < 256 /\ forall (c : int), ctx <= c => (x, c) \notin F1.RO.m)
            (b2i (i < j)) 1 ((i+1)%r / 256%r); 1..3: smt().
- move=> h.
  seq 4 : true 1%r 1%r 0%r 0%r
    (0 < i < 256 /\ forall (c : int), ctx <= c => (x, c) \notin F1.RO.m) => //.
  - inline *; auto => />; smt(get_setE).
  by islossless; apply dB_ll.
- inline *; auto => />; rewrite dB_ll /=; smt(get_setE).
split; 1: smt().
move=> z'; inline *.
rcondt ^if; 1: by auto => /> /#.
wp. rnd (fun r => to_int r <= i); auto => /> &hr *; split; 2: smt(get_setE).
by rewrite mu_dB_le /#.
qed.

lemma SampleIndices_prog_ll : islossless SampleIndices(F1.ProgRO).sample.
proof.
proc.
while (0 < i) (256 - i); last first.
- wp; while true (8 - ctx).
  + by move=> z; inline *; auto => />; smt(dB_ll).
  by auto => />; smt(tau_bound).
move=> z; wp; conseq (: 0 < i < 256 ==> true); 1,2: smt().
sp.
(* [ProgRO] resamples on every query: the rejection loop terminates a.s. *)
conseq (: 0 < i < 256 ==> true); 1: smt().
while (0 < i < 256) (b2i (i < j)) 1 ((i+1)%r / 256%r); 1..3: smt().
- move=> h; seq 4 : true 1%r 1%r 0%r 0%r (0 < i < 256) => //.
  - by inline *; auto.
  by islossless; apply dB_ll.
- by inline *; auto => />; rewrite dB_ll.
split; 1: smt().
move=> z'; inline *.
wp. rnd (fun r => to_int r <= i); auto => /> &hr *.
by rewrite mu_dB_le; smt(get_set_sameE).
qed.

(** Ideal sampling: the output of [SampleIndicesRaw] is distributed as
    [dI `*` dRej]. *)

local module T = {
  proc s () = {
    var signs, li;
    signs <$ dlist dB 8;
    li <$ dtaurange (fun i => dRejPos i `*` dB_le i);
    return ((signs, unzip2 li), unzip1 li);
  }

  proc s' () = {
    var r;
    r <$ dI `*` dRej;
    return r;
  }
}.

local equiv T_s_s' : T.s ~ T.s' : true ==> ={res}.
proof.
proc.
rndsem{1} 0.
rnd
  (fun (sli : _ * _) => ((sli.`1, unzip2 sli.`2), unzip1 sli.`2))
  (fun (r: (_ * _) * _) => (r.`1.`1, zip r.`2 r.`1.`2)); skip => /=.
rewrite -dprod_dlet djoinmap_prod (dprodC (djoinmap dRejPos _)).
rewrite dmap_comp dmap_dprodR /dI dprodA /(\o).
rewrite /dRej.
split.
+ move=> ? /supp_dmap /> ? /supp_dprod [] ? /supp_dprod [] /supp_djoinmap [] hsz1 _ /supp_djoinmap [] hsz2 _.
  by rewrite !(unzip1_zip, unzip2_zip) -?hsz1 -?hsz2.
move=> _; split.
+ move=> ? /supp_dmap /> ? /supp_dprod [] ? /supp_dprod [] /supp_djoinmap [] hsz1 _ /supp_djoinmap [] hsz2 _.
  rewrite !dmap1E /(\o) /pred1 /=.
  apply mu_eq_support => /= ? /supp_dprod [] ? /supp_dprod [] /supp_djoinmap [] hsz1' _ /supp_djoinmap [] hsz2' _.
  smt (unzip1_zip unzip2_zip).
move=> _ ? /supp_dmap /> [signs [indices leaks]] /supp_dprod [] ? /supp_dprod [] /supp_djoinmap [] /= hsz1 ? /supp_djoinmap [] /= hsz2 ?.
split; 2: by move=> _; rewrite !(unzip1_zip, unzip2_zip) -?hsz1 -?hsz2.
apply supp_dmap => /=; exists (signs, (indices, leaks)) => /=.
split; 2: by rewrite !(unzip1_zip, unzip2_zip) -?hsz1 -?hsz2.
apply supp_dprod; split => //.
by apply supp_dprod => /=; split; apply supp_djoinmap.
qed.

(* clones for manipulating distribution in the next proof. *)
local clone DList.Program as Ds with
  type t <- byte,
  op d <- dB.

local clone DList.ParametricProgram as Dl with
  type t <- int.

local clone JoinMapSampling as Dj with
  type ta <- int,
  type tb <- int list * byte.

local clone DProd.ProdSampling as Dcb with
  type t1 <- int list,
  type t2 <- byte.

local clone DProd.DLetSampling as Dd with
  type t <- int,
  type u <- int list.

local clone Geometric.ModuleBased.RejSampling as RS with
  type out_t <- byte.

local lemma mu_small_enough i :
  mu dB (small_enough i) = Biased.clamp ((i + 1)%r / 256%r).
proof. by rewrite -mu_dB_le; apply mu_eq => b; rewrite /small_enough /#. qed.

local lemma dB_thres_val i : 0 <= i < 256 => dB_thres i = (i + 1)%r / 256%r.
proof. by move=> ?; rewrite /dB_thres mu_small_enough /Biased.clamp; smt(). qed.

local lemma dcond'_small_enough i :
  0 <= i < 256 => dcond' dB (small_enough i) = dB_le i.
proof.
move=> hi; rewrite /dcond' -witness_support.
have -> /= : 0%r < mu dB (fun (x : byte) => small_enough i x).
+ by rewrite (mu_eq _ _ (small_enough i)) // mu_small_enough /Biased.clamp; smt().
by rewrite /dB_le; congr; apply fun_ext => b; rewrite /small_enough /#.
qed.

(* The distribution of a try of the rejection sampling loop, knowing whether
   it succeeds, is the one of the RO below. *)
local lemma sample_biased_distr i t :
  0 <= i < 256 => t \in Biased.dbiased (mu dB (small_enough i)) =>
  (if t then dcond dB (small_enough i) else dB \ small_enough i) =
  (if t then dcond' dB (small_enough i) else dcond' dB (predC (small_enough i))).
proof.
move=> hi ht; case: t ht => /= ht.
+ rewrite /dcond'; have -> // : exists x, small_enough i x /\ x \in dB.
  by exists (from_int 0); rewrite /small_enough tK' // dB_full /#.
have hi255 : i < 255.
+ move: ht; rewrite /support Biased.dbiased1E mu_small_enough /Biased.clamp.
  smt().
rewrite /dcond'; have -> /= : exists x, predC (small_enough i) x /\ x \in dB.
+ by exists (from_int 255); rewrite /predC /small_enough tK' // dB_full /#.
by rewrite /(\) /dcond.
qed.

(* A RO for the tries of the rejection sampling loop at position [i]:
   [(i, k, false)] is the value of the [k]-th try if it fails,
   [(i, k, true)] if it succeeds. *)
local clone PROM.FullRO as PR with
  type in_t <- int * int * bool,
  type out_t <- byte,
  op dout <- fun (x : int * int * bool) =>
    if x.`3 then dcond' dB (small_enough x.`1)
    else dcond' dB (predC (small_enough x.`1)),
  type d_in_t <- int,
  type d_out_t <- int list * byte.

local module PD(G : PR.RO) = {
  proc distinguish(i : int) = {
    var t, c, k, b, rejc;
    t <- false;
    c <- 0;
    while (!t) {
      t <$ dbias i;
      G.sample(i, c, t);
      c <- c + 1;
    }
    rejc <- [];
    k <- 0;
    while (k < c - 1) {
      b <@ G.get(i, k, false);
      rejc <- rcons rejc (to_int b);
      k <- k + 1;
    }
    b <@ G.get(i, c - 1, true);
    return (rejc, b);
  }
}.

(* One iteration of the index loop of [SampleIndicesRaw] *)
local module Step = {
  proc left(i : int) = {
    var j, byte, rejc;
    byte <- witness;
    rejc <- [];
    j <- i + 1;
    while (i < j) {
      byte <$ dB;
      j <- to_int byte;
      rejc <- if i < j then rcons rejc j else rejc;
    }
    return (rejc, byte);
  }

  proc left2(i : int) = {
    var t, byte, rejc;
    byte <- witness;
    rejc <- [];
    t <- false;
    while (!t) {
      (t, byte) <@ RS.Rej.sample_test(dB, small_enough i);
      rejc <- if !t then rcons rejc (to_int byte) else rejc;
    }
    return (rejc, byte);
  }

  proc mid(i : int) = {
    var t, byte, rejc;
    byte <- witness;
    rejc <- [];
    t <- false;
    while (!t) {
      (t, byte) <@ RS.Rej.sample_biased(dB, small_enough i);
      rejc <- if !t then rcons rejc (to_int byte) else rejc;
    }
    return (rejc, byte);
  }

  proc geo(i : int) = {
    var rejc, byte;
    rejc <@ Dd.SampleDep.sample(geom_i i, fun c => dlist (dRejB i) (c - 1));
    byte <$ dB_le i;
    return (rejc, byte);
  }

  proc geo1(i : int) = {
    var c, rejc, byte;
    c <@ Geometric.ModuleBased.M.loop_try(dB_thres i);
    rejc <@ Dl.LoopSnoc.sample(dRejB i, c - 1);
    byte <$ dB_le i;
    return (rejc, byte);
  }

  proc right(i : int) = {
    var r;
    r <@ Dcb.S.sample(dRejPos i, dB_le i);
    return r;
  }
}.

local equiv step_left_left2 : Step.left ~ Step.left2 : ={i} ==> ={res}.
proof.
proc; inline RS.Rej.sample_test; wp.
while (={byte, rejc, i} /\ (i < j){1} = !t{2}).
+ by auto => /> &2 _ b _; rewrite /small_enough.
by auto => />; smt().
qed.

local equiv step_left2_mid : Step.left2 ~ Step.mid : ={i} ==> ={res}.
proof.
proc; wp.
while (={t, byte, rejc, i}).
+ by wp; call RS.sample_test_biased; auto => />; smt(dB_ll).
by auto.
qed.

local equiv step_mid_ro : Step.mid ~ PR.MainD(PD, PR.RO).distinguish :
  i{1} = x{2} /\ 0 <= i{1} < 256 ==> ={res}.
proof.
proc; inline *; wp; rnd{2}; wp.
(* the right program reads back the values written by its first loop *)
while{2} (rejc{2} = take k{2} rejc{1} /\ 0 <= k{2} <= c{2} - 1 /\
          c{2} = size rejc{1} + 1 /\
          (forall k, 0 <= k < size rejc{1} =>
             (i{2}, k, false) \in PR.RO.m{2} /\
             to_int (oget PR.RO.m{2}.[(i{2}, k, false)]) = nth 0 rejc{1} k) /\
          PR.RO.m{2}.[(i{2}, c{2} - 1, true)] = Some byte{1})
         (c{2} - 1 - k{2}).
+ move=> &1 z; auto => /> &hr hk0 hk1 hin hacc hk.
  split; 1: exact dcond'_ll.
  move=> _ v _ _; have [hm hv] := hin k{hr} _; 1: smt().
  rewrite hm /= (take_nth 0) 1:/# hv /=; smt().
wp.
(* each try of the left loop is the sample of a fresh key of the RO *)
while (={t} /\ i{1} = i{2} /\ 0 <= i{1} < 256 /\
       c{2} = size rejc{1} + b2i t{1} /\
       (forall k, 0 <= k < size rejc{1} =>
          (i{2}, k, false) \in PR.RO.m{2} /\
          to_int (oget PR.RO.m{2}.[(i{2}, k, false)]) = nth 0 rejc{1} k) /\
       (t{1} => PR.RO.m{2}.[(i{2}, c{2} - 1, true)] = Some byte{1}) /\
       (forall k b, c{2} <= k => (i{2}, k, b) \notin PR.RO.m{2})).
+ wp; rnd; wp; rnd; auto => /> &1 &2 hi0 hi1 hacc _ hfresh ht _ b hb _.
  have {hfresh} hf : forall k0 b0, size rejc{1} <= k0 => (i{2}, k0, b0) \notin PR.RO.m{2}.
  + by move=> k0 b0 hk; apply hfresh; move: ht; case: (t{2}) => //= _; rewrite /b2i /#.
  rewrite (sample_biased_distr i{2} b) //=.
  move=> r hr; split => // _.
  have hnin := hf (size rejc{1}) b _; 1: done.
  rewrite /b2i /= hnin /=.
  case: b hb hnin hr => hb hnin hr /=.
  + split; 1: smt(mem_set get_setE).
    rewrite get_set_sameE /= => k0 b0 hk; rewrite mem_set /= negb_or.
    by split; [apply hf | ]; smt().
  rewrite size_rcons /=; split.
  + move=> k0 hk0 hk1; rewrite mem_set get_setE nth_rcons.
    case: (k0 = size rejc{1}) => [->|hne] /=; 1: done.
    have /= -> := hne; smt().
  move=> k0 b0 hk; rewrite mem_set /= negb_or.
  by split; [apply hf | ]; smt().
auto => />.
move=> &2 hx0 hx1; split; 1: smt(mem_empty).
move=> byte rejc t m t' _ _ hacc hbyte hfresh.
have hb1 : b2i true = 1 by rewrite /b2i.
move: hbyte; rewrite hb1 /= take0 /= => hbyte; split; 1: smt(size_ge0).
move=> m' k; split; 1: smt().
move=> hk hk0 hk1 hacc' hbyte'; split; 1: exact dcond'_ll.
move=> _ r _; rewrite domE hbyte' /=.
have ->> : k = size rejc by smt().
by rewrite take_size.
qed.

local equiv step_lro_geo1 : PR.MainD(PD, PR.LRO).distinguish ~ Step.geo1 :
  x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res}.
proof.
proc; inline *.
wp; rnd; wp.
while (k{1} = i1{2} /\ rejc{1} = l{2} /\ n{2} = c{1} - 1 /\ d{2} = dRejB i{2} /\
       i{1} = i{2} /\ 0 <= i{2} < 256 /\
       (forall kk bb, (i{1}, kk, bb) \in PR.RO.m{1} => kk < k{1} /\ !bb)).
+ wp; rnd to_int from_int; auto => />.
  move=> &1 &2 hi0 hi1 hm hk; split.
  + by move=> r /supp_dmap [b [_ ->]]; rewrite tK.
  move=> _; split.
  + move=> r /supp_dmap [b [_ ->]]; rewrite tK /dRejB dmap1E /(\o) /pred1.
    by apply mu_eq => b' /=; apply eq_iff; split => [/to_int_inj|->].
  move=> _ r hr; split; 1: by rewrite supp_dmap; exists r.
  move=> _; rewrite tK /=.
  have hn : (i{2}, i1{2}, false) \notin PR.RO.m{1} by smt().
  rewrite hn /= get_set_sameE /= cats1 /=.
  by move=> kk bb; rewrite mem_set; smt().
wp.
while (t{1} = b{2} /\ c{1} = i0{2} /\ p{2} = dB_thres i{2} /\ i{1} = i{2}).
+ by auto.
auto => />.
move=> &2 hi0 hi1 t b c _ _; split; 1: smt(mem_empty).
move=> m k _ _ hm; rewrite dcond'_small_enough //=.
move=> r hr; have -> /= : (i{2}, c - 1, true) \notin m by smt().
by rewrite hr get_set_sameE.
qed.

local equiv step_geo1_geo : Step.geo1 ~ Step.geo :
  ={i} /\ 0 <= i{2} < 256 ==> ={res}.
proof.
proc; rnd; inline{2} Dd.SampleDep.sample; wp.
seq 1 3 : (={i} /\ c{1} = t{2} /\ du{2} = (fun c => dlist (dRejB i{2}) (c - 1)) /\ 0 <= i{2} < 256).
+ transitivity*{1} { c <@ Geometric.ModuleBased.M.geometric(dB_thres i); }.
  + by call Geometric.ModuleBased.loop_try_equiv.
  by inline *; auto => /> &2 h0 h1; rewrite dB_thres_val.
transitivity{1} { rejc <@ Dl.Sample.sample(dRejB i, c - 1); }
  (={i, c} ==> ={i, rejc})
  (={i} /\ c{1} = t{2} /\ du{2} = (fun c => dlist (dRejB i{2}) (c - 1)) ==> ={i} /\ rejc{1} = u{2}).
+ by move=> &1 &2 h; exists c{1} i{1}; smt().
+ smt().
+ by symmetry; call Dl.Sample_LoopSnoc_eq.
by inline *; auto.
qed.

local equiv step_lro_geo : PR.MainD(PD, PR.LRO).distinguish ~ Step.geo :
  x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res}.
proof.
transitivity Step.geo1
  (x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res}) (={i} /\ 0 <= i{2} < 256 ==> ={res}); 1,2: smt().
+ exact step_lro_geo1.
exact step_geo1_geo.
qed.

local equiv dep_dlet : Dd.SampleDep.sample ~ Dd.SampleDLet.sample : ={dt, du} ==> ={res}.
proof.
transitivity Dd.SampleDep.sample2
  (={dt, du} ==> res{1} = res{2}.`2) (={dt, du} ==> res{1}.`2 = res{2}); 1,2: smt().
+ exact Dd.SampleDep.
transitivity Dd.SampleDLet.sample2
  (={dt, du} ==> ={res}) (={dt, du} ==> res{1}.`2 = res{2}); 1,2: smt().
+ exact Dd.SampleDepDLet2.
by symmetry; conseq Dd.SampleDLet => /> /#.
qed.

local equiv step_geo_right : Step.geo ~ Step.right : ={i} ==> ={res}.
proof.
proc.
transitivity*{2} { r <@ Dcb.S.sample2(dRejPos i, dB_le i); }.
+ inline{2} Dcb.S.sample2; wp; rnd.
  transitivity*{1} { rejc <@ Dd.SampleDLet.sample(geom_i i, fun c => dlist (dRejB i) (c - 1)); }.
  + by call dep_dlet.
  by inline *; auto.
by symmetry; call Dcb.sample_sample2.
qed.

local equiv step_eq :
  Step.left ~ Step.right : ={i} /\ 0 <= i{1} < 256 ==> ={res}.
proof.
transitivity Step.left2 (={i} ==> ={res}) (={i} /\ 0 <= i{1} < 256 ==> ={res});
  1,2: smt(); 1: exact step_left_left2.
transitivity Step.mid (={i} ==> ={res}) (={i} /\ 0 <= i{1} < 256 ==> ={res});
  1,2: smt(); 1: exact step_left2_mid.
transitivity PR.MainD(PD, PR.RO).distinguish
  (i{1} = x{2} /\ 0 <= i{1} < 256 ==> ={res}) (x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res});
  1,2: smt(); 1: exact step_mid_ro.
transitivity PR.MainD(PD, PR.LRO).distinguish
  (={x} ==> ={res}) (x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res}); 1,2: smt().
+ conseq (PR.FullEager.RO_LRO PD _) => //.
  by move=> x; case: (x.`3) => _; apply dcond'_ll.
transitivity Step.geo
  (x{1} = i{2} /\ 0 <= i{2} < 256 ==> ={res}) (={i} ==> ={res}); 1,2: smt().
+ exact step_lro_geo.
exact step_geo_right.
qed.

equiv SampleIndices_IdealSampling :
  SampleIndicesRaw.sample ~ F1.ISAsProc.get : ={arg} ==> ={res}.
proof.
proc.
proc change{2} 1 : { r <@ T.s'(); }.
+ by inline *; auto.
proc change{2} 1 : { r <@ T.s(); }.
+ by symmetry; call T_s_s'.
inline{2} T.s; wp.
swap{1} [2..3] 3.
seq 4 1 : (={x, signs} /\ ctx{1} = 8).
+ proc change{2} 1 : { signs <@ Ds.Sample.sample(8); }.
  + by inline *; auto.
  proc change{2} 1 : { signs <@ Ds.LoopSnoc.sample(8); }.
  + by call Ds.Sample_LoopSnoc_eq.
  inline sample get; wp.
  by while ((ctx,signs){1} = (i, l){2} /\ n{2} = 8 /\ ctx{1} <= 8); auto => /> *; rewrite ?cats1 /#.
pose dp := fun i => dRejPos i `*` dB_le i.
proc change{2} 1 :
  { li <@ Dj.S.sample (dp, (range (256 - tau) 256)); }.
+ by inline *; auto.
proc change{2} 1 :
  { li <@ Dj.S.loop_first (dp, (range (256 - tau) 256)); }.
+ by call Dj.Sample_Loop_first_eq.
inline *; wp.
while (indices{1} = unzip2 l{2} /\ rej{1} = unzip1 l{2} /\
      xs{2} = range i{1} 256 /\ d{2} = dp /\ 0 < i{1} <= 256);
 last first.
+ by auto => />; smt (range_ltn range_geq tau_bound).
wp.
exlim ctx{1} => ctx_.
transitivity*{1} { (rejc, byte) <@ Step.left(i); j <- to_int byte;
                   ctx <- ctx_ + size rejc + 1; }.
+ inline Step.left; wp.
  while ((!(i{1} < j{1}) => byte{1} = byte0{2}) /\ j{1} = j0{2} /\ i{1} = i0{2} /\ rejc{1} = rejc0{2} /\
         ctx{1} = ctx_ + size rejc0{2} + (if i{1} < j{1} then 0 else 1)).
  + by auto => />; smt(size_rcons).
  by auto => /> /#.
transitivity*{1} { (rejc, byte) <@ Step.right(i); j <- to_int byte;
                   ctx <- ctx_ + size rejc + 1; }.
+ by wp; call step_eq; auto => /> /#.
inline Step.right Dcb.S.sample; auto.
move=> &1 &2 [#] _ -> -> -> -> h0 h1 hi _ /=.
rewrite /dp (range_ltn _ _ hi) /=.
move=> r hr; rewrite hr /= !map_rcons /=.
smt(range_ltn range_geq).
qed.

hoare SampleIndices_OpSampleGame x :
  F1.Op_sample_game(SampleIndices).sample :
    arg = x ==> sample_indices res.`1 x = Some res.`2.
proof.
proc; inline sample F1.LogRO.get.
seq 8 : (signs = map snd F1.LogRO.log /\ size F1.LogRO.log = 8 /\
         all (fun (p : (in_t * int) * byte) => p.`1.`1 = x) F1.LogRO.log /\
         unzip2 (unzip1 F1.LogRO.log) = iota_ 0 8 /\
         rej = [] /\ indices = [] /\ ctx = 8 /\ x0 = x).
+ while (signs = map snd F1.LogRO.log /\ size F1.LogRO.log = ctx /\
         all (fun (p : (in_t * int) * byte) => p.`1.`1 = x) F1.LogRO.log /\
         unzip2 (unzip1 F1.LogRO.log) = iota_ 0 ctx /\ ctx <= 8 /\ x0 = x).
  + auto.
    call (: true) => //; auto => /> &hr hall hunzip _ hsz r.
    rewrite !map_rcons /= size_rcons /= iotaSr 1: size_ge0 hunzip /= -cats1 all_cat hall /= => /#.
  by auto => />; rewrite iota0 //= => /#.
wp.
while ( all (fun (p : (in_t * int) * byte) => p.`1.`1 = x) F1.LogRO.log /\ i <= 256 /\
        signs = unzip2 (take 8 F1.LogRO.log) /\ size F1.LogRO.log = ctx /\
        unzip2 (unzip1 F1.LogRO.log) = iota_ 0 ctx /\ 8 <= ctx /\ x0 = x /\
        foldl_o sample_indices_body (Some (256 - tau, [], [], [])) (drop 8 F1.LogRO.log) = Some (i, rej, [], indices)).
+ wp; while ( all (fun (p : (in_t * int) * byte) => p.`1.`1 = x) F1.LogRO.log /\ i < 256 /\
        signs = unzip2 (take 8 F1.LogRO.log) /\ size F1.LogRO.log = ctx /\
        unzip2 (unzip1 F1.LogRO.log) = iota_ 0 ctx /\ 8 <= ctx /\ x0 = x /\
        foldl_o sample_indices_body (Some (256 - tau, [], [], [])) (drop 8 F1.LogRO.log) =
           Some (if i < j then (i, rej, rejc, indices)
                 else (i + 1, rcons rej rejc, [], rcons indices byte))).
  + wp; call (:true); auto => /> &hr hall hi hunzip hsz hfold hij b.
    rewrite iotaSr 1:/# -!cats1 all_cat !map_cat /= drop_cat_le hall hunzip hsz /=.
    rewrite size_cat /= take_catl //.
    by rewrite foldl_o_cat hfold /foldl_o /= /sample_indices_body hij /= hi !cats1 /#.
  by auto => /> /#.
auto => /> &hr hsz hall_ hunzip_.
rewrite drop_oversize 1:hsz // {1}/foldl_o /= take_oversize 1:hsz //=.
split; 1: smt (tau_bound).
move=> log i indices rej hi hall hi' htake hunzip hszl hbody.
rewrite /sample_indices hszl hunzip hall /= hbody /=.
smt().
qed.

phoare SampleIndices_OpSampleGameFun log y m : [
  F1.Op_sample_game(SampleIndices).sample :
    (forall a b, (a, b) \in log => RO.m.[a] = Some b) /\
      sample_indices log x = Some y /\ RO.m = m
    ==> res.`1 = log /\ F1.RO.m = m] = 1%r.
proof.
proc; inline sample => /=.
rewrite /sample_indices /=; wp.
+ while ( F1.LogRO.log = take ctx log /\ 0 <= ctx <= size log /\ F1.RO.m = m /\
          (forall (a : in_t * int) (b : byte), (a, b) \in log => F1.RO.m.[a] = Some b) /\
          all (fun (p : (in_t * int) * byte) => p.`1.`1 = x0) log /\
          unzip2 (unzip1 log) = iota_ 0 (size log) /\
          exists rej_ rejc_ indices_,
            foldl_o sample_indices_body (Some (i, rej, [], indices)) (drop ctx log) = Some (256, rej_, rejc_, indices_) )
        (256 - i).
  + move=> zi; wp.
    while ( F1.LogRO.log = take ctx log /\ 0 <= ctx <= size log /\ i < 256 /\ F1.RO.m = m /\
            (forall (a : in_t * int) (b : byte), (a, b) \in log => F1.RO.m.[a] = Some b) /\
            all (fun (p : (in_t * int) * byte) => p.`1.`1 = x0) log /\
            unzip2 (unzip1 log) = iota_ 0 (size log) /\
            exists rej_ rejc_ indices_,
              foldl_o sample_indices_body
                (Some (if i < j then (i, rej, rejc, indices)
                       else (i + 1, rcons rej rejc, [], rcons indices byte)))
                (drop ctx log) = Some (256, rej_, rejc_, indices_) )
           (if i < j then size log - ctx else 0).
    + move=> zc; wp.
      exlim x0, ctx, F1.LogRO.log => x0_ ctx_ log_.
      call (LogRO_get_ll (x0_, ctx_) log_ m); skip.
      move=> &hr /> hctx hsz hi hin hall hunzip rej_ rejc_ indices_ + hij.
      case _ : (drop _ log) => [ | [ [x' ctx'] b] log'] heq.
      + by rewrite /foldl_o /= /#.
      rewrite foldl_o_cons /= {2}/sample_indices_body hij /= hi /=.
      move=> hbody.
      have hlog : log = take ctx{hr} log ++ ((x', ctx'), b) :: log'.
      + by rewrite -heq cat_take_drop.
      have htake : size (take ctx{hr} log) = ctx{hr}.
      + by rewrite size_take // /#.
      have /> : x' = x0{hr} /\ ctx' = ctx{hr}.
      + move: hall hunzip; rewrite hlog all_cat size_cat size_takel //= => /> _ _.
        rewrite !map_cat iota_add //=; 1: smt(size_ge0).
        rewrite eqseq_cat.
        + rewrite !size_map size_iota htake /#.
        by rewrite addrC iotaS 1:size_ge0 => />.
      have hget : F1.RO.m{hr}.[x0{hr}, ctx{hr}] = Some b.
      + by apply hin; rewrite hlog mem_cat.
        rewrite domE hget /= => />.
        rewrite -!andbA; split.
        + rewrite {2} hlog take_cat htake.
          rewrite StdOrder.IntOrder.gtr_addl /=.
          have -> /= : ctx{hr} + 1 - ctx{hr} = 1 by ring.
          by rewrite take0 cats1.
        rewrite !andbA andbC -!andbA !andbA; split.
        + rewrite hlog size_cat htake /=; smt(size_ge0).
        exists rej_ rejc_ indices_; rewrite -hbody.
        rewrite hlog drop_catr htake // 1:/#.
        have -> : ctx{hr} + 1 - ctx{hr} = 1 by ring.
        by rewrite drop_cons /= drop0; case: (i{hr} < _).
      auto => /> &hr 5? rej_ rejc_ indices_.
      have -> /= : i{hr} < i{hr} + 1 by smt().
      move=> -> ?; split; 1:smt().
      move=> b ctx0 j0 *; split; 2: smt().
      move=> 3? rej_0 rejc_0 indices_0.
      case: (i{hr} < j0) => // _ + h.
      rewrite drop_oversize 1:/# /foldl_o /= /#.
    wp.
    while (F1.LogRO.log = take ctx log /\ F1.RO.m = m /\
           0 <= ctx <= 8 /\ 8 <= size log /\
           (forall (a : in_t * int) (b : byte), (a, b) \in log => F1.RO.m.[a] = Some b) /\
           all (fun (p : (in_t * int) * byte) => p.`1.`1 = x0) log /\
           unzip2 (unzip1 log) = iota_ 0 (size log))
         (8 - ctx).
    + move => z; wp.
      exlim x0, ctx, F1.LogRO.log => x0_ ctx_ log_.
      call (LogRO_get_ll (x0_, ctx_) log_ m); skip.
      move=> &hr /> hctx hsz hszl hin hall hunzip h8; rewrite domE.
      have hlog := cat_take_insert_drop witness ctx{hr} log _; 1: smt().
      have htake : size (take ctx{hr} log) = ctx{hr}.
      + by rewrite size_take /#.
      have heq : (x0{hr}, ctx{hr}) = (nth witness log ctx{hr}).`1.
      + move: hall hunzip; rewrite -hlog nth_cat htake /=.
        rewrite all_cat /= !map_cat size_cat iota_add; 1,2: smt(size_ge0).
        move=> /> _ _.
        rewrite eqseq_cat.
        + rewrite !size_map size_iota; smt(size_ge0).
        rewrite (Ring.IntID.addrC 1) iotaS 1:size_ge0 => /=.
        by rewrite htake /= /#.
      have -> /> : F1.RO.m{hr}.[x0{hr}, ctx{hr}] = Some (nth witness log ctx{hr}).`2.
      + apply hin; rewrite -hlog nth_cat htake //=.
        by rewrite mem_cat /= /#.
      rewrite -{3}hlog take_cat htake StdOrder.IntOrder.gtr_addl /=.
      have -> /= : ctx{hr} + 1 - ctx{hr} = 1 by ring.
      by rewrite take0 cats1 /#.
    auto => /> &hr hget.
    case: (8 <= size log /\
           all (fun (p : (in_t * int) * byte) => p.`1.`1 = x{hr}) log /\
           unzip2 (unzip1 log) = iota_ 0 (size log)) => />.
    move=> 3?.
    case _ : (foldl_o sample_indices_body (Some (256 - tau, [], [], [])) (drop 8 log)) => [|[i_ rej_ rejc_ indices_]] heq //=.
    case: (i_ = 256) => />; split.
    + by rewrite take0.
    move=> ctx0; split; 1: smt().
    move=> *. have ->> : ctx0 = 8 by smt().
    split; 1: smt().
    move=> ctx1 i0 indices0 rej0; split; 1: smt().
    move=> hi 2? rej_0 rejc_0 indices_0.
    case : (ctx1 = size log).
    + by move=> ->; rewrite take_size.
    move=> ?.
    have hlog := cat_take_insert_drop witness ctx1 log _; 1: smt().
    rewrite -{1}hlog drop_cat size_take //=.
    have -> /= : ctx1 < size log by smt().
    rewrite foldl_o_cons /= {2}/sample_indices_body /= hi /=.
    by rewrite foldl_o_None.
qed.
end section SampleIndices_Proofs.

declare module A <: XOFAdversary{-ORedXOFROC, -ROC.RO, -XOF.RO}.

local equiv main :
  Main(ToRR(A), RO, Comp(SampleChallenge, SampleIndices, RO)).main ~
    Main(ToRR(A), RR.Sim(ReprogIndices, ReprogChallenge, F2.ISR), F2.ISR).main :
  ={glob A, arg} ==> ={glob A, res}.
proof.
apply (equiv_rej_sim
  SampleIndices SampleIndicesRaw ReprogIndices SampleChallenge SampleChallengeRaw ReprogChallenge (ToRR(A))) => //.
- split; 1: by proc; auto.
  split; 1: exact SampleIndices_ll.
  exact SampleIndices_prog_ll.
- exact SampleIndices_IdealSampling.
- proc; inline.
  do 2 ! (while (F1.SamplerOfCorrect.is_valid /\ x = F1.SamplerOfCorrect.sampler_input /\
    0 <= ctx /\ forall i, (x, i) \in RO.m => 0 <= i < ctx);
  wp); auto => />; smt(get_setE).
- exact SampleIndices_OpSampleGame.
- exact SampleIndices_OpSampleGameFun.
- by move=> R; apply (ReprogIndices_ll R).
- proc; while (x = F1.SamplerOfCorrect.sampler_input /\ F1.SamplerOfCorrect.is_valid).
  + by inline; auto.
  by auto.
- by conseq reprog1_correct => //.

(* Lemmas regarding the second Sampler/Reprog pair *)
- split; 1: by proc.
  split; proc; islossless;
    by apply dprod_ll; split; [ exact dI_ll | exact dRej_ll ].
- proc. inline. proc rewrite{2} 1 dmap_dprodR.
  by rndsem*{1} 0; rnd.
- proc. inline. auto => /#.
- by move=> x_; proc; inline *; auto.
- move=> log y m.
  proc; inline *; swap 5 -4; wp.
  conseq (: true); last
    by islossless; apply dprod_ll; rewrite dI_ll dRej_ll.
  move=> &hr /> hlog; rewrite /to_challenge'_log.
  case: log hlog => [ // | [x' b] [ | //=]]; last by smt(size_ge0).
  move=> /(_ x' b _) //; rewrite domE /=.
  by case: (x' = x{hr}) => /> ->.
- by move=> R; apply (ReprogChallenge_ll R).
- by proc; inline; auto => />.

have H2 :
  dlet (dI `*` dRej) (fun r =>
    dmap (dcond (dI `*` dRej) (fun r1 => to_challenge' r1 = to_challenge' r))
      (fun y => y)) = (dI `*` dRej).
- rewrite {3} (marginal_sampling (dI `*` dRej) to_challenge') dlet_dmap.
  congr. by apply fun_ext=> ?; apply dmap_id.

(* dealing with distributions in equiv is always tedious. This script
   and its underlying lemma [H2] are quite brittle, even though the
   core argument (marginal sampling) is straightforward.  *)
proc. inline*. wp. swap{2} ^x1<- @^ <$. sp.
conseq (: (r0, to_challenge' r0){1} = (y, r){2}); 1: smt(get_setE).
transitivity{2}
  { r0 <$ (dI `*` dRej); r1 <- to_challenge' r0;
    y <$ dcond (dI `*` dRej) (fun r => to_challenge' r = r1); }
  (true ==> r0{1} = y{2}) (true ==> (y, to_challenge' y){1} = (y, r){2}); 1,2: smt().
- rndsem*{2} 0. by proc rewrite{2} 1 H2; sim.
rcondt{2} ^if; 1: by auto => _ _ y ?; exists y.
by auto => />; smt(dcond_supp).
qed.

equiv adv_xof_roc :
  GameReal(A).main ~ GameROC(ORedXOFROC(A)).main :
  ={glob A, arg} ==> ={glob A, res}.
proof.
transitivity
  Main(ToRR(A), RO, Comp(SampleChallenge, SampleIndices, RO)).main
  (={glob A, arg} ==> ={glob A, res}) (={glob A, arg} ==> ={glob A, res}); 1,2: smt().
- proc. call(: ={RO.m}(XOF,F1)).
  + by sim.
  + exact sample_comp.
  by inline; auto.
transitivity
  Main(ToRR(A), RR.Sim(ReprogIndices, ReprogChallenge, F2.ISR), F2.ISR).main
  (={glob A, arg} ==> ={glob A, res}) (={glob A, arg} ==> ={glob A, res}); 1,2: smt().
- exact main.
proc. inline{2} ^r<@. sim 2 3.
by inline init; auto.
qed.
end section PROOF.
