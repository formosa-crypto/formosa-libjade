require import AllCore List FMap Int IntDiv StdOrder Real.
require import Distr DBool DList DMap DJoin DistrExtras.
require import Leakage Geometric.
require Byte RejectionRO SplitRO DParams BitEncoding.
import Real.RField.
import IntOrder.

(* only [tau] is used in this file. *)
clone import DParams as Params.

clone import Byte as B.

(* This script instantiates twice the [RejectionRO] argument in order to
   justify the reduction from the concrete game, where the adversary has
   access to a XOF and a leaky sampling algorithm on top of it (which
   corresponds to the [SampleInBall] algorithm in the specification of MLDSA),
   to a game where the adversary has only access to a challenge-generating RO,
   with independent leakage. *)

(* For the sake of this proof, SampleInBall is factored in two distinct phases:
   first the signs and permutation indices are sampled, then they are combined
   to form the final challenge. *)

(** base types *)

type in_t.
type challenge.

(* Challenges are encoded as lists of integer coefficients *)
type challenge_ = int list.

(* Leakage is encoded as a list of specific XOF-context integer values *)
type leak_ir = int list.

(* Intermediate representation of challenges *)
(* A list of 8 bytes used to compute signs, as well as a list of [tau] byte-encoded
   valid indices. *)
type challenge_ir = byte list * byte list.

(* Transforms leakage into a "concrete" leakage value.
   This is done with a declassify operation. *)
op to_leakage (l : leak_ir) = Decl (List (map Int l)).

(* how to generate a concrete challenge from this encoding. *)
(* This allows other files to have a different (but equivalent)
   representation for challenges, using DVect for instance. *)
op to_concrete : challenge_ -> challenge.

(* The encodings produced by [to_challenge]: 256 coefficients in {-1, 0, 1}. *)
op valid_challenge (c : challenge_) =
  size c = 256 /\ all (fun x => x = -1 \/ x = 0 \/ x = 1) c.

(* This concretisation function must be injective on valid encodings. This
   allows to lift the fact that the output distribution is uniform. *)
axiom to_concrete_inj (c c' : challenge_) :
  valid_challenge c => valid_challenge c' => to_concrete c = to_concrete c' => c = c'.

(* lossless variant of dcond; result is unspecified whenever
   the predicate isn't inhabited. *)
op dcond' (d : 'a distr) p =
  if (exists x, p x /\ x \in d) then dcond d p else dunit witness.

op dcond_prod (p: 'a -> bool) d = dcond' d (predC p) `*` dcond' d p.

op dB_le i = dcond dB (fun b => to_int b <= i).
op small_enough i b = !(i < to_int b).
op dB_thres i = mu dB (small_enough i).
op dbias i = DBool.Biased.dbiased (dB_thres i).

lemma dB_le_ll i :
  0 <= i => is_lossless (dB_le i).
proof.
move => ?; apply/dcond_ll/witness_support.
exists (from_int 0) => /=.
by rewrite tK' 1:// dB_full.
qed.

lemma dB_to_int_drange :
  dmap dB to_int = drange 0 256.
proof.
rewrite /dB dmap_comp (eq_dmap_in _ _ idfun) 2:dmap_id //.
by move => ? /supp_drange; apply tK'.
qed.

lemma dB_le_range i :
  0 <= i < 256 =>
    dmap (dB_le i) to_int = drange 0 (i + 1).
proof.
rewrite /dB_le => [#] 2?.
have -> : (fun b => to_int b <= i) = (fun b => b <= i) \o to_int.
- by apply fun_ext.
rewrite -dcond_dmap dB_to_int_drange.
apply distr_eq_supp.
- by apply/dcond_uni/drange_uni.
- exact drange_uni.
- apply dcond_ll. apply witness_support.
  exists 0. by rewrite supp_drange.
- by apply drange_ll => /#.
by move => ?; rewrite dcond_supp 2!supp_drange /#.
qed.

lemma dcond'_ll (d : 'a distr) p : is_lossless (dcond' d p).
proof.
rewrite /dcond'.
case (exists x, p x /\ x \in d) => [/witness_support|_].
- exact dcond_ll.
exact dunit_ll.
qed.

abbrev dtaurange (f : int -> 'a distr) = djoinmap f (range (256 - tau) 256).

(* Uniform indices used to construct a challenge, as sampled in SampleInBall *)
op dI : challenge_ir distr =
  dlist dB 8 `*` dtaurange dB_le.

(* FIXME: move this somewhere else *)
op foldl_map ['a, 'b, 'c] (f : 'b -> 'a -> 'b * 'c) (b:'b) (l : 'a list) =
  foldl (fun (bl : _ * _) a =>
           let bc = f bl.`1 a in
           (bc.`1, rcons bl.`2 bc.`2)) (b,[]) l.

op geom_i (i:int) = geometric ((i + 1)%r / 256%r).

(* Leakage distribution that follows the rejection sampling pattern *)
op dL : leak_ir distr =
  dmap (dtaurange geom_i)
    (fun l => (foldl_map (fun i k => (i + k, i + k)) 8 l).`2).

(** Functional representation of challenge generation from a given
   intermediate representation. **)

section TO_BOOL.
import BitEncoding.BS2Int.

op to_bool_list = flatten \o map (int2bs 8 \o to_int).
op to_bool bl i = nth witness (to_bool_list bl) i.

(*
lemma test n :
  0 <= n =>
  dmap (drange 0 (2 ^ n)) (int2bs n) = dlist {0,1} n.
proof.
elim/natind: n => [].
- move => n ??. have -> /= : n = 0 by smt.
  rewrite /dlist /=.
rewrite /fold/iter/int2bs iteri0 1:// expr0.
have -> : drange 0 1 = dunit 0.
admit.
by rewrite dmap_dunit /= mkseq0.
move => n n_ge_0 Hi ?.
have ? := Hi n_ge_0.
rewrite dlistS 1:n_ge_0 /=.
admitted.

lemma len_to_bool bl :
  size (to_bool_list bl) = 8 * size bl.
proof.
rewrite /to_bool_list size_flatten -map_comp /sumz.
have -> : size \o int2bs 8 \o to_int = fun _ => 8.
- by apply fun_ext => ?; apply size_mkseq.
by elim: bl => //= ? ->; ring.
