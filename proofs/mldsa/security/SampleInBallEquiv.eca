(* uniformly-sampled byte lists can also be seen as
   uniformly-sampled bit lists of size multiplied by 8 *)
(* TODO: this is probably needed later *)
lemma to_bool_dB_uni n :
  0 <= n =>
  dmap (dlist dB n) to_bool_list = dlist {0,1} (8 * n).
proof.
move => n_ge0.
rewrite -dlist_dlist 1,2://.
