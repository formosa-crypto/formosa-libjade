require import AllCore Distr List Leakage.

require DigitalSignaturesLeakageRO (* PROM ReprogOnce Collision *).

(* TODO: This file (and the ones that depend on it) cannot reason abstractly
   on different leakage types, as they need to be concatenated and output for a given oracle call.
   Once typeclasses are incorporated in EC, it will be possible to only ask
   for the type requirement e.g. [To_leakage LkgC: LkgC → leakage] and keep [LkgC] generic by
   instead defining (with Haskell-like notations):
   rconsFS :: (To_leakage LkgC, LkgRO, LkgR) =>
     leakage -> (bool * (LkgC * LkgRO * LkgR)) -> leakage. *)
require import IDSabort.
clone import IDS as ID with
  type LkgC <= leakage,
  type LkgR <= leakage.

(* *********************************************************************** *)
(*                Fiat-Shamir with Abort Signatures                        *)
(* *********************************************************************** *)

type M. (* Messages *)
op [lossless] dC : C distr. (* Challenge Distribution *)

(* Bound on the number of iterations of the signing loop: after [kappa]
   failed attempts, signing gives up and returns [None]. *)
op kappa : { int | 0 < kappa } as gt0_kappa.
type LkgRO = leakage.
op [lossless]dLkgRO : LkgRO distr.

abstract theory Generic.

type Sig = W * Z. (* Signatures *)

const qS : int. (* allowed number of sig queries *)
const qH : int. (* allowed number of ro  queries *)
axiom qS_ge0 : 0 <= qS.
axiom qH_ge0 : 0 <= qH.


(* clone RO signature theory,
   setting oracle distribution to uniform challenges *)
clone import DigitalSignaturesLeakageRO as DSS with
type DS.pk_t <- PK,
type DS.sk_t <- SK,
type DS.msg_t <- M,
type DS.sig_t <- Sig,
type DS.lkg_t <- leakage,
type PRO.in_t <= W * M,
type PRO.out_t <= C * leakage,
op   PRO.dout <= fun _ => dC `*` dLkgRO,
op   EFCMA.q_efcma <= qS
proof* by smt(qS_ge0).

import DSS.PRO.
import DSS.DS.Stateless.

(* *** Defining the signature scheme (generic FS+abort signature) *********** *)
module (IDS_Sig (P: Prover, V:Verifier) : SchemeRO) (H: Hash) = {
  proc keygen() : PK*SK = {
    var sk, pk;
    (pk, sk) <@ P.keygen();
    return (pk, sk);
  }

  proc sign(sk:SK, m:M) : Sig option * leakage = {
    var w, c, oz, i;
    var lw, lc, lz, leak;

    oz <- None;
    w <- witness;
    c <- witness;
    leak <- Empty;
    i <- 0;

    while (oz = None /\ i < kappa) {
      (w, lw) <@ P.commit(sk);
      (c, lc) <@ H.get(w, m);
      (oz, lz) <@ P.respond(sk, c);
      leak <- catFS leak (oz = None, (lw, lc, lz));
      i <- i + 1;
    }
    return (omap (fun z => (w, z)) oz, leak);
  }

  proc verify(pk:PK, m:M, s:Sig):bool = {
    var w, c, z, _lc;
    var result <- false;

    (w, z) <- s;
    (c, _lc) <@ H.get(w, m);
    result <@ V.verify(pk, w, c, z);
    return result;
  }
}.

end Generic.


(* *********************************************************************** *)
(*    Fiat-Shamir with Abort Signatures (commitment recoverable)           *)
(* *********************************************************************** *)

(* Variant for commitment recoverable ID schemes *)
abstract theory CommRecov.

op recover : PK -> C -> Z -> W.

type Sig = C * Z. (* Signatures *)

const qS : int. (* allowed number of sig queries *)
const qH : int. (* allowed number of ro  queries *)
axiom qS_ge0 : 0 <= qS.
axiom qH_ge0 : 0 <= qH.

(* clone RO signature theory,
   setting oracle distribution to uniform challenges *)
clone import DigitalSignaturesLeakageRO as DSS with
type DS.pk_t <- PK,
type DS.sk_t <- SK,
type DS.msg_t <- M,
type DS.sig_t <- Sig,
type DS.lkg_t <- leakage,
type PRO.in_t <= W * M,
type PRO.out_t <= C * ID.LkgC,
op   PRO.dout <= fun _ => dC `*` dLkgRO,
op   EFCMA.q_efcma <= qS
proof* by smt(qS_ge0).

import DSS.PRO.
import DSS.DS.Stateless.

(* *** Defining the signature scheme (commitment recoverable) *********** *)

module (IDS_Sig (P: Prover, V:Verifier) : SchemeRO) (H: Hash) = {
  proc keygen() : PK*SK = {
    var kp;
    kp <@ P.keygen();
    return kp;
  }
  proc sign(sk:SK, m:M) : Sig option * leakage = {
    var w, c, oz, i;
    var lw, lc, lz, leak;

    oz <- None;
    w <- witness;
    c <- witness;
    i <- 0;

    leak <- Empty;
    while (oz = None /\ i < kappa) {
      (w, lw) <@ P.commit(sk);
      (c, lc) <@ H.get(w, m);
      (oz, lz) <@ P.respond(sk, c);
      leak <- catFS leak (oz = None, (lw, lc, lz));
      i <- i + 1;
    }
    return (omap (fun z => (c, z)) oz, leak);
  }

  proc verify(pk:PK, m:M, s:Sig):bool = {
    var c, c', w, z, _lc;
    var result <- false;

    (c, z) <- s;
    w <- recover pk c z;
    (c', _lc) <@ H.get(w, m);
    if (c = c')
      result <@ V.verify(pk, w, c, z);
    return result;
  }
}.


end CommRecov.

(* Operator-Based instance of ID scheme that is used in the proofs *)

abstract theory OpBased.

op [lossless] keygen : (PK * SK) distr.
op [lossless] commit : SK -> ((W * Pstate) * ID.LkgC) distr.
op respond : SK -> C -> Pstate -> Z option * ID.LkgR.
op verify : PK -> W -> C -> Z -> bool.

module V : Verifier = {
  proc challenge(w : W, pk : PK) : C = {
    var c;
    c <$ dC;
    return c;
  }

  proc verify(pk:PK, w:W, c:C, z:Z): bool = {
    return verify pk w c z;
  }
}.

module P : Prover = {
  var pstate : Pstate

  proc keygen(): PK*SK = {
    var ks;
    ks <$ keygen;
    return ks;
  }

  proc commit(sk:SK) : W * ID.LkgC = {
    var s, lw, w;
    (s, lw) <$ commit sk;
    (w, pstate) <- s;
    return (w, lw);
  }

  proc respond(sk:SK, c:C) : Z option * ID.LkgR = {
    return respond sk c pstate;
  }
}.

end OpBased.
