(* The circuit specifications of the 32-bit-lane instructions bound in
   mlkem_bindings.ec, on inputs of distinct words; the expected values follow
   Intel's definitions (unpacklo/hi_epi32: a0 b0 a1 b1 / a2 b2 a3 b3 per
   128-bit lane) *)
require import AllCore.
from Jasmin require import JModel.
require import Mlkem_bindings CircuitBindings.

lemma test_unpackl :
  VPUNPCKL_8u32 (W256.of_int 0x1111000711110006111100051111000411110003111100021111000111110000)
       (W256.of_int 0x2222000722220006222200052222000422220003222200022222000122220000)
  = W256.of_int 0x2222000511110005222200041111000422220001111100012222000011110000.
proof. by circuit. qed.

lemma test_unpackh :
  VPUNPCKH_8u32 (W256.of_int 0x1111000711110006111100051111000411110003111100021111000111110000)
       (W256.of_int 0x2222000722220006222200052222000422220003222200022222000122220000)
  = W256.of_int 0x2222000711110007222200061111000622220003111100032222000211110002.
proof. by circuit. qed.

lemma test_sub :
  VPSUB_8u32 (W256.of_int 0x1111000711110006111100051111000411110003111100021111000111110000)
       (W256.of_int 0x2222000722220006222200052222000422220003222200022222000122220000)
  = W256.of_int 0xeeef0000eeef0000eeef0000eeef0000eeef0000eeef0000eeef0000eeef0000.
proof. by circuit. qed.
