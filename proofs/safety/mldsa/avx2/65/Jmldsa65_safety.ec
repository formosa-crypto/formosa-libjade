    trace_error_4x____write_out_8_coefficients <-
    (trace_error_4x____write_out_8_coefficients ++
    [(Assert,
     ((0 <= (W64.to_uint bytes_filled)) /\
     (((W64.to_uint bytes_filled) + 32) <= 1024)))]);
