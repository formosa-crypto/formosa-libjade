[test-core]
okdirs = !core

[test-mldsa]
okdirs = !mldsa/spec !mldsa/security !mldsa/eclib !mldsa/avx2/sct/correctness

[test-mlkem]
okdirs = !mlkem/spec !mlkem/security !mlkem/eclib

[test-mlkem-avx2-generic]
okdirs = !mlkem/avx2/sct/correctness/common

[test-mlkem-avx2-512]
okdirs = !mlkem/avx2/sct/correctness/512

[test-mlkem-avx2-768]
okdirs = !mlkem/avx2/sct/correctness/768

[test-mlkem-avx2-1024]
okdirs = !mlkem/avx2/sct/correctness/1024

[test-fips202]
okdirs = !fips202

[test-mlkem-safety]
okdirs = !mlkem/avx2/sct/safety/512 !mlkem/avx2/sct/safety/768 !mlkem/avx2/sct/safety/1024

[test-mldsa-safety]
okdirs = !mldsa/avx2/sct/safety/common !mldsa/avx2/sct/safety/44 !mldsa/avx2/sct/safety/65 !mldsa/avx2/sct/safety/87

[test-fips202-safety]
okdirs = !safety/fips202
