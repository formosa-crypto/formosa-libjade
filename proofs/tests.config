[test-core]
okdirs = !core

[test-mldsa]
okdirs = !mldsa

[test-mlkem]
okdirs = !mlkem

[test-mlkem-avx2-generic]
okdirs = !mlkem-correctness/generic

[test-mlkem-avx2-512]
okdirs = !mlkem-correctness/avx2/512

[test-mlkem-avx2-768]
okdirs = !mlkem-correctness/avx2/768

[test-mlkem-avx2-1024]
okdirs = !mlkem-correctness/avx2/1024

[test-fips202]
okdirs = !fips202
exclude = !fips202/safety

[test-mlkem-safety]
okdirs = !safety/mlkem/avx2

[test-mldsa-safety]
okdirs = !safety/mldsa/avx2

# Needs the eclib of Jasmin's safety-assert2 branch: run it through
# `make fips202-safety` (see the Makefile), which sets EC_IDIRS.
[test-fips202-safety]
okdirs = !fips202/safety
